//   config.h.example
//   Copy to config.h and fill in local credentials, API keys, and site-specific
//   defaults. config.h is intentionally ignored so secrets stay local.
#pragma once

// Board selection and every board-dependent pin live in BoardVariant.h and
// BoardPins.h. They are separate from this ignored secrets file so TFT_eSPI and
// native .cpp modules compile against the same hardware map.
#include "BoardPins.h"

//   Rear WS2812 RGB LED (used by indicators and the .dapp LED opcode). Leave
//   unset to use Freenove's documented default: GPIO42 on AB/S, GPIO40 on N.
//   Set to -1 to disable LED control in this build.
// #define REAR_RGB_LED_PIN 42

//battery voltage divider on this board is 2:1 (see Freenove's Battery_Voltage example)
const float BATTERY_ADC_DIVIDER = 2.0f;
//rough LiPo curve endpoints for a percent estimate -- not a fuel-gauge chip, just linear interpolation
const float BATTERY_VOLTAGE_EMPTY = 3.3f;
const float BATTERY_VOLTAGE_FULL  = 4.2f;

//   Wi-Fi
//   STA credentials: the home/router network joined for internet access. These
//   can also be set later at runtime with "wifi connect <ssid> <password>" +
//   "wifi save" -- these are only the first-boot defaults.
const char* STA_DEFAULT_SSID = "YOUR_WIFI_SSID";
const char* STA_DEFAULT_PASSWORD = "YOUR_WIFI_PASSWORD";

//   Telnet
const uint16_t TELNET_PORT = 23;

//   FTP (FtpServer.ino) -- exposes the SD card over the network.
//   Plaintext, LAN-only -- same posture as telnet above.
const char* FTP_USER = "doll-os";
const char* FTP_PASS = "CHANGE_ME";

//   Motoko MQTT defaults
const char* MOTOKO_DEFAULT_BROKER = "192.168.44.4";
const int MOTOKO_DEFAULT_PORT = 1883;
const char* MOTOKO_CLIENT_ID = "MOTOKO-DOLL-OS";

//   Radio defaults (Radio.ino)
const char* RADIO_DEFAULT_URL = "https://sadgirlsclub.wtf/rr/sgc";
const char* RADIO_DIRECTORY_URL = "https://sadgirlsclub.wtf/rr/healthz";
const int RADIO_DEFAULT_VOLUME = 12;

//   ASUKA local LLM chat command. This talks to Mochi over Tailscale by default,
//   using DOLL-OS's existing shell/telnet surfaces; no ASUKA webserver or MQTT listener
//   is started here.
const char* ASUKA_DEFAULT_LLM_HOST = "100.66.64.45";
const uint16_t ASUKA_DEFAULT_LLM_PORT = 9090;
const char* ASUKA_DEFAULT_LLM_PATH = "/v1/chat/completions";
const char* ASUKA_BRAVE_SEARCH_URL = "https://api.search.brave.com/res/v1/web/search";
const char* ASUKA_BRAVE_API_KEY = "";
const char* ASUKA_OPENWEATHER_WEATHER_URL = "https://api.openweathermap.org/data/2.5/weather";
const char* ASUKA_OPENWEATHER_API_KEY = "";
const char* ASUKA_OPENWEATHER_LOCATION_LABEL = "Kennewick, Washington, US";
const double ASUKA_OPENWEATHER_LAT = 46.2112;
const double ASUKA_OPENWEATHER_LON = -119.1372;
const char* ASUKA_DEVICE_TIME_ZONE = "PST8PDT,M3.2.0,M11.1.0";
const char* ASUKA_NTP_SERVER_PRIMARY = "pool.ntp.org";
const char* ASUKA_NTP_SERVER_SECONDARY = "time.nist.gov";
const char* ASUKA_SYSTEM_PROMPT =
    "You are ASUKA, a concise local assistant running through DOLL-OS.";
const char* ASUKA_CLASSIFIER_PROMPT =
    "You are ASUKA's tool-selection pass running on DOLL-OS. If the user's request needs live information, weather, a page, URL inspection, or the current date/time, respond with only one JSON object and no markdown. For current web search, use exactly {\"tool\":\"brave_search\",\"arguments\":{\"query\":\"...\",\"count\":5}}. For current weather at the configured location, use exactly {\"tool\":\"openweather_current\",\"arguments\":{\"units\":\"metric\"}} or {\"tool\":\"openweather_current\",\"arguments\":{\"units\":\"imperial\"}}. For reading a specific URL, use exactly {\"tool\":\"fetch_url\",\"arguments\":{\"url\":\"https://...\",\"max_chars\":4000}}. For current local date/time, use exactly {\"tool\":\"current_datetime\",\"arguments\":{}}. If no live tool is needed, answer normally.";
