# @dapp-format 1
# @id life
# @name Life
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.4.1 <2.0.0
# @summary Conway's Game of Life with a cursor editor and pattern library
# /apps/life.dapp
# Conway's Game of Life for the DOLL-OS canvas. Arrows move the cursor,
# space toggles a cell, enter starts and pauses the simulation, +/- change
# speed, c clears, r fills at random, 1-5 stamp patterns (glider, blinker,
# toad, beacon, glider gun) at the cursor -- the gun is large enough that
# it is stamped at a fixed corner instead. g saves the field, l loads it.
# Escape quits.
#
# The field is two 38x20 grids, `cur` and `nxt`. A generation uses the
# runtime-native LIFE opcode, which computes `nxt` from `cur` and copies it
# back. The board does not wrap: an edge cell has fewer neighbours, which is
# the standard convention and keeps a glider from reappearing on the far side
# mid-flight.
#
# Patterns are "dx,dy dx,dy ..." text parsed with a small signed-integer
# reader, applied relative to the cursor for the four small patterns and
# at a fixed corner for the 36-cell glider gun, which is far too wide to
# stamp wherever the cursor happens to be without checking it fits.

CANVAS 80 36
DIM cur 760
DIM nxt 760

SET curx 19
SET cury 10
SET running 0
SET gen 0
SET stepms 60
SET quit 0
SETSTR msg "space toggles - enter runs"
# set once here rather than inline where it is used: the main loop never
# falls through top to bottom after this point, it only jumps, so a
# literal sitting lower in the file would never actually execute
SETSTR gunshape "24,0 22,1 24,1 12,2 13,2 20,2 21,2 34,2 35,2 11,3 15,3 20,3 21,3 34,3 35,3 0,4 1,4 10,4 16,4 20,4 21,4 0,5 1,5 10,5 14,5 16,5 17,5 22,5 24,5 10,6 16,6 24,6 11,7 15,7 12,8 13,8"

GOSUB draw

:loop
KEY k
IF $k <> 0 GOSUB handlekey
IF $quit = 1 GOTO leave
IF $running = 0 GOTO lp_wait
EXPR remain $moveat - $millis
IF $remain > 0 GOTO lp_wait
GOSUB step
EXPR moveat $millis + $stepms
GOSUB draw
:lp_wait
WAIT 16
GOTO loop

# ---------------------------------------------------------------- input

:handlekey
SETSTR msg ""
IF $k = $kesc GOTO hk_quit
IF $k = $kleft GOTO hk_left
IF $k = 97 GOTO hk_left
IF $k = $kright GOTO hk_right
IF $k = 100 GOTO hk_right
IF $k = $kup GOTO hk_up
IF $k = 119 GOTO hk_up
IF $k = $kdown GOTO hk_down
IF $k = 115 GOTO hk_down
IF $k = $kspace GOTO hk_toggle
IF $k = $kenter GOTO hk_run
IF $k = 43 GOTO hk_faster
IF $k = 61 GOTO hk_faster
IF $k = 45 GOTO hk_slower
IF $k = 99 GOTO hk_clear
IF $k = 67 GOTO hk_clear
IF $k = 114 GOTO hk_random
IF $k = 82 GOTO hk_random
IF $k = 103 GOTO hk_save
IF $k = 71 GOTO hk_save
IF $k = 108 GOTO hk_load
IF $k = 76 GOTO hk_load
IF $k >= 49 GOTO hk_stamp
RETURN

:hk_quit
SET quit 1
RETURN

:hk_left
IF $curx <= 0 GOTO hk_draw
SUB curx 1
GOTO hk_draw
:hk_right
IF $curx >= 37 GOTO hk_draw
ADD curx 1
GOTO hk_draw
:hk_up
IF $cury <= 0 GOTO hk_draw
SUB cury 1
GOTO hk_draw
:hk_down
IF $cury >= 19 GOTO hk_draw
ADD cury 1
GOTO hk_draw

:hk_toggle
IF $running = 1 GOTO hk_draw
EXPR ci $cury * 38 + $curx
SET v $cur[$ci]
IF $v = 1 GOTO hk_off
SET cur[$ci] 1
GOTO hk_draw
:hk_off
SET cur[$ci] 0
GOTO hk_draw

:hk_run
IF $running = 1 GOTO hk_pause
SET running 1
EXPR moveat $millis + $stepms
SETSTR msg "running"
GOTO hk_draw
:hk_pause
SET running 0
SETSTR msg "paused"
GOTO hk_draw

:hk_faster
SUB stepms 20
IF $stepms >= 20 GOTO hk_draw
SET stepms 20
GOTO hk_draw
:hk_slower
ADD stepms 20
IF $stepms <= 600 GOTO hk_draw
SET stepms 600
GOTO hk_draw

:hk_clear
GOSUB clearfield
SET gen 0
SET running 0
SETSTR msg "cleared"
GOTO hk_draw

:hk_random
GOSUB clearfield
SET ri 0
:hr_cell
RAND v 5
IF $v <> 0 GOTO hr_next
SET cur[$ri] 1
:hr_next
ADD ri 1
IF $ri < 760 GOTO hr_cell
SET gen 0
SETSTR msg "randomised"
GOTO hk_draw

:hk_save
GOSUB savefield
GOTO hk_draw

:hk_load
GOSUB loadfield
GOTO hk_draw

# 1-4 stamp near the cursor; 5 is the glider gun, stamped at a fixed
# corner because it is 36 cells wide and would usually not fit otherwise
:hk_stamp
IF $k > 53 GOTO hk_draw
SET ox $curx
SET oy $cury
IF $k = 49 GOTO hk_glider
IF $k = 50 GOTO hk_blinker
IF $k = 51 GOTO hk_toad
IF $k = 52 GOTO hk_beacon
SETSTR ptext $gunshape
SET ox 1
SET oy 1
GOTO hk_apply
:hk_glider
SETSTR ptext "1,0 2,1 0,2 1,2 2,2"
GOTO hk_apply
:hk_blinker
SETSTR ptext "-1,0 0,0 1,0"
GOTO hk_apply
:hk_toad
SETSTR ptext "1,0 2,0 3,0 0,1 1,1 2,1"
GOTO hk_apply
:hk_beacon
SETSTR ptext "0,0 1,0 0,1 1,1 2,2 3,2 2,3 3,3"
:hk_apply
GOSUB stampwith
SETSTR msg "stamped"
:hk_draw
GOSUB draw
RETURN

# ---------------------------------------------------------------- patterns

# in: ptext ("dx,dy dx,dy ..."), ox, oy -- lights every cell inside bounds
:stampwith
LEN plen $ptext
SET pi 0
:sw_loop
IF $pi >= $plen GOTO sw_done
GOSUB readsigned
SET dx $sval
CHARAT pc $ptext $pi
IF $pc <> 44 GOTO sw_done
ADD pi 1
GOSUB readsigned
SET dy $sval
EXPR px $ox + $dx
EXPR py $oy + $dy
IF $px < 0 GOTO sw_skip
IF $px > 37 GOTO sw_skip
IF $py < 0 GOTO sw_skip
IF $py > 19 GOTO sw_skip
EXPR sci $py * 38 + $px
SET cur[$sci] 1
:sw_skip
IF $pi >= $plen GOTO sw_loop
CHARAT pc $ptext $pi
IF $pc <> 32 GOTO sw_loop
ADD pi 1
GOTO sw_loop
:sw_done
RETURN

# in: ptext, pi -- out: sval, pi advanced past one optional sign and its
# digits, stopping at the following ',' or ' ' or end of string
:readsigned
SET sign 1
CHARAT pc $ptext $pi
IF $pc <> 45 GOTO rs_digits
SET sign -1
ADD pi 1
:rs_digits
SET sval 0
:rs_loop
IF $pi >= $plen GOTO rs_end
CHARAT pc $ptext $pi
IF $pc < 48 GOTO rs_end
IF $pc > 57 GOTO rs_end
SUB pc 48
MUL sval 10
ADD sval $pc
ADD pi 1
GOTO rs_loop
:rs_end
MUL sval $sign
RETURN

# ---------------------------------------------------------------- simulation

:clearfield
SET ci 0
:cf_cell
SET cur[$ci] 0
SET nxt[$ci] 0
ADD ci 1
IF $ci < 760 GOTO cf_cell
RETURN

:step
LIFE cur nxt 38 20
ADD gen 1
RETURN

# ---------------------------------------------------------------- drawing

:draw
CLS
COLOR blue
PUT 0 0 "+--------------------------------------+"
PUT 0 21 "+--------------------------------------+"
SET dy 1
:dr_side
PUT 0 $dy "|"
PUT 39 $dy "|"
ADD dy 1
IF $dy < 21 GOTO dr_side

SET y 0
:dr_row
SET x 0
:dr_col
EXPR ci $y * 38 + $x
SET v $cur[$ci]
SET cur1 0
IF $x <> $curx GOTO dr_plain
IF $y <> $cury GOTO dr_plain
SET cur1 1
:dr_plain
EXPR px $x + 1
EXPR py $y + 1
IF $cur1 = 1 GOTO dr_cursor
IF $v = 0 GOTO dr_col_next
COLOR green
PUT $px $py "#"
GOTO dr_col_next
:dr_cursor
IF $v = 1 GOTO dr_cursor_on
COLOR yellow
PUT $px $py "+"
GOTO dr_col_next
:dr_cursor_on
COLOR yellow
PUT $px $py "@"
:dr_col_next
ADD x 1
IF $x < 38 GOTO dr_col
ADD y 1
IF $y < 20 GOTO dr_row

COLOR pink
PUT 46 3 "CONWAY'S LIFE"
COLOR cyan
PUT 46 7 "generation"
COLOR white
PUT 60 7 $gen
COLOR cyan
PUT 46 10 "speed (ms)"
COLOR white
PUT 60 10 $stepms
COLOR green
PUT 46 13 $msg
COLOR yellow
PUT 46 18 "SPACE       toggle cell"
PUT 46 20 "ENTER       run/pause"
PUT 46 22 "+/-         speed"
PUT 46 24 "C / R       clear/random"
PUT 46 26 "1-5         stamp"
PUT 46 28 "G / L       save/load"
PUT 46 30 "ESC         quit"
FLIP
RETURN

# ---------------------------------------------------------------- the file

# a sparse list of live cell indices, one per line -- shorter than a
# bitmap for anything but a nearly-full board, and trivial to reload
:savefield
FOPEN "/apps/life.dat" write
IF $fok = 0 GOTO sv_failed
SET ci 0
:sv_cell
IF $cur[$ci] = 0 GOTO sv_next
FWRITE $ci
:sv_next
ADD ci 1
IF $ci < 760 GOTO sv_cell
FCLOSE
SETSTR msg "saved /apps/life.dat"
RETURN
:sv_failed
SETSTR msg "could not write /apps/life.dat"
RETURN

:loadfield
FEXISTS have "/apps/life.dat"
IF $have = 0 GOTO ld_missing
FOPEN "/apps/life.dat" read
IF $fok = 0 GOTO ld_missing
GOSUB clearfield
SET gen 0
:ld_line
FREAD line
IF $feof = 1 GOTO ld_close
GOSUB str2num
IF $num < 0 GOTO ld_line
IF $num >= 760 GOTO ld_line
SET cur[$num] 1
GOTO ld_line
:ld_close
FCLOSE
SETSTR msg "loaded /apps/life.dat"
RETURN
:ld_missing
SETSTR msg "no /apps/life.dat to load"
RETURN

# in: line (string)   out: num -- an index read back from a file is text
:str2num
SET num 0
SET s2i 0
LEN s2len $line
:s2n_loop
IF $s2i >= $s2len GOTO s2n_done
CHARAT s2d $line $s2i
IF $s2d < 48 GOTO s2n_done
IF $s2d > 57 GOTO s2n_done
SUB s2d 48
MUL num 10
ADD num $s2d
ADD s2i 1
GOTO s2n_loop
:s2n_done
RETURN

:leave
ENDCANVAS
COLOR green
PRINT "life: generation $gen"
EXIT
