# @dapp-format 1
# @id 2048
# @name 2048
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.1.0 <2.0.0
# @summary Slide and merge tiles until one of them reads 2048
# /apps/2048.dapp
# 2048 for the DOLL-OS canvas. Arrows or WASD slide the board, R starts a
# new game, escape quits.
#
# All four directions run through one slide routine. A move is described as
# a walk rather than as a direction: `base` is where the first line starts,
# `linestep` moves to the next line, and `step` moves along a line. Sliding
# left walks 0,1,2,3 from cell 0; sliding up walks 0,4,8,12 from the same
# cell; sliding right walks backwards from cell 3. That is the whole of the
# direction handling -- the compact/merge/compact pass below never learns
# which way the player pressed.

CANVAS 80 36
COLOR yellow
PUT 13 5 "2 0 4 8"
COLOR white
PUT 8 7 "arrows or wasd to slide"
PUT 10 8 "r restarts - esc quits"
FLIP
WAIT 1200

# the board, one value per cell, row-major
DIM b 16
# the four cells of the line currently being slid
DIM ln 4

GOSUB loadhs

:newgame
SET score 0
SET restart 0
SET quit 0
SET over 0
SET won 0
SET newhi 0
SET i 0
:ng_clear
SET b[$i] 0
ADD i 1
IF $i < 16 GOTO ng_clear
GOSUB spawn
GOSUB spawn
GOSUB draw

# the keypress that asked for a new game must not survive into it
:ng_drain
KEY k
IF $k <> 0 GOTO ng_drain

# ---------------------------------------------------------------- main loop

# nothing moves on its own here, so the loop only has to stay responsive:
# poll, act on a key, and go back to sleep for a frame
:loop
KEY k
IF $k = 0 GOTO lp_wait
GOSUB handlekey
IF $quit = 1 GOTO leave
IF $restart = 1 GOSUB savehs
IF $restart = 1 GOTO newgame
IF $moved = 0 GOTO lp_wait
GOSUB spawn
GOSUB draw
IF $won = 1 GOSUB winbanner
GOSUB checkover
IF $over = 1 GOTO gameover
:lp_wait
WAIT 16
GOTO loop

# ---------------------------------------------------------------- input

:handlekey
SET moved 0
SET restart 0
IF $k = $kesc GOTO hk_quit
IF $k = 114 GOTO hk_restart
IF $k = 82 GOTO hk_restart
IF $k = $kleft GOTO hk_left
IF $k = 97 GOTO hk_left
IF $k = $kright GOTO hk_right
IF $k = 100 GOTO hk_right
IF $k = $kup GOTO hk_up
IF $k = 119 GOTO hk_up
IF $k = $kdown GOTO hk_down
IF $k = 115 GOTO hk_down
RETURN

:hk_quit
SET quit 1
RETURN

:hk_restart
SET restart 1
RETURN

:hk_left
SET base 0
SET linestep 4
SET step 1
GOSUB move
RETURN

:hk_right
SET base 3
SET linestep 4
SET step -1
GOSUB move
RETURN

:hk_up
SET base 0
SET linestep 1
SET step 4
GOSUB move
RETURN

:hk_down
SET base 12
SET linestep 1
SET step -4
GOSUB move
RETURN

# ---------------------------------------------------------------- sliding

:move
SET li 0
:mv_line
EXPR st $base + $li * $linestep
GOSUB slide
ADD li 1
IF $li < 4 GOTO mv_line
RETURN

# one line of four cells, read out along `step`, compacted, merged once per
# pair, compacted again, and written back. `moved` is set by the write-back
# comparing what it is about to store against what was already there, which
# is the only reliable test: a merge can leave a line looking unchanged in
# length while its values differ.
:slide
SET p 0
:sl_read
EXPR idx $st + $p * $step
SET ln[$p] $b[$idx]
ADD p 1
IF $p < 4 GOTO sl_read

GOSUB compact

SET p 0
:sl_merge
EXPR p1 $p + 1
IF $ln[$p] = 0 GOTO sl_merged
IF $ln[$p] <> $ln[$p1] GOTO sl_merge_next
MUL ln[$p] 2
ADD score $ln[$p]
SET ln[$p1] 0
IF $ln[$p] = 2048 GOSUB winner
ADD p 2
GOTO sl_merge_test
:sl_merge_next
ADD p 1
:sl_merge_test
IF $p < 3 GOTO sl_merge
:sl_merged

GOSUB compact

SET p 0
:sl_write
EXPR idx $st + $p * $step
IF $b[$idx] <> $ln[$p] GOSUB setmoved
SET b[$idx] $ln[$p]
ADD p 1
IF $p < 4 GOTO sl_write
RETURN

# pushes the non-zero cells of ln to the front, keeping their order
:compact
SET w 0
SET p 0
:cp_scan
IF $ln[$p] = 0 GOTO cp_next
SET tmp $ln[$p]
SET ln[$p] 0
SET ln[$w] $tmp
ADD w 1
:cp_next
ADD p 1
IF $p < 4 GOTO cp_scan
RETURN

:setmoved
SET moved 1
RETURN

# won counts up rather than latching: 1 means "reached 2048 this move", 2
# means the banner for it has already been shown and play continues
:winner
IF $won <> 0 GOTO wn_done
SET won 1
:wn_done
RETURN

:winbanner
SET won 2
COLOR pink
PUT 2 3 "+------------------------+"
PUT 2 4 "|      2048 REACHED      |"
PUT 2 5 "|  keep going for more   |"
PUT 2 6 "+------------------------+"
FLIP
WAIT 1500
GOSUB draw
RETURN

# ---------------------------------------------------------------- new tiles

# counts the empty cells, picks the nth of them, and drops a 2 there nine
# times out of ten. Counting first means the pick is uniform and cannot
# spin on a full board the way rejection sampling would.
:spawn
SET ecount 0
SET i 0
:sp_count
IF $b[$i] <> 0 GOTO sp_count_next
ADD ecount 1
:sp_count_next
ADD i 1
IF $i < 16 GOTO sp_count
IF $ecount = 0 GOTO sp_done

RAND pick $ecount
SET i 0
SET seen 0
:sp_find
IF $b[$i] <> 0 GOTO sp_find_next
IF $seen = $pick GOTO sp_place
ADD seen 1
:sp_find_next
ADD i 1
IF $i < 16 GOTO sp_find
GOTO sp_done

:sp_place
RAND four 1 10
SET nv 2
IF $four < 10 GOTO sp_set
SET nv 4
:sp_set
SET b[$i] $nv
:sp_done
RETURN

# no empty cell and no equal neighbour in either axis means no legal move
:checkover
SET over 0
SET i 0
:co_scan
IF $b[$i] = 0 GOTO co_no
ADD i 1
IF $i < 16 GOTO co_scan

SET r 0
:co_row
SET c 0
:co_col
EXPR i $r * 4 + $c
EXPR j $i + 1
IF $b[$i] = $b[$j] GOTO co_no
ADD c 1
IF $c < 3 GOTO co_col
ADD r 1
IF $r < 4 GOTO co_row

SET c 0
:co_vcol
SET r 0
:co_vrow
EXPR i $r * 4 + $c
EXPR j $i + 4
IF $b[$i] = $b[$j] GOTO co_no
ADD r 1
IF $r < 3 GOTO co_vrow
ADD c 1
IF $c < 4 GOTO co_vcol

SET over 1
:co_no
RETURN

# ---------------------------------------------------------------- drawing

:draw
CLS
COLOR blue
SET r 0
:dr_grid
EXPR gy $r * 2 + 1
PUT 0 $gy "+------+------+------+------+"
EXPR gy $r * 2 + 2
PUT 0 $gy "|      |      |      |      |"
ADD r 1
IF $r < 4 GOTO dr_grid
PUT 0 9 "+------+------+------+------+"

SET r 0
:dr_row
SET c 0
:dr_col
EXPR i $r * 4 + $c
SET v $b[$i]
IF $v = 0 GOTO dr_col_next
SETSTR tv $v
LEN tl $tv
GOSUB tilecolor
EXPR tx $c * 7 + 1 + floor((6 - $tl) / 2)
EXPR ty $r * 2 + 2
PUT $tx $ty $tv
:dr_col_next
ADD c 1
IF $c < 4 GOTO dr_col
ADD r 1
IF $r < 4 GOTO dr_row

COLOR yellow
PUT 48 2 "2 0 4 8"
COLOR cyan
PUT 48 6 "SCORE"
COLOR white
PUT 48 7 $score
COLOR cyan
PUT 48 10 "BEST"
COLOR white
PUT 48 11 $hiscore
COLOR yellow
PUT 48 17 "WASD / arrows  move"
PUT 48 20 "R               new game"
PUT 48 23 "ESC             quit"
PUT 48 29 "Join matching tiles"
PUT 48 31 "and chase 2048!"
FLIP
RETURN

# bigger tiles get hotter colours, so the board can be read at a glance
# without stopping to compare numbers
:tilecolor
COLOR white
IF $v <= 4 GOTO tc_done
COLOR cyan
IF $v <= 8 GOTO tc_done
COLOR green
IF $v <= 16 GOTO tc_done
COLOR yellow
IF $v <= 64 GOTO tc_done
COLOR magenta
IF $v <= 256 GOTO tc_done
COLOR pink
IF $v <= 1024 GOTO tc_done
COLOR red
:tc_done
RETURN

# ---------------------------------------------------------------- high score

:loadhs
SET hiscore 0
FEXISTS hs "/apps/2048.hs"
IF $hs = 0 GOTO lh_done
FOPEN "/apps/2048.hs" read
IF $fok = 0 GOTO lh_done
FREAD text
FCLOSE
GOSUB str2num
SET hiscore $num
:lh_done
RETURN

:savehs
SET newhi 0
IF $score <= $hiscore GOTO sh_done
SET hiscore $score
SET newhi 1
FOPEN "/apps/2048.hs" write
IF $fok = 0 GOTO sh_done
FWRITE $score
FCLOSE
:sh_done
RETURN

# in: text (string)   out: num -- a score read back from a file is text again
:str2num
SET num 0
SET s2i 0
LEN s2len $text
:s2n_loop
IF $s2i >= $s2len GOTO s2n_done
CHARAT s2d $text $s2i
IF $s2d < 48 GOTO s2n_done
IF $s2d > 57 GOTO s2n_done
SUB s2d 48
MUL num 10
ADD num $s2d
ADD s2i 1
GOTO s2n_loop
:s2n_done
RETURN

# ---------------------------------------------------------------- exits

:gameover
GOSUB savehs
GOSUB draw
COLOR red
PUT 2 3 "+------------------------+"
PUT 2 4 "|                        |"
PUT 2 5 "|                        |"
PUT 2 6 "|                        |"
PUT 2 7 "|                        |"
PUT 2 8 "+------------------------+"
PUT 7 4 "NO MOVES LEFT"
COLOR white
PUT 7 5 "score $score"
IF $newhi = 0 GOTO go_keys
COLOR yellow
PUT 7 6 "NEW HIGH SCORE"
:go_keys
COLOR cyan
PUT 5 7 "r=again   esc=quit"
FLIP

WAIT 400
:go_drain
KEY k
IF $k <> 0 GOTO go_drain

:go_wait
KEY k
IF $k = 114 GOTO newgame
IF $k = 82 GOTO newgame
IF $k = $kenter GOTO newgame
IF $k = $kspace GOTO newgame
IF $k = $kesc GOTO leave
WAIT 20
GOTO go_wait

:leave
GOSUB savehs
ENDCANVAS
COLOR yellow
PRINT "2048: score $score (best $hiscore)"
IF $won >= 1 GOTO lv_won
EXIT
:lv_won
COLOR pink
PRINT "you reached 2048"
EXIT
