# @dapp-format 1
# @id paint
# @name Pixel Paint
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.1.0 <2.0.0
# @summary A wide Tab5 pixel-art studio with permanent tools and palette panels
# /apps/paint.dapp
# Arrows move, space paints, 0 erases, 1-7 choose a color, p toggles pen
# mode, s saves, l loads, c twice clears, escape quits. Art is stored in
# /apps/paint.dat as rows of palette digits.

# The artwork keeps its existing save format while Tab5 adds a permanent sidebar.
CANVAS 100 40
SET cols 56
SET rows 28
DIM pixels 1568
SET cx 0
SET cy 0
SET brush 2
SET pen 0
SET confirm 0
SET quit 0
SETSTR msg "color 2   pen off"
GOSUB load
GOSUB draw

:loop
KEY k
IF $k = 0 GOTO idle
GOSUB handlekey
IF $quit = 1 GOTO leave
GOSUB draw
:idle
WAIT 18
GOTO loop

:handlekey
IF $k = $kesc GOTO hkquit
IF $k = $kleft GOTO hkleft
IF $k = $kright GOTO hkright
IF $k = $kup GOTO hkup
IF $k = $kdown GOTO hkdown
IF $k = $kspace GOTO hkpaint
IF $k = 112 GOTO hkpen
IF $k = 80 GOTO hkpen
IF $k = 115 GOTO hksave
IF $k = 83 GOTO hksave
IF $k = 108 GOTO hkload
IF $k = 76 GOTO hkload
IF $k = 99 GOTO hkclear
IF $k = 67 GOTO hkclear
IF $k < 48 GOTO hknone
IF $k > 55 GOTO hknone
EXPR brush $k - 48
SET confirm 0
SETSTR msg "brush $brush"
RETURN
:hkleft
SET confirm 0
IF $cx <= 0 GOTO hkaftermove
SUB cx 1
GOTO hkaftermove
:hkright
SET confirm 0
EXPR edge $cols - 1
IF $cx >= $edge GOTO hkaftermove
ADD cx 1
GOTO hkaftermove
:hkup
SET confirm 0
IF $cy <= 0 GOTO hkaftermove
SUB cy 1
GOTO hkaftermove
:hkdown
SET confirm 0
EXPR edge $rows - 1
IF $cy >= $edge GOTO hkaftermove
ADD cy 1
:hkaftermove
IF $pen = 0 GOTO hknone
GOSUB paintcell
RETURN
:hkpaint
SET confirm 0
GOSUB paintcell
RETURN
:hkpen
SET confirm 0
IF $pen = 1 GOTO penoff
SET pen 1
SETSTR msg "brush $brush   pen ON"
RETURN
:penoff
SET pen 0
SETSTR msg "brush $brush   pen off"
RETURN
:hksave
SET confirm 0
GOSUB save
SETSTR msg "art saved"
RETURN
:hkload
SET confirm 0
GOSUB clearpixels
GOSUB load
SETSTR msg "saved art loaded"
RETURN
:hkclear
IF $confirm = 1 GOTO cleargo
SET confirm 1
SETSTR msg "press c again to clear canvas"
RETURN
:cleargo
GOSUB clearpixels
SET confirm 0
SETSTR msg "canvas cleared"
RETURN
:hkquit
SET quit 1
:hknone
RETURN

:paintcell
EXPR idx $cy * $cols + $cx
SET pixels[$idx] $brush
SETSTR msg "brush $brush"
RETURN

:draw
CLS
COLOR pink
PUT 3 1 "PIXEL PAINT // TAB5 STUDIO"
COLOR cyan
PUT 65 1 "TOOLS + PALETTE"
COLOR white
PUT 65 4 "BRUSH  $brush"
PUT 65 5 "CURSOR $cx,$cy"
PUT 65 6 "PEN    $pen"
SET value 1
:palette
IF $value > 7 GOTO palettedone
GOSUB setcolor
EXPR py 7 + $value * 3
PUT 68 $py "$value  ##"
ADD value 1
GOTO palette
:palettedone
COLOR blue
PUT 68 31 "0  .."
SET y 0
:drawrow
IF $y >= $rows GOTO drawfooter
SET x 0
:drawcell
IF $x >= $cols GOTO drawnextr
EXPR idx $y * $cols + $x
EXPR px $x + 3
EXPR py $y + 6
IF $x = $cx GOTO maybecursor
GOTO normalpixel
:maybecursor
IF $y = $cy GOTO cursorpixel
:normalpixel
SET value $pixels[$idx]
IF $value = 0 GOTO blankpixel
GOSUB setcolor
PUT $px $py "#"
GOTO pixelnext
:blankpixel
COLOR blue
PUT $px $py "."
GOTO pixelnext
:cursorpixel
COLOR white
PUT $px $py "@"
:pixelnext
ADD x 1
GOTO drawcell
:drawnextr
ADD y 1
GOTO drawrow
:drawfooter
COLOR cyan
PUT 65 34 "$msg"
COLOR white
PUT 3 37 "ARROWS move   SPACE paint   P pen mode   0 erase"
PUT 3 39 "1-7 colour   S save   L load   C clear   ESC quit"
FLIP
RETURN

:setcolor
IF $value = 1 GOTO red
IF $value = 2 GOTO green
IF $value = 3 GOTO yellow
IF $value = 4 GOTO blue
IF $value = 5 GOTO magenta
IF $value = 6 GOTO cyan
COLOR white
RETURN
:red
COLOR red
RETURN
:green
COLOR green
RETURN
:yellow
COLOR yellow
RETURN
:blue
COLOR blue
RETURN
:magenta
COLOR magenta
RETURN
:cyan
COLOR cyan
RETURN

:clearpixels
SET i 0
EXPR cells $cols * $rows
:clearloop
SET pixels[$i] 0
ADD i 1
IF $i < $cells GOTO clearloop
RETURN

:save
FOPEN "/apps/paint.dat" write
IF $fok = 0 GOTO savedone
SET y 0
:saverow
IF $y >= $rows GOTO saveclose
SETSTR line ""
SET x 0
:savecell
IF $x >= $cols GOTO writerow
EXPR idx $y * $cols + $x
EXPR code $pixels[$idx] + 48
CHR one $code
APPEND line $one
ADD x 1
GOTO savecell
:writerow
FWRITE $line
ADD y 1
GOTO saverow
:saveclose
FCLOSE
:savedone
RETURN

:load
FEXISTS have "/apps/paint.dat"
IF $have = 0 GOTO loaddone
FOPEN "/apps/paint.dat" read
IF $fok = 0 GOTO loaddone
SET y 0
:loadrow
IF $y >= $rows GOTO loadclose
FREAD line
IF $feof = 1 GOTO loadclose
LEN n $line
SET x 0
:loadcell
IF $x >= $cols GOTO loadnextrow
IF $x >= $n GOTO loadnextrow
CHARAT value $line $x
SUB value 48
IF $value < 0 GOTO loadzero
IF $value > 7 GOTO loadzero
GOTO loadput
:loadzero
SET value 0
:loadput
EXPR idx $y * $cols + $x
SET pixels[$idx] $value
ADD x 1
GOTO loadcell
:loadnextrow
ADD y 1
GOTO loadrow
:loadclose
FCLOSE
:loaddone
RETURN

:leave
ENDCANVAS
COLOR pink
PRINT "pixel paint closed; press s before exit to keep changes"
EXIT
