# @dapp-format 1
# @id four
# @name Connect Four
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.1.0 <2.0.0
# @summary Connect Four against an alpha-beta search opponent
# /apps/four.dapp
# Connect Four for the DOLL-OS canvas. Left/right pick a column, space or
# enter drops, 1/2/3 set the AI's difficulty (its search depth), n starts
# a new game, escape quits.
#
# The opponent is alpha-beta minimax over the seven columns, searched by a
# real recursive GOSUB rather than an explicit tree walk -- .dapp allows
# nesting GOSUB up to 64 deep, more than enough for a four-to-six ply
# search. The catch is that every variable is global, so a naive
# recursive routine would have its loop counter and running best score
# overwritten the moment it calls itself one level deeper. `search` avoids
# that by keeping everything that must survive across its own recursive
# call -- alpha, beta, the best value so far, the column that produced it,
# and the move-ordering index -- in one array per quantity, indexed by
# `depth`. `depth` itself is the one plain global in the whole routine,
# incremented immediately before the recursive call and decremented
# immediately after, which is what makes indexing by it safe: at any
# instant exactly one array slot per depth is "in use" by the frame
# currently running at that depth, in the same LIFO order a real call
# stack would give it. Anything that is only needed before that recursive
# call -- the mover, the row just played, whether it won -- is read back
# out fresh afterward rather than trusted to have survived it.

CANVAS 80 36
DIM board 42
DIM height 7
DIM colorder 7
DIM colweight 7
DIM salpha 8
DIM sbeta 8
DIM sbest 8
DIM sbestcol 8
DIM movecol 8
DIM soi 8

SET colorder[0] 3
SET colorder[1] 2
SET colorder[2] 4
SET colorder[3] 1
SET colorder[4] 5
SET colorder[5] 0
SET colorder[6] 6

SET colweight[0] 3
SET colweight[1] 4
SET colweight[2] 5
SET colweight[3] 7
SET colweight[4] 5
SET colweight[5] 4
SET colweight[6] 3

COLOR yellow
PUT 10 2 "C O N N E C T   F O U R"
COLOR white
PUT 6 5 "left/right pick a column"
PUT 6 6 "space or enter drops"
PUT 6 7 "1 easy   2 medium   3 hard"
COLOR cyan
PUT 6 9 "pick a difficulty to begin"
FLIP

SET maxdepth 3
GOSUB loadrecord

:pickdiff
KEY k
IF $k = $kesc GOTO leave
IF $k = 49 GOTO pd_easy
IF $k = 50 GOTO pd_medium
IF $k = 51 GOTO pd_hard
WAIT 16
GOTO pickdiff
:pd_easy
SET maxdepth 2
SETSTR diffname "easy"
GOTO pd_go
:pd_medium
SET maxdepth 3
SETSTR diffname "medium"
GOTO pd_go
:pd_hard
SET maxdepth 4
SETSTR diffname "hard"
:pd_go

:newgame
SET curcol 3
SET quit 0
SET turn 1
SET over 0
SETSTR msg "your turn"
GOSUB clearboard
GOSUB draw

:gd_drain
KEY k
IF $k <> 0 GOTO gd_drain

# ---------------------------------------------------------------- main loop

:loop
KEY k
IF $k = 0 GOTO lp_wait
IF $k = $kesc GOTO leave
IF $k = 110 GOTO pickagain
IF $k = 78 GOTO pickagain
IF $over = 1 GOTO lp_wait
IF $turn <> 1 GOTO lp_wait
IF $k = $kleft GOTO hk_left
IF $k = 97 GOTO hk_left
IF $k = $kright GOTO hk_right
IF $k = 100 GOTO hk_right
IF $k = $kspace GOTO hk_drop
IF $k = $kenter GOTO hk_drop
GOTO lp_wait

:hk_left
IF $curcol <= 0 GOTO lp_wait
SUB curcol 1
GOSUB draw
GOTO lp_wait
:hk_right
IF $curcol >= 6 GOTO lp_wait
ADD curcol 1
GOSUB draw
GOTO lp_wait

:hk_drop
IF $height[$curcol] >= 6 GOTO lp_wait
SET col $curcol
SET mover 2
GOSUB makemove
GOSUB checkwin
GOSUB draw
IF $won = 1 GOTO humanwin
GOSUB isfull
IF $full = 1 GOTO drawgame
SET turn 2
SETSTR msg "thinking..."
GOSUB draw
GOSUB aimove
GOSUB draw
IF $won = 1 GOTO aiwin
GOSUB isfull
IF $full = 1 GOTO drawgame
SET turn 1
SETSTR msg "your turn"
GOSUB draw

:lp_wait
WAIT 16
GOTO loop

:pickagain
SET over 1
GOTO pickdiff

# ---------------------------------------------------------------- the AI

:aimove
SET depth 0
SET salpha[0] -1000000
SET sbeta[0] 1000000
GOSUB search
SET col $rootbestcol
SET mover 1
GOSUB makemove
GOSUB checkwin
RETURN

# entry:  depth = this node's ply; salpha[depth], sbeta[depth] = its bounds
# exit:   sbest[depth] = this node's minimax value; at depth 0, rootbestcol
#
# ismaxflag is 0 -- not 1 -- on the ply that maximizes (the AI's move,
# depth even), because it comes from depth % 2 and depth 0 is the AI's
# own decision. Every branch below is keyed off "= 0" for that reason; it
# reads backwards next to its name if you forget which parity is whose.
# It is recomputed wherever needed rather than kept in a variable across
# the recursive call below, since it is a cheap pure function of depth --
# one fewer thing that would need its own array.
:search
EXPR ismaxflag $depth % 2
SET mover 2
IF $ismaxflag = 0 GOTO se_moverai
GOTO se_moverset
:se_moverai
SET mover 1
:se_moverset

SET sbest[$depth] -1000000
IF $ismaxflag = 0 GOTO se_initdone
SET sbest[$depth] 1000000
:se_initdone
SET sbestcol[$depth] -1
SET soi[$depth] 0

:se_colloop
IF $soi[$depth] >= 7 GOTO se_loopdone
SET col $colorder[$soi[$depth]]
IF $height[$col] >= 6 GOTO se_colnext
SET movecol[$depth] $col

GOSUB makemove
GOSUB checkwin

IF $won = 1 GOTO se_winval
GOSUB isfull
IF $full = 1 GOTO se_drawval
EXPR nextdepth $depth + 1
IF $nextdepth >= $maxdepth GOTO se_leafval
GOTO se_recurse

:se_winval
IF $ismaxflag = 0 GOTO se_winai
EXPR val -100000 + $depth
GOTO se_valdone
:se_winai
EXPR val 100000 - $depth
GOTO se_valdone

:se_drawval
SET val 0
GOTO se_valdone

:se_leafval
GOSUB evaluate
SET val $evalscore
GOTO se_valdone

:se_recurse
EXPR nextdepth $depth + 1
SET salpha[$nextdepth] $salpha[$depth]
SET sbeta[$nextdepth] $sbeta[$depth]
ADD depth 1
GOSUB search
SUB depth 1
EXPR nextdepth $depth + 1
SET val $sbest[$nextdepth]

:se_valdone
SET col $movecol[$depth]
GOSUB undomove

EXPR ismaxflag $depth % 2
IF $ismaxflag = 0 GOTO se_maxcompare
IF $val < $sbest[$depth] GOSUB se_takemin
GOTO se_aftercompare
:se_maxcompare
IF $val > $sbest[$depth] GOSUB se_takemax

:se_aftercompare
IF $ismaxflag = 0 GOTO se_updatealpha
IF $sbest[$depth] < $sbeta[$depth] GOSUB se_setbeta
GOTO se_prunecheck
:se_updatealpha
IF $sbest[$depth] > $salpha[$depth] GOSUB se_setalpha
:se_prunecheck
IF $salpha[$depth] >= $sbeta[$depth] GOTO se_loopdone

:se_colnext
ADD soi[$depth] 1
GOTO se_colloop

:se_loopdone
IF $depth <> 0 GOTO se_return
SET rootbestcol $sbestcol[$depth]
:se_return
RETURN

:se_takemin
SET sbest[$depth] $val
SET sbestcol[$depth] $col
RETURN
:se_takemax
SET sbest[$depth] $val
SET sbestcol[$depth] $col
RETURN
:se_setalpha
SET salpha[$depth] $sbest[$depth]
RETURN
:se_setbeta
SET sbeta[$depth] $sbest[$depth]
RETURN

# a leaf's worth is just centre-column control: cheap (one pass over the
# board) rather than counting open lines, which keeps a depth-4 search
# comfortably under the step limit with no WAIT inside it
:evaluate
SET evalscore 0
SET ei 0
:ev_loop
IF $ei >= 42 GOTO ev_next
SET cellval $board[$ei]
IF $cellval = 0 GOTO ev_skip
EXPR ecol $ei % 7
SET w $colweight[$ecol]
IF $cellval = 1 GOTO ev_ai
SUB evalscore $w
GOTO ev_skip
:ev_ai
ADD evalscore $w
:ev_skip
:ev_next
ADD ei 1
IF $ei < 42 GOTO ev_loop
RETURN

# ---------------------------------------------------------------- board rules

# in: col, mover -- drops a piece, tracked as row 5 (bottom) upward
:makemove
EXPR row 5 - $height[$col]
EXPR idx $row * 7 + $col
SET board[$idx] $mover
ADD height[$col] 1
RETURN

# in: col -- reverses the most recent makemove on that column
:undomove
SUB height[$col] 1
EXPR row 5 - $height[$col]
EXPR idx $row * 7 + $col
SET board[$idx] 0
RETURN

:isfull
SET full 1
SET fi 0
:if_loop
IF $height[$fi] < 6 GOTO if_notfull
ADD fi 1
IF $fi < 7 GOTO if_loop
RETURN
:if_notfull
SET full 0
RETURN

# in: row, col, mover (set by the caller's makemove) -- out: won
:checkwin
SET won 0
SET dx 1
SET dy 0
GOSUB checkline
IF $linecount >= 4 GOTO cw_win
SET dx 0
SET dy 1
GOSUB checkline
IF $linecount >= 4 GOTO cw_win
SET dx 1
SET dy 1
GOSUB checkline
IF $linecount >= 4 GOTO cw_win
SET dx 1
SET dy -1
GOSUB checkline
IF $linecount >= 4 GOTO cw_win
RETURN
:cw_win
SET won 1
RETURN

# in: dx, dy, row, col, mover -- out: linecount, consecutive mover-owned
# cells through (row,col) along the dx,dy axis, counting both directions
:checkline
SET linecount 1
SET step 1
:cl_pos
EXPR rr $row + $dy * $step
EXPR cc $col + $dx * $step
IF $rr < 0 GOTO cl_negstart
IF $rr > 5 GOTO cl_negstart
IF $cc < 0 GOTO cl_negstart
IF $cc > 6 GOTO cl_negstart
EXPR lidx $rr * 7 + $cc
IF $board[$lidx] <> $mover GOTO cl_negstart
ADD linecount 1
ADD step 1
GOTO cl_pos
:cl_negstart
SET step 1
:cl_neg
EXPR rr $row - $dy * $step
EXPR cc $col - $dx * $step
IF $rr < 0 GOTO cl_done
IF $rr > 5 GOTO cl_done
IF $cc < 0 GOTO cl_done
IF $cc > 6 GOTO cl_done
EXPR lidx $rr * 7 + $cc
IF $board[$lidx] <> $mover GOTO cl_done
ADD linecount 1
ADD step 1
GOTO cl_neg
:cl_done
RETURN

:clearboard
SET zi 0
:cb_loop
SET board[$zi] 0
ADD zi 1
IF $zi < 42 GOTO cb_loop
SET zc 0
:cb_col
SET height[$zc] 0
ADD zc 1
IF $zc < 7 GOTO cb_col
RETURN

# ---------------------------------------------------------------- drawing

:draw
CLS
COLOR yellow
PUT 3 0 "CONNECT FOUR"
COLOR cyan
PUT 48 3 $diffname
COLOR white
PUT 48 6 "wins $wins"
PUT 48 8 "losses $losses"
PUT 48 10 "draws $draws"

SET dc 0
:dr_marker
COLOR blue
SETSTR mm " "
IF $dc <> $curcol GOTO dr_markput
IF $over = 1 GOTO dr_markput
IF $turn <> 1 GOTO dr_markput
COLOR yellow
SETSTR mm "v"
:dr_markput
EXPR mx $dc * 3 + 1
PUT $mx 1 $mm
ADD dc 1
IF $dc < 7 GOTO dr_marker

COLOR blue
PUT 0 2 "+-----------------------+"
SET dy 0
:dr_row
SET dcx 0
:dr_col
EXPR di $dy * 7 + $dcx
SET v $board[$di]
GOSUB cellchar
EXPR px $dcx * 3 + 1
EXPR py $dy + 3
PUT $px $py $ch
ADD dcx 1
IF $dcx < 7 GOTO dr_col
ADD dy 1
IF $dy < 6 GOTO dr_row
COLOR blue
PUT 0 9 "+-----------------------+"

COLOR green
PUT 0 11 $msg
COLOR yellow
PUT 48 18 "LEFT/RIGHT  choose"
PUT 48 20 "SPACE       drop"
PUT 48 22 "N           new game"
PUT 48 24 "ESC         quit"
FLIP
RETURN

:cellchar
COLOR white
SETSTR ch " . "
IF $v = 0 GOTO cc_done
COLOR red
SETSTR ch " O "
IF $v = 1 GOTO cc_done
COLOR cyan
SETSTR ch " X "
:cc_done
RETURN

# ---------------------------------------------------------------- record

:loadrecord
SET wins 0
SET losses 0
SET draws 0
FEXISTS have "/apps/four.rec"
IF $have = 0 GOTO lr_done
FOPEN "/apps/four.rec" read
IF $fok = 0 GOTO lr_done
FREAD ln
GOSUB str2num
SET wins $num
FREAD ln
GOSUB str2num
SET losses $num
FREAD ln
GOSUB str2num
SET draws $num
FCLOSE
:lr_done
RETURN

:saverecord
FOPEN "/apps/four.rec" write
IF $fok = 0 GOTO sr_done
FWRITE $wins
FWRITE $losses
FWRITE $draws
FCLOSE
:sr_done
RETURN

# in: ln (string)   out: num -- a record field read back from a file is text
:str2num
SET num 0
SET s2i 0
LEN s2len $ln
:s2n_loop
IF $s2i >= $s2len GOTO s2n_done
CHARAT s2d $ln $s2i
IF $s2d < 48 GOTO s2n_done
IF $s2d > 57 GOTO s2n_done
SUB s2d 48
MUL num 10
ADD num $s2d
ADD s2i 1
GOTO s2n_loop
:s2n_done
RETURN

# ---------------------------------------------------------------- endings

:humanwin
SET over 1
ADD wins 1
GOSUB saverecord
SETSTR msg "you win! n=new game  esc=quit"
GOSUB draw
GOTO endwait
:aiwin
SET over 1
ADD losses 1
GOSUB saverecord
SETSTR msg "the machine wins. n=new game  esc=quit"
GOSUB draw
GOTO endwait
:drawgame
SET over 1
ADD draws 1
GOSUB saverecord
SETSTR msg "draw. n=new game  esc=quit"
GOSUB draw

:endwait
WAIT 200
:ew_drain
KEY k
IF $k <> 0 GOTO ew_drain
GOTO loop

:leave
ENDCANVAS
COLOR yellow
PRINT "four: $wins won, $losses lost, $draws drawn"
EXIT
