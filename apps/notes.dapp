# @dapp-format 1
# @id notes
# @name Notes
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.1.0 <2.0.0
# @summary A numbered notepad kept in /apps/notes.txt
# /apps/notes.dapp
# A notepad for the DOLL-OS shell. Notes live one per line in
# /apps/notes.txt, so `cat /apps/notes.txt` and `edit /apps/notes.txt` see
# exactly what this app sees.
#
# The whole file is loaded into memory before anything is edited, because a
# .dapp can only hold one file open at a time: deleting note 3 by rewriting
# the file around it would otherwise mean reading and writing the same file
# at once. Since there are no string arrays, the notes are held as
# character codes in one numeric array -- slot n occupies cells
# n*90 .. n*90+89, and lens[n] says how many of them are real. Loading is
# one pass, saving is one pass, and everything in between is arithmetic.

SET slots 24
SET width 90
DIM txt 2160
DIM lens 24

COLOR pink
PRINT "notes"
COLOR white
GOSUB load
IF $loaded = 0 GOTO nofile
COLOR cyan
PRINT "$count note(s) in /apps/notes.txt"
GOTO menu
:nofile
COLOR cyan
PRINT "no notes yet - /apps/notes.txt will be created"

# ---------------------------------------------------------------- menu

:menu
PRINT ""
GOSUB list
PRINT ""
COLOR yellow
PRINT "a add    v view    d delete    x clear    q quit"
COLOR white
INPUT cmd "notes> "
IFEQ $cmd "a" GOTO doadd
IFEQ $cmd "add" GOTO doadd
IFEQ $cmd "v" GOTO doview
IFEQ $cmd "view" GOTO doview
IFEQ $cmd "d" GOTO dodelete
IFEQ $cmd "delete" GOTO dodelete
IFEQ $cmd "x" GOTO doclear
IFEQ $cmd "q" GOTO leave
IFEQ $cmd "quit" GOTO leave
IFEQ $cmd "" GOTO menu
COLOR red
PRINT "unknown command: $cmd"
GOTO menu

# ---------------------------------------------------------------- commands

:doadd
IF $count >= $slots GOTO addfull
COLOR white
INPUT line "note> "
LEN l $line
IF $l = 0 GOTO menu
SET idx $count
GOSUB store
ADD count 1
GOSUB save
COLOR green
PRINT "added note $count"
GOTO menu

:addfull
COLOR red
PRINT "the notepad is full at $slots notes"
GOTO menu

:doview
IF $count = 0 GOTO nonotes
GOSUB asknumber
IF $num = 0 GOTO menu
EXPR idx $num - 1
GOSUB fetch
PRINT ""
COLOR cyan
PRINT "note $num"
COLOR white
PRINT $line
GOTO menu

:dodelete
IF $count = 0 GOTO nonotes
GOSUB asknumber
IF $num = 0 GOTO menu
EXPR idx $num - 1
GOSUB fetch
# saving rebuilds every note through `line`, so keep a copy of the one
# being deleted for the confirmation
SETSTR gone $line
GOSUB remove
GOSUB save
COLOR green
PRINT "deleted: $gone"
GOTO menu

:doclear
IF $count = 0 GOTO nonotes
COLOR yellow
INPUT yn "delete all $count notes? (y/n) "
IFNE $yn "y" GOTO menu
SET count 0
GOSUB save
COLOR green
PRINT "notepad cleared"
GOTO menu

:nonotes
COLOR yellow
PRINT "there are no notes yet"
GOTO menu

# asks for a note number and validates it; num is 0 when the answer was
# not a number this notepad has
:asknumber
COLOR white
INPUT text "number> "
GOSUB str2num
IF $num < 1 GOTO an_bad
IF $num > $count GOTO an_bad
RETURN
:an_bad
SET num 0
COLOR red
PRINT "pick a number between 1 and $count"
RETURN

# ---------------------------------------------------------------- listing

:list
IF $count = 0 GOTO ls_empty
SET idx 0
:ls_loop
GOSUB fetch
EXPR n $idx + 1
COLOR cyan
PRINT "$n  $line"
ADD idx 1
IF $idx < $count GOTO ls_loop
RETURN
:ls_empty
COLOR white
PRINT "(empty)"
RETURN

# ---------------------------------------------------------------- storage

# in: line, idx -- copies the text into slot idx, truncating at 48 chars
:store
LEN l $line
IF $l <= $width GOTO st_fit
SET l $width
:st_fit
SET lens[$idx] $l
EXPR base $idx * $width
SET j 0
:st_ch
IF $j >= $l GOTO st_done
CHARAT code $line $j
EXPR cell $base + $j
SET txt[$cell] $code
ADD j 1
GOTO st_ch
:st_done
RETURN

# in: idx -- rebuilds slot idx as the string `line`
:fetch
SETSTR line ""
SET l $lens[$idx]
EXPR base $idx * $width
SET j 0
:ft_ch
IF $j >= $l GOTO ft_done
EXPR cell $base + $j
CHR one $txt[$cell]
APPEND line $one
ADD j 1
GOTO ft_ch
:ft_done
RETURN

# in: idx -- closes the gap by moving every later slot down one
:remove
SET s $idx
:rm_slot
EXPR s1 $s + 1
IF $s1 >= $count GOTO rm_last
SET lens[$s] $lens[$s1]
EXPR b0 $s * $width
EXPR b1 $s1 * $width
SET j 0
:rm_ch
EXPR c0 $b0 + $j
EXPR c1 $b1 + $j
SET txt[$c0] $txt[$c1]
ADD j 1
IF $j < $width GOTO rm_ch
SET s $s1
GOTO rm_slot
:rm_last
SUB count 1
SET lens[$count] 0
RETURN

# ---------------------------------------------------------------- the file

:load
SET count 0
SET loaded 0
FEXISTS have "/apps/notes.txt"
IF $have = 0 GOTO ld_done
FOPEN "/apps/notes.txt" read
IF $fok = 0 GOTO ld_done
SET loaded 1
:ld_line
IF $count >= $slots GOTO ld_close
FREAD line
IF $feof = 1 GOTO ld_close
LEN l $line
IF $l = 0 GOTO ld_line
SET idx $count
GOSUB store
ADD count 1
GOTO ld_line
:ld_close
FCLOSE
:ld_done
RETURN

# the file is always written whole: an empty notepad truncates it to
# nothing rather than leaving the last version behind
:save
FOPEN "/apps/notes.txt" write
IF $fok = 0 GOTO sv_failed
SET idx 0
:sv_loop
IF $idx >= $count GOTO sv_done
GOSUB fetch
FWRITE $line
ADD idx 1
GOTO sv_loop
:sv_done
FCLOSE
RETURN
:sv_failed
COLOR red
PRINT "could not write /apps/notes.txt"
RETURN

# in: text (string)   out: num -- leading digits of a typed answer
:str2num
SET num 0
SET s2i 0
LEN s2len $text
:s2n_loop
IF $s2i >= $s2len GOTO s2n_done
CHARAT s2d $text $s2i
IF $s2d < 48 GOTO s2n_done
IF $s2d > 57 GOTO s2n_done
SUB s2d 48
MUL num 10
ADD num $s2d
ADD s2i 1
GOTO s2n_loop
:s2n_done
RETURN

:leave
COLOR pink
PRINT "notes: $count kept in /apps/notes.txt"
EXIT
