# @dapp-format 1
# @id beacon
# @name Beacon
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.3.0 <2.0.0
# @summary Signal patterns and morse code on the rear RGB LED
# /apps/beacon.dapp
# Turns the rear RGB LED into a signal lamp: SOS, strobe, breathe,
# rainbow, police, firelight, or any message you type sent as morse code.
# Any key stops the running pattern and comes back to the menu.
#
# The morse table is one 180-character string of five-character slots, A-Z
# then 0-9, padded with spaces. SUBSTR pulls out a letter's slot by index
# and CHARAT walks it: a dot is one unit lit, a dash is three, and a space
# ends the letter early. That is the entire encoder -- no arrays, and no
# branch per letter.
#
# Every pattern is built from one `flash` routine: set a colour, wait, and
# look for a keypress. LED writes only reach the hardware during a WAIT
# (that is when the shell services its indicator mixer), so pairing them is
# not a stylistic choice -- a flash with no wait after it is invisible.

SETSTR table ".-   -... -.-. -..  .    ..-. --.  .... ..   .--- -.-  .-.. --   -.   ---  .--. --.- .-.  ...  -    ..-  ...- .--  -..- -.-- --.. -----.----..---...--....-.....-....--...---..----."
SET unit 180

COLOR pink
PRINT "beacon"
IF $ledok = 1 GOTO menu
COLOR red
PRINT "this build has no rear LED - patterns will run silently"

:menu
GOSUB dark
PRINT ""
COLOR yellow
PRINT "1 sos      2 strobe   3 breathe"
PRINT "4 rainbow  5 police   6 firelight"
PRINT "7 morse a message     q quit"
COLOR white
INPUT choice "beacon> "
SET stop 0
IFEQ $choice "1" GOTO dosos
IFEQ $choice "2" GOTO dostrobe
IFEQ $choice "3" GOTO dobreathe
IFEQ $choice "4" GOTO dorainbow
IFEQ $choice "5" GOTO dopolice
IFEQ $choice "6" GOTO dofire
IFEQ $choice "7" GOTO domessage
IFEQ $choice "q" GOTO bye
IFEQ $choice "quit" GOTO bye
IFEQ $choice "" GOTO menu
COLOR red
PRINT "1 to 7, or q"
GOTO menu

# ---------------------------------------------------------------- patterns

:dosos
COLOR cyan
PRINT "sos - press any key to stop"
SETSTR msg "SOS"
GOSUB playmorse
GOTO menu

:domessage
COLOR white
INPUT msg "message> "
LEN mlen $msg
IF $mlen = 0 GOTO menu
COLOR cyan
PRINT "sending - press any key to stop"
GOSUB playmorse
GOTO menu

:dostrobe
COLOR cyan
PRINT "strobe - press any key to stop"
:st_loop
SET lr 255
SET lg 255
SET lb 255
SET ms 40
GOSUB flash
IF $stop = 1 GOTO menu
GOSUB darkflash
IF $stop = 1 GOTO menu
GOTO st_loop

:dobreathe
COLOR cyan
PRINT "breathe - press any key to stop"
SET lvl 0
SET dir 12
:br_loop
SET lr 0
EXPR lg floor($lvl * 3 / 4)
SET lb $lvl
SET ms 40
GOSUB flash
IF $stop = 1 GOTO menu
ADD lvl $dir
IF $lvl < 252 GOTO br_low
SET dir -12
:br_low
IF $lvl > 0 GOTO br_loop
SET dir 12
GOTO br_loop

:dorainbow
COLOR cyan
PRINT "rainbow - press any key to stop"
SET hue 0
:rb_loop
GOSUB huecolour
SET ms 60
GOSUB flash
IF $stop = 1 GOTO menu
ADD hue 5
IF $hue < 360 GOTO rb_loop
SET hue 0
GOTO rb_loop

:dopolice
COLOR cyan
PRINT "police - press any key to stop"
:pl_loop
SET pn 0
:pl_red
SET lr 255
SET lg 0
SET lb 0
SET ms 70
GOSUB flash
IF $stop = 1 GOTO menu
GOSUB darkflash
IF $stop = 1 GOTO menu
ADD pn 1
IF $pn < 3 GOTO pl_red
SET pn 0
:pl_blue
SET lr 0
SET lg 40
SET lb 255
SET ms 70
GOSUB flash
IF $stop = 1 GOTO menu
GOSUB darkflash
IF $stop = 1 GOTO menu
ADD pn 1
IF $pn < 3 GOTO pl_blue
GOTO pl_loop

# a fire is mostly a steady ember with the occasional flare, which is two
# random numbers: one for the brightness and a shorter one for the green
# that turns red into orange
:dofire
COLOR cyan
PRINT "firelight - press any key to stop"
:fi_loop
RAND base 120 255
RAND warm 30 90
SET lr $base
EXPR lg floor($base * $warm / 255)
SET lb 0
RAND ms 40 130
GOSUB flash
IF $stop = 1 GOTO menu
GOTO fi_loop

# ---------------------------------------------------------------- morse

# in: msg -- sends it once, then repeats after a long gap until a key
:playmorse
LEN mlen $msg
:pm_pass
SET mi 0
:pm_char
IF $mi >= $mlen GOTO pm_end
CHARAT mc $msg $mi
IF $mc = 32 GOTO pm_word
GOSUB sendchar
IF $stop = 1 GOTO pm_stop
ADD mi 1
GOTO pm_char

:pm_word
COLOR blue
PRINT "  /"
EXPR ms $unit * 5
GOSUB darkwait
IF $stop = 1 GOTO pm_stop
ADD mi 1
GOTO pm_char

# the pause before the message repeats is twelve units, waited two at a
# time: one long WAIT would hold the keyboard for two seconds and make
# stopping feel broken
:pm_end
SET gaps 0
:pm_gap
EXPR ms $unit * 2
GOSUB darkwait
IF $stop = 1 GOTO pm_stop
ADD gaps 1
IF $gaps < 6 GOTO pm_gap
GOTO pm_pass

# a stopped pattern leaves through the routine's own RETURN: jumping
# straight back to the menu would strand this call on the GOSUB stack
:pm_stop
RETURN

# in: mc (character code) -- one letter, printed and blinked
:sendchar
SET idx -1
IF $mc >= 97 GOTO sc_lower
IF $mc >= 65 GOTO sc_upper
IF $mc >= 48 GOTO sc_digit
GOTO sc_skip
:sc_lower
IF $mc > 122 GOTO sc_skip
EXPR idx $mc - 97
GOTO sc_have
:sc_upper
IF $mc > 90 GOTO sc_skip
EXPR idx $mc - 65
GOTO sc_have
:sc_digit
IF $mc > 57 GOTO sc_skip
EXPR idx $mc - 48 + 26
:sc_have
EXPR start $idx * 5
SUBSTR code $table $start 5
CHR shown $mc
COLOR green
PRINT "$shown $code"
SET si 0
:sc_symbol
CHARAT sym $code $si
IF $sym = 32 GOTO sc_letter_gap
SET ms $unit
IF $sym = 45 GOSUB dashlength
SET lr 255
SET lg 200
SET lb 120
GOSUB flash
IF $stop = 1 GOTO sc_skip
SET ms $unit
GOSUB darkwait
IF $stop = 1 GOTO sc_skip
ADD si 1
IF $si < 5 GOTO sc_symbol
:sc_letter_gap
EXPR ms $unit * 2
GOSUB darkwait
:sc_skip
RETURN

:dashlength
EXPR ms $unit * 3
RETURN

# ---------------------------------------------------------------- the LED

# in: lr,lg,lb,ms -- the colour for ms, and a look at the keyboard. Every
# pattern is made of these, which is why stopping is never more than one
# flash away.
:flash
GOSUB led
WAIT $ms
KEY k
IF $k <> 0 GOTO fl_stop
RETURN
:fl_stop
SET stop 1
RETURN

:darkflash
SET ms 60
:darkwait
SET lr 0
SET lg 0
SET lb 0
GOSUB flash
RETURN

:dark
SET lr 0
SET lg 0
SET lb 0
GOSUB led
RETURN

# the only place LED is called: $ledok is 0 on a build with no rear LED,
# where the opcode would stop the app rather than being ignored
:led
IF $ledok = 0 GOTO led_done
LED $lr $lg $lb
:led_done
RETURN

# in: hue (0..359) -- out: lr,lg,lb walking the six ramps of the wheel
:huecolour
EXPR seg floor($hue / 60)
EXPR rise floor(($hue - $seg * 60) * 255 / 60)
EXPR fall 255 - $rise
IF $seg = 1 GOTO hc_1
IF $seg = 2 GOTO hc_2
IF $seg = 3 GOTO hc_3
IF $seg = 4 GOTO hc_4
IF $seg = 5 GOTO hc_5
SET lr 255
SET lg $rise
SET lb 0
RETURN
:hc_1
SET lr $fall
SET lg 255
SET lb 0
RETURN
:hc_2
SET lr 0
SET lg 255
SET lb $rise
RETURN
:hc_3
SET lr 0
SET lg $fall
SET lb 255
RETURN
:hc_4
SET lr $rise
SET lg 0
SET lb 255
RETURN
:hc_5
SET lr 255
SET lg 0
SET lb $fall
RETURN

:bye
GOSUB dark
WAIT 30
COLOR pink
PRINT "beacon: dark again"
EXIT
