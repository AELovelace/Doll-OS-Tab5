# @dapp-format 1
# @id habits
# @name Pocket Habits
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.1.0 <2.0.0
# @summary A persistent four-habit weekly tracker sized for Cardputer
# /apps/habits.dapp
# Left/right choose a day, 1-4 toggle habits, r twice resets the week,
# escape quits. State is kept in /apps/habits.dat.

CANVAS 80 36
DIM done 28
SET day 0
SET confirm 0
SET quit 0
SETSTR msg "1-4 toggle   arrows choose day"
GOSUB load
GOSUB draw

:loop
KEY k
IF $k = 0 GOTO idle
GOSUB key
IF $quit = 1 GOTO leave
GOSUB save
GOSUB draw
:idle
WAIT 18
GOTO loop

:key
IF $k = $kesc GOTO keyquit
IF $k = $kleft GOTO keyleft
IF $k = $kright GOTO keyright
IF $k = 97 GOTO keyleft
IF $k = 100 GOTO keyright
IF $k = 114 GOTO keyreset
IF $k = 82 GOTO keyreset
IF $k < 49 GOTO keynone
IF $k > 52 GOTO keynone
SET confirm 0
EXPR habit $k - 49
EXPR idx $habit * 7 + $day
SET value $done[$idx]
IF $value = 1 GOTO keyoff
SET done[$idx] 1
SETSTR msg "checked"
RETURN
:keyoff
SET done[$idx] 0
SETSTR msg "unchecked"
RETURN
:keyleft
SET confirm 0
SUB day 1
IF $day >= 0 GOTO keynone
SET day 6
RETURN
:keyright
SET confirm 0
ADD day 1
IF $day <= 6 GOTO keynone
SET day 0
RETURN
:keyreset
IF $confirm = 1 GOTO resetgo
SET confirm 1
SETSTR msg "press r again to reset the week"
RETURN
:resetgo
SET i 0
:resetloop
SET done[$i] 0
ADD i 1
IF $i < 28 GOTO resetloop
SET confirm 0
SETSTR msg "new week started"
RETURN
:keyquit
SET quit 1
:keynone
RETURN

:draw
CLS
COLOR pink
PUT 3 2 "P O C K E T   H A B I T S"
COLOR cyan
PUT 58 2 "WEEK VIEW"
COLOR white
PUT 20 7 "MON     TUE     WED     THU     FRI     SAT     SUN"
SET row 0
:drawhabit
IF $row >= 4 GOTO drawfoot
EXPR y 11 + $row * 5
IF $row = 0 GOTO namewater
IF $row = 1 GOTO namemove
IF $row = 2 GOTO nameread
SETSTR name "Sleep"
GOTO namedone
:namewater
SETSTR name "Water"
GOTO namedone
:namemove
SETSTR name "Move "
GOTO namedone
:nameread
SETSTR name "Read "
:namedone
COLOR white
PUT 3 $y "$name"
SET col 0
:drawday
IF $col >= 7 GOTO nextrow
EXPR idx $row * 7 + $col
EXPR x 21 + $col * 8
IF $col = $day GOTO drawselected
COLOR blue
GOTO drawmark
:drawselected
COLOR yellow
:drawmark
SET value $done[$idx]
IF $value = 1 GOTO markyes
PUT $x $y "."
GOTO markdone
:markyes
COLOR green
PUT $x $y "x"
:markdone
ADD col 1
GOTO drawday
:nextrow
ADD row 1
GOTO drawhabit
:drawfoot
COLOR cyan
PUT 3 32 "$msg"
COLOR white
PUT 3 34 "1-4 toggle   LEFT/RIGHT choose day   R twice reset   ESC save and quit"
FLIP
RETURN

:load
FEXISTS have "/apps/habits.dat"
IF $have = 0 GOTO loaddone
FOPEN "/apps/habits.dat" read
IF $fok = 0 GOTO loaddone
FREAD line
FCLOSE
LEN n $line
SET i 0
:loadloop
IF $i >= 28 GOTO loaddone
IF $i >= $n GOTO loaddone
CHARAT value $line $i
SUB value 48
IF $value < 0 GOTO loadzero
IF $value > 1 GOTO loadzero
SET done[$i] $value
GOTO loadnext
:loadzero
SET done[$i] 0
:loadnext
ADD i 1
GOTO loadloop
:loaddone
RETURN

:save
SETSTR line ""
SET i 0
:saveloop
IF $i >= 28 GOTO savewrite
EXPR code $done[$i] + 48
CHR one $code
APPEND line $one
ADD i 1
GOTO saveloop
:savewrite
FOPEN "/apps/habits.dat" write
IF $fok = 0 GOTO savedone
FWRITE $line
FCLOSE
:savedone
RETURN

:leave
GOSUB save
ENDCANVAS
COLOR pink
PRINT "habits saved"
EXIT
