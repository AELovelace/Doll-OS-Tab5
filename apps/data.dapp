# @dapp-format 1
# @id data
# @name Data
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.5.0 <2.0.0
# @echo off
# @summary Preview and profile delimited local or HTTP datasets up to 256KB
# /apps/data.dapp
# A deliberately small CSV/TSV explorer. Quoted delimiters are not interpreted;
# use it for logs and simple machine-produced tables rather than full RFC 4180.

SETSTR source "/apps/requests.last"
SET delimiter 44

:menu
CLEAR
COLOR pink
PRINT "DATA // DELIMITED FILE EXPLORER"
COLOR white
PRINT "source: $source"
PRINT "delimiter code: $delimiter"
PRINT ""
PRINT "1 local file"
PRINT "2 download URL"
PRINT "3 choose comma/tab/pipe delimiter"
PRINT "4 preview and profile"
PRINT "q quit"
INPUT choice "data> "
IFEQ $choice "1" GOTO local
IFEQ $choice "2" GOTO remote
IFEQ $choice "3" GOTO delim
IFEQ $choice "4" GOTO profile
IFEQ $choice "q" GOTO leave
GOTO menu

:local
INPUT source "path> "
GOTO menu

:remote
INPUT url "url> "
LEN n $url
IF $n = 0 GOTO menu
BUFNEW 262144
HTTPGETBUF $url 262144
IF $httpok = 0 GOTO remote_fail
BUFSAVE "/apps/data.download"
SETSTR source "/apps/data.download"
PRINT "downloaded $buflen bytes"
INPUT choice "enter> "
GOTO menu
:remote_fail
PRINT "download failed: HTTP $httpcode"
INPUT choice "enter> "
GOTO menu

:delim
INPUT choice "comma, tab, or pipe [c/t/p]> "
IFEQ $choice "t" GOTO tab
IFEQ $choice "p" GOTO pipe
SET delimiter 44
GOTO menu
:tab
SET delimiter 9
GOTO menu
:pipe
SET delimiter 124
GOTO menu

:profile
FEXISTS have $source
IF $have = 0 GOTO missing
BUFNEW 262144
BUFLOAD $source
IF $bufok = 0 GOTO missing
CLEAR
COLOR cyan
PRINT "DATA PROFILE"
COLOR white
PRINT "$source  ($buflen bytes)"
SET pos 0
SET rows 0
SET cols 0
SET maxcols 0
SET shown 0
SET col 1
SETSTR line ""
:scan
IF $pos >= $buflen GOTO finish
BUFAT ch $pos
IF $ch = 13 GOTO advance
IF $ch = 10 GOTO newline
IF $ch = $delimiter GOTO separator
BUFSUB one $pos 1
LEN n $line
IF $n >= 94 GOTO advance
APPEND line $one
:advance
ADD pos 1
GOTO scan
:separator
APPEND line " | "
ADD col 1
ADD pos 1
GOTO scan
:newline
ADD rows 1
IF $col <= $maxcols GOTO nl_maxdone
SET maxcols $col
:nl_maxdone
IF $shown >= 15 GOTO nl_reset
PRINT "$line"
ADD shown 1
:nl_reset
SETSTR line ""
SET col 1
ADD pos 1
EXPR pulse $rows % 50
IF $pulse <> 0 GOTO scan
WAIT 1
GOTO scan
:finish
LEN n $line
IF $n = 0 GOTO summary
ADD rows 1
IF $col <= $maxcols GOTO summary
SET maxcols $col
:summary
PRINT ""
COLOR yellow
PRINT "$rows rows, up to $maxcols columns"
COLOR white
INPUT choice "enter> "
GOTO menu
:missing
PRINT "data: cannot load $source"
INPUT choice "enter> "
GOTO menu

:leave
BUFFREE
PRINT "data: done"
EXIT
