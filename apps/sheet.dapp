# @dapp-format 1
# @id sheet
# @name Sheet
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.1.0 <2.0.0
# @summary A full-height Tab5 spreadsheet with formulas, ranges and saved files
# /apps/sheet.dapp
# A spreadsheet for the DOLL-OS canvas. Arrows move, enter edits the cell,
# typing a digit, - or = starts an entry straight away, D clears a cell,
# S saves, L loads, X (twice) wipes the sheet, escape quits.
#
# Cells hold a number, a label, or a formula beginning with '='. Formulas
# take + - * / % ^, parentheses, cell references like B7, and the range
# functions SUM, AVG, MIN, MAX and COUNT: =SUM(A1:A9)/COUNT(A1:A9).
#
# Three things are worth reading the code for.
#
# The cell text is character codes in one numeric array, 24 per cell, with
# lens[] saying how many are real -- .dapp has no array of strings, and a
# spreadsheet has to keep what you typed as well as what it means.
#
# The formula evaluator is a shunting-yard parser: operands go on one
# stack, operators on another, and an operator is applied when something
# of lower precedence arrives. It is written that way because a recursive
# descent parser needs local variables per level, and every variable here
# is global -- an explicit stack in an array is the honest version of the
# same algorithm.
#
# Recalculation is iterative rather than dependency-ordered. Every formula
# is evaluated, and if any value changed the whole sheet is evaluated
# again, up to eight times. That is how spreadsheets worked before
# dependency graphs, it needs no sorting, and it is what turns a circular
# reference into a cell marked CIRC instead of an infinite loop. Each pass
# starts with WAIT 1, which both keeps the panel alive and resets the
# interpreter's runaway-loop guard.

# Tab5 shows all twenty rows at once and gives each cell room for eleven characters.
CANVAS 84 34

# 6 columns (A-F) x 20 rows, addressed as row * 6 + column
DIM ctype 120
DIM cval 120
DIM clen 120
DIM cbad 120
DIM ctext 2880
# the parser's two stacks
DIM nstk 32
DIM ostk 32

COLOR green
PUT 32 5 "S H E E T"
COLOR white
PUT 18 9 "ARROWS move       ENTER edits a cell"
PUT 18 11 "= starts a formula, digits a number"
PUT 18 13 "D clears     S saves     L loads"
PUT 18 15 "X twice wipes the sheet"
COLOR cyan
PUT 18 19 "=SUM(A1:A9)*2 and friends work"
FLIP
WAIT 1800

SET curcol 0
SET currow 0
SET top 0
SET quit 0
SET editing 0
SET confirm 0
SETSTR msg "sheet ready"
GOSUB draw

# the key handler asks for the editor by setting a flag rather than
# jumping into it: it is itself inside a GOSUB, and leaving a routine any
# way other than RETURN strands the return address on the call stack
:loop
KEY k
IF $k = 0 GOTO lp_wait
SET wantedit 0
GOSUB handlekey
IF $quit = 1 GOTO leave
IF $wantedit = 1 GOSUB editcell
GOSUB draw
:lp_wait
WAIT 16
GOTO loop

# ---------------------------------------------------------------- input

:handlekey
IF $k = 120 GOTO hk_wipe
IF $k = 88 GOTO hk_wipe
SET confirm 0
SETSTR msg ""
IF $k = $kesc GOTO hk_quit
IF $k = $kleft GOTO hk_left
IF $k = $kright GOTO hk_right
IF $k = $kup GOTO hk_up
IF $k = $kdown GOTO hk_down
IF $k = $ktab GOTO hk_right
IF $k = $kenter GOTO hk_edit
IF $k = $kback GOTO hk_clear
IF $k = 100 GOTO hk_clear
IF $k = 68 GOTO hk_clear
IF $k = 115 GOTO hk_save
IF $k = 83 GOTO hk_save
IF $k = 108 GOTO hk_load
IF $k = 76 GOTO hk_load
IF $k = 61 GOTO hk_type
IF $k = 45 GOTO hk_type
IF $k < 48 GOTO hk_none
IF $k > 57 GOTO hk_none
GOTO hk_type
:hk_none
RETURN

:hk_quit
SET quit 1
RETURN

:hk_left
IF $curcol <= 0 GOTO hk_none
SUB curcol 1
RETURN
:hk_right
IF $curcol >= 5 GOTO hk_none
ADD curcol 1
RETURN
:hk_up
IF $currow <= 0 GOTO hk_none
SUB currow 1
GOTO hk_scroll
:hk_down
IF $currow >= 19 GOTO hk_none
ADD currow 1

# All twenty rows fit on Tab5, so navigation never needs to move a viewport.
:hk_scroll
RETURN
:hk_scroll_up
RETURN
:hk_scroll_down
RETURN

# enter opens the cell with what is already in it; a digit, - or = starts
# a fresh entry with that character, the way a spreadsheet should
:hk_edit
EXPR idx $currow * 6 + $curcol
GOSUB getcelltext
SETSTR buf $t
SET wantedit 1
RETURN

:hk_type
CHR one $k
SETSTR buf $one
SET wantedit 1
RETURN

:hk_clear
EXPR idx $currow * 6 + $curcol
SET ctype[$idx] 0
SET cval[$idx] 0
SET clen[$idx] 0
SET cbad[$idx] 0
GOSUB recalc
SETSTR msg "cleared"
RETURN

:hk_save
GOSUB savesheet
RETURN

:hk_load
GOSUB loadsheet
RETURN

# wiping is two presses of x rather than a yes/no prompt: the confirmation
# is the only state this app keeps between keystrokes
:hk_wipe
IF $confirm = 1 GOTO hk_wipe_go
SET confirm 1
SETSTR msg "press x again to wipe the sheet"
RETURN
:hk_wipe_go
SET confirm 0
GOSUB wipe
SETSTR msg "sheet wiped"
RETURN

# ---------------------------------------------------------------- editing

# a line editor inside the canvas: KEY gives printable characters as their
# ASCII codes, so CHR and APPEND are the whole of it
:editcell
SET editing 1
:ed_draw
GOSUB draw
:ed_key
KEY k
IF $k = 0 GOTO ed_wait
IF $k = $kenter GOTO ed_commit
IF $k = $kesc GOTO ed_cancel
IF $k = $kback GOTO ed_back
IF $k < 32 GOTO ed_key
IF $k > 126 GOTO ed_key
LEN blen $buf
IF $blen >= 24 GOTO ed_key
CHR one $k
APPEND buf $one
GOTO ed_draw
:ed_back
LEN blen $buf
IF $blen = 0 GOTO ed_draw
SUB blen 1
SUBSTR buf $buf 0 $blen
GOTO ed_draw
:ed_wait
WAIT 16
GOTO ed_key

:ed_commit
SET editing 0
EXPR idx $currow * 6 + $curcol
GOSUB storecell
GOSUB recalc
RETURN

:ed_cancel
SET editing 0
SETSTR msg "cancelled"
RETURN

# in: idx, buf -- classifies an entry and files it in the cell
:storecell
LEN blen $buf
IF $blen = 0 GOTO sc_empty
SETSTR t $buf
GOSUB setcelltext
SET cbad[$idx] 0
CHARAT v $buf 0
IF $v = 61 GOTO sc_formula
GOSUB parsenumber
IF $got = 0 GOTO sc_label
SET ctype[$idx] 1
SET cval[$idx] $num
RETURN
:sc_label
SET ctype[$idx] 2
SET cval[$idx] 0
RETURN
:sc_formula
SET ctype[$idx] 3
RETURN
:sc_empty
SET ctype[$idx] 0
SET cval[$idx] 0
SET clen[$idx] 0
SET cbad[$idx] 0
RETURN

# in: buf -- out: num, and got=1 when the whole entry was an integer
:parsenumber
SET num 0
SET sign 1
SET got 0
SET pi 0
LEN plen $buf
IF $plen = 0 GOTO pn_done
CHARAT pc $buf 0
IF $pc <> 45 GOTO pn_scan
SET sign -1
SET pi 1
IF $plen = 1 GOTO pn_done
:pn_scan
SET got 1
:pn_loop
IF $pi >= $plen GOTO pn_end
CHARAT pc $buf $pi
IF $pc < 48 GOTO pn_bad
IF $pc > 57 GOTO pn_bad
SUB pc 48
MUL num 10
ADD num $pc
ADD pi 1
GOTO pn_loop
:pn_bad
SET got 0
GOTO pn_done
:pn_end
MUL num $sign
:pn_done
RETURN

# ---------------------------------------------------------------- cell text

# in: idx, t -- 24 character codes per cell, packed end to end
:setcelltext
LEN tlen $t
IF $tlen <= 24 GOTO st_fit
SET tlen 24
:st_fit
SET clen[$idx] $tlen
EXPR base $idx * 24
SET ti 0
:st_ch
IF $ti >= $tlen GOTO st_done
CHARAT tc $t $ti
EXPR v $base + $ti
SET ctext[$v] $tc
ADD ti 1
GOTO st_ch
:st_done
RETURN

# in: idx -- out: t
:getcelltext
SETSTR t ""
SET tlen $clen[$idx]
EXPR base $idx * 24
SET ti 0
:gt_ch
IF $ti >= $tlen GOTO gt_done
EXPR v $base + $ti
CHR one $ctext[$v]
APPEND t $one
ADD ti 1
GOTO gt_ch
:gt_done
RETURN

:wipe
SET ci 0
:wp_cell
SET ctype[$ci] 0
SET cval[$ci] 0
SET clen[$ci] 0
SET cbad[$ci] 0
ADD ci 1
IF $ci < 120 GOTO wp_cell
RETURN

# ---------------------------------------------------------------- recalc

# every formula, over and over, until nothing moves. A value still moving
# on the last pass is part of a cycle and is marked CIRC.
:recalc
SET pass 0
:rc_pass
WAIT 1
SET changed 0
SET ci 0
:rc_cell
IF $ctype[$ci] <> 3 GOTO rc_next
SET idx $ci
GOSUB getcelltext
SUBSTR f $t 1 24
GOSUB evalf
IF $perr = 1 GOTO rc_err
IF $pres = $cval[$ci] GOTO rc_ok
SET cval[$ci] $pres
SET changed 1
IF $pass >= 7 GOTO rc_circ
:rc_ok
SET cbad[$ci] 0
GOTO rc_next
:rc_circ
SET cbad[$ci] 2
GOTO rc_next
:rc_err
SET cval[$ci] 0
SET cbad[$ci] 1
:rc_next
ADD ci 1
IF $ci < 120 GOTO rc_cell
ADD pass 1
IF $changed = 0 GOTO rc_done
IF $pass < 8 GOTO rc_pass
:rc_done
RETURN

# ---------------------------------------------------------------- formulas

# in: f (the text after '=')   out: pres, perr
#
# Shunting-yard: operands are pushed, and an incoming operator first
# applies everything already stacked that binds at least as tightly.
# `expect` says whether the next token should be a value or an operator,
# which is what tells a leading '-' (negate) from a subtracting one.
:evalf
SET perr 0
SET pres 0
SET nsp 0
SET osp 0
SET pi 0
SET expect 1
LEN plen $f

:ev_next
IF $pi >= $plen GOTO ev_end
CHARAT pc $f $pi
IF $pc = 32 GOTO ev_space
IF $expect = 0 GOTO ev_op

# --- a value is expected here
IF $pc = 40 GOTO ev_lparen
IF $pc = 45 GOTO ev_neg
IF $pc = 43 GOTO ev_space
IF $pc < 48 GOTO ev_bad
IF $pc <= 57 GOTO ev_number
GOSUB upperc
IF $pc < 65 GOTO ev_bad
IF $pc > 90 GOTO ev_bad
GOTO ev_name

:ev_space
ADD pi 1
GOTO ev_next

:ev_lparen
SET op 8
GOSUB pushop
ADD pi 1
GOTO ev_next

:ev_neg
SET op 7
GOSUB pushop
ADD pi 1
GOTO ev_next

:ev_number
SET num 0
:ev_digit
CHARAT pc $f $pi
IF $pc < 48 GOTO ev_numdone
IF $pc > 57 GOTO ev_numdone
SUB pc 48
MUL num 10
ADD num $pc
ADD pi 1
IF $pi < $plen GOTO ev_digit
:ev_numdone
SET pval $num
GOSUB pushnum
SET expect 0
GOTO ev_next

# a name is either a function call, if a '(' follows it, or a cell
# reference, in which case the scan rewinds and readref does it properly
:ev_name
SET nstart $pi
SETSTR ident ""
:ev_nch
CHARAT pc $f $pi
GOSUB upperc
IF $pc < 65 GOTO ev_named
IF $pc > 90 GOTO ev_named
CHR one $pc
APPEND ident $one
ADD pi 1
IF $pi < $plen GOTO ev_nch
:ev_named
IF $pi >= $plen GOTO ev_cellref
CHARAT pc $f $pi
IF $pc = 40 GOTO ev_func
:ev_cellref
SET pi $nstart
GOSUB readref
IF $perr = 1 GOTO ev_stop
GOSUB cellvalue
GOSUB pushnum
SET expect 0
GOTO ev_next

:ev_func
ADD pi 1
GOSUB readref
IF $perr = 1 GOTO ev_stop
SET sc $pcol
SET sr $prow
SET ec $pcol
SET er $prow
IF $pi >= $plen GOTO ev_bad
CHARAT pc $f $pi
IF $pc <> 58 GOTO ev_fclose
ADD pi 1
GOSUB readref
IF $perr = 1 GOTO ev_stop
SET ec $pcol
SET er $prow
:ev_fclose
IF $pi >= $plen GOTO ev_bad
CHARAT pc $f $pi
IF $pc <> 41 GOTO ev_bad
ADD pi 1
GOSUB rangefunc
IF $perr = 1 GOTO ev_stop
GOSUB pushnum
SET expect 0
GOTO ev_next

# --- an operator is expected here
:ev_op
IF $pc = 41 GOTO ev_rparen
SET op 0
IF $pc = 43 GOTO ev_add
IF $pc = 45 GOTO ev_sub
IF $pc = 42 GOTO ev_mul
IF $pc = 47 GOTO ev_div
IF $pc = 37 GOTO ev_mod
IF $pc = 94 GOTO ev_pow
GOTO ev_bad
:ev_add
SET op 1
GOTO ev_push
:ev_sub
SET op 2
GOTO ev_push
:ev_mul
SET op 3
GOTO ev_push
:ev_div
SET op 4
GOTO ev_push
:ev_mod
SET op 5
GOTO ev_push
:ev_pow
SET op 6

:ev_push
SET pop $op
GOSUB precof
SET myprec $prec
:ev_pop
IF $osp = 0 GOTO ev_pushed
SUB osp 1
SET pop $ostk[$osp]
ADD osp 1
IF $pop = 8 GOTO ev_pushed
GOSUB precof
IF $prec < $myprec GOTO ev_pushed
IF $prec > $myprec GOTO ev_apply
IF $op = 6 GOTO ev_pushed
:ev_apply
GOSUB apply
IF $perr = 1 GOTO ev_stop
GOTO ev_pop
:ev_pushed
GOSUB pushop
ADD pi 1
SET expect 1
GOTO ev_next

:ev_rparen
IF $osp = 0 GOTO ev_bad
SUB osp 1
SET pop $ostk[$osp]
ADD osp 1
IF $pop = 8 GOTO ev_rclose
GOSUB apply
IF $perr = 1 GOTO ev_stop
GOTO ev_rparen
:ev_rclose
SUB osp 1
ADD pi 1
SET expect 0
GOTO ev_next

:ev_end
IF $expect = 1 GOTO ev_bad
:ev_flush
IF $osp = 0 GOTO ev_result
SUB osp 1
SET pop $ostk[$osp]
ADD osp 1
IF $pop = 8 GOTO ev_bad
GOSUB apply
IF $perr = 1 GOTO ev_stop
GOTO ev_flush
:ev_result
IF $nsp <> 1 GOTO ev_bad
SET pres $nstk[0]
RETURN
:ev_bad
SET perr 1
:ev_stop
SET pres 0
RETURN

# operator codes: 1 + 2 - 3 * 4 / 5 % 6 ^ 7 negate 8 (
:precof
SET prec 0
IF $pop = 8 GOTO pr_done
SET prec 1
IF $pop <= 2 GOTO pr_done
SET prec 2
IF $pop <= 5 GOTO pr_done
SET prec 3
IF $pop = 6 GOTO pr_done
SET prec 4
:pr_done
RETURN

:apply
IF $osp = 0 GOTO ap_bad
SUB osp 1
SET pop $ostk[$osp]
IF $pop = 7 GOTO ap_negate
IF $nsp < 2 GOTO ap_bad
SUB nsp 1
SET b $nstk[$nsp]
SUB nsp 1
SET a $nstk[$nsp]
IF $pop = 1 GOTO ap_add
IF $pop = 2 GOTO ap_sub
IF $pop = 3 GOTO ap_mul
IF $pop = 4 GOTO ap_div
IF $pop = 5 GOTO ap_mod
IF $pop = 6 GOTO ap_pow
GOTO ap_bad
:ap_add
EXPR res $a + $b
GOTO ap_push
:ap_sub
EXPR res $a - $b
GOTO ap_push
:ap_mul
EXPR res $a * $b
GOTO ap_push
:ap_div
IF $b = 0 GOTO ap_bad
EXPR res $a / $b
GOTO ap_push
:ap_mod
IF $b = 0 GOTO ap_bad
EXPR res $a % $b
GOTO ap_push
:ap_pow
IF $b < 0 GOTO ap_bad
IF $b > 16 GOTO ap_bad
EXPR res $a ^ $b
GOTO ap_push
:ap_negate
IF $nsp < 1 GOTO ap_bad
SUB nsp 1
EXPR res 0 - $nstk[$nsp]
:ap_push
SET nstk[$nsp] $res
ADD nsp 1
RETURN
:ap_bad
SET perr 1
RETURN

:pushnum
IF $nsp >= 32 GOTO pn_over
SET nstk[$nsp] $pval
ADD nsp 1
RETURN
:pn_over
SET perr 1
RETURN

:pushop
IF $osp >= 32 GOTO po_over
SET ostk[$osp] $op
ADD osp 1
RETURN
:po_over
SET perr 1
RETURN

# reads a reference such as B7 at pi -- out: pcol, prow
:readref
IF $pi >= $plen GOTO rr_bad
CHARAT pc $f $pi
GOSUB upperc
IF $pc < 65 GOTO rr_bad
IF $pc > 90 GOTO rr_bad
EXPR pcol $pc - 65
ADD pi 1
SET num 0
SET got 0
:rr_digit
IF $pi >= $plen GOTO rr_done
CHARAT pc $f $pi
IF $pc < 48 GOTO rr_done
IF $pc > 57 GOTO rr_done
SUB pc 48
MUL num 10
ADD num $pc
SET got 1
ADD pi 1
GOTO rr_digit
:rr_done
IF $got = 0 GOTO rr_bad
EXPR prow $num - 1
IF $pcol > 5 GOTO rr_bad
IF $prow < 0 GOTO rr_bad
IF $prow > 19 GOTO rr_bad
RETURN
:rr_bad
SET perr 1
RETURN

:cellvalue
EXPR v $prow * 6 + $pcol
SET pval $cval[$v]
RETURN

# SUM AVG MIN MAX COUNT over the rectangle sc,sr to ec,er. Empty cells and
# labels are skipped rather than counted as zero, so AVG of two filled
# cells in a ten-cell range is the average of the two.
#
# The scan walks cells in `rcell` and not in `ci`, which belongs to the
# recalculation loop that called this: sharing it made a range function
# write its answer into the last cell it had read.
:rangefunc
IF $sc <= $ec GOTO rf_rows
SET v $sc
SET sc $ec
SET ec $v
:rf_rows
IF $sr <= $er GOTO rf_scan
SET v $sr
SET sr $er
SET er $v
:rf_scan
SET acc 0
SET cnt 0
SET mn 0
SET mx 0
SET r $sr
:rf_row
SET c $sc
:rf_col
EXPR rcell $r * 6 + $c
SET ct $ctype[$rcell]
IF $ct = 0 GOTO rf_cnext
IF $ct = 2 GOTO rf_cnext
SET v $cval[$rcell]
ADD acc $v
IF $cnt > 0 GOTO rf_compare
SET mn $v
SET mx $v
GOTO rf_counted
:rf_compare
IF $v < $mn GOSUB rf_setmn
IF $v > $mx GOSUB rf_setmx
:rf_counted
ADD cnt 1
:rf_cnext
ADD c 1
IF $c <= $ec GOTO rf_col
ADD r 1
IF $r <= $er GOTO rf_row

IFEQ $ident "SUM" GOTO rf_sum
IFEQ $ident "COUNT" GOTO rf_count
IFEQ $ident "AVG" GOTO rf_avg
IFEQ $ident "MIN" GOTO rf_min
IFEQ $ident "MAX" GOTO rf_max
SET perr 1
RETURN
:rf_sum
SET pval $acc
RETURN
:rf_count
SET pval $cnt
RETURN
:rf_avg
SET pval 0
IF $cnt = 0 GOTO rf_ret
EXPR pval $acc / $cnt
RETURN
:rf_min
SET pval $mn
RETURN
:rf_max
SET pval $mx
:rf_ret
RETURN
:rf_setmn
SET mn $v
RETURN
:rf_setmx
SET mx $v
RETURN

:upperc
IF $pc < 97 GOTO uc_done
IF $pc > 122 GOTO uc_done
SUB pc 32
:uc_done
RETURN

# ---------------------------------------------------------------- drawing

:draw
CLS
COLOR green
PUT 0 0 "SHEET"
SET r $currow
SET c $curcol
GOSUB refof
COLOR yellow
PUT 6 0 $ref
EXPR idx $currow * 6 + $curcol
GOSUB getcelltext
COLOR white
PUT 10 0 $t

COLOR cyan
SET c 0
:dr_head
EXPR dx 3 + $c * 13 + 6
EXPR pc 65 + $c
CHR one $pc
COLOR cyan
IF $c = $curcol GOSUB hilite
PUT $dx 1 $one
ADD c 1
IF $c < 6 GOTO dr_head

SET r 0
:dr_row
EXPR rr $top + $r
IF $rr > 19 GOTO dr_done
EXPR dy $r + 2
COLOR cyan
IF $rr = $currow GOSUB hilite
EXPR rn $rr + 1
GOSUB rowlabel
PUT 0 $dy $p2
SET c 0
:dr_cell
EXPR ci $rr * 6 + $c
GOSUB cellstr
GOSUB cellcolour
EXPR dx 3 + $c * 13
IF $align = 0 GOTO dr_put
EXPR dx $dx + 11 - $blen
:dr_put
PUT $dx $dy $cs
ADD c 1
IF $c < 6 GOTO dr_cell
ADD r 1
IF $r < 20 GOTO dr_row

:dr_done
COLOR green
PUT 0 29 $msg
IF $editing = 1 GOTO dr_edit
COLOR yellow
PUT 0 32 "ENTER edit   D delete   S save   L load   X wipe   ESC quit"
FLIP
RETURN

:dr_edit
SET r $currow
SET c $curcol
GOSUB refof
COLOR yellow
PUT 0 32 $ref
COLOR white
SETSTR cs $buf
APPEND cs "_"
PUT 5 32 $cs
FLIP
RETURN

:hilite
COLOR yellow
RETURN

# in: ci -- out: cs (up to 11 characters), blen, align (1 = right)
:cellstr
SET ct $ctype[$ci]
SETSTR cs ""
SET align 0
SET blen 0
IF $ct = 0 GOTO cs_done
IF $ct = 2 GOTO cs_label
IF $ct = 3 GOTO cs_formula
:cs_number
SETSTR cs $cval[$ci]
SET align 1
GOTO cs_measure
:cs_formula
SET align 1
IF $cbad[$ci] = 1 GOTO cs_err
IF $cbad[$ci] = 2 GOTO cs_circ
GOTO cs_number
:cs_err
SETSTR cs "ERR"
GOTO cs_measure
:cs_circ
SETSTR cs "CIRC"
GOTO cs_measure
:cs_label
SET idx $ci
GOSUB getcelltext
SUBSTR cs $t 0 11
:cs_measure
LEN blen $cs
IF $blen <= 11 GOTO cs_done
SETSTR cs "###########"
SET blen 11
:cs_done
RETURN

# numbers white, labels cyan, formulas green, broken formulas red, and
# whatever the cursor is on yellow
:cellcolour
COLOR white
IF $ct = 2 GOTO cc_label
IF $ct = 3 GOTO cc_formula
GOTO cc_cursor
:cc_label
COLOR cyan
GOTO cc_cursor
:cc_formula
COLOR green
IF $cbad[$ci] = 0 GOTO cc_cursor
COLOR red
:cc_cursor
IF $rr <> $currow GOTO cc_done
IF $c <> $curcol GOTO cc_done
COLOR yellow
:cc_done
RETURN

# in: r, c -- out: ref, the name of that cell
:refof
EXPR pc 65 + $c
CHR ref $pc
EXPR rn $r + 1
APPEND ref $rn
RETURN

# in: rn -- out: p2, the row number right-aligned in two characters
:rowlabel
SETSTR p2 ""
IF $rn >= 10 GOTO rl_wide
SETSTR p2 " "
:rl_wide
APPEND p2 $rn
RETURN

# ---------------------------------------------------------------- the file

# one line per non-empty cell, "B7=<what you typed>". Sparse, readable
# with cat, and editable with edit -- the first '=' separates the two, so
# a formula's own '=' survives the round trip.
:savesheet
FOPEN "/apps/sheet.dat" write
IF $fok = 0 GOTO sv_failed
SET ci 0
:sv_cell
IF $ctype[$ci] = 0 GOTO sv_next
SET idx $ci
GOSUB getcelltext
EXPR r floor($ci / 6)
EXPR c $ci - $r * 6
GOSUB refof
SETSTR line $ref
APPEND line "="
APPEND line $t
FWRITE $line
:sv_next
ADD ci 1
IF $ci < 120 GOTO sv_cell
FCLOSE
SETSTR msg "saved /apps/sheet.dat"
RETURN
:sv_failed
SETSTR msg "could not write /apps/sheet.dat"
RETURN

:loadsheet
FEXISTS got "/apps/sheet.dat"
IF $got = 0 GOTO ld_missing
FOPEN "/apps/sheet.dat" read
IF $fok = 0 GOTO ld_missing
GOSUB wipe
:ld_line
FREAD line
IF $feof = 1 GOTO ld_close
LEN plen $line
IF $plen < 3 GOTO ld_line
CHARAT pc $line 0
GOSUB upperc
EXPR c $pc - 65
IF $c < 0 GOTO ld_line
IF $c > 5 GOTO ld_line
SET num 0
SET pi 1
:ld_digit
CHARAT pc $line $pi
IF $pc < 48 GOTO ld_split
IF $pc > 57 GOTO ld_split
SUB pc 48
MUL num 10
ADD num $pc
ADD pi 1
IF $pi < $plen GOTO ld_digit
:ld_split
IF $pc <> 61 GOTO ld_line
EXPR r $num - 1
IF $r < 0 GOTO ld_line
IF $r > 19 GOTO ld_line
ADD pi 1
EXPR blen $plen - $pi
SUBSTR buf $line $pi $blen
EXPR idx $r * 6 + $c
GOSUB storecell
GOTO ld_line
:ld_close
FCLOSE
GOSUB recalc
SETSTR msg "loaded /apps/sheet.dat"
RETURN
:ld_missing
SETSTR msg "no /apps/sheet.dat to load"
RETURN

:leave
ENDCANVAS
COLOR green
PRINT "sheet: left at $ref - s saves to /apps/sheet.dat"
EXIT
