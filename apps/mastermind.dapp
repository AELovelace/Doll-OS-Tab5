# @dapp-format 1
# @id mastermind
# @name Mastermind
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.1.0 <2.0.0
# @summary A colorful four-code deduction game with ten guesses for DS
# /apps/mastermind.dapp
# Guess four digits from 1-6. Enter submits, backspace edits, n starts over,
# escape quits. Exact means right digit/right place; near means right digit.

CANVAS 100 36
DIM secret 4
DIM current 4
DIM history 40
DIM exacts 10
DIM nears 10
DIM scount 7
DIM gcount 7
SET quit 0
GOSUB newgame
GOSUB draw

:loop
KEY k
IF $k = 0 GOTO idle
GOSUB handlekey
IF $quit = 1 GOTO leave
GOSUB draw
:idle
WAIT 18
GOTO loop

:handlekey
IF $k = $kesc GOTO hkquit
IF $k = 110 GOTO hknew
IF $k = 78 GOTO hknew
IF $won = 1 GOTO hknone
IF $lost = 1 GOTO hknone
IF $k = $kback GOTO hkback
IF $k = $kenter GOTO hksubmit
IF $k < 49 GOTO hknone
IF $k > 54 GOTO hknone
IF $pos >= 4 GOTO hknone
EXPR value $k - 48
SET current[$pos] $value
ADD pos 1
SETSTR msg ""
RETURN
:hkback
IF $pos <= 0 GOTO hknone
SUB pos 1
SET current[$pos] 0
RETURN
:hksubmit
IF $pos < 4 GOTO incomplete
GOSUB scoreguess
GOSUB storeguess
IF $exact = 4 GOTO win
ADD turn 1
IF $turn >= 10 GOTO lose
SET pos 0
SET i 0
:clearcurrent
SET current[$i] 0
ADD i 1
IF $i < 4 GOTO clearcurrent
SETSTR msg "$exact exact, $near near"
RETURN
:incomplete
SETSTR msg "enter all four digits"
RETURN
:win
SET won 1
SETSTR msg "CODE CRACKED! press n for new"
RETURN
:lose
SET lost 1
SETSTR msg "out of guesses - press n for new"
RETURN
:hknew
GOSUB newgame
RETURN
:hkquit
SET quit 1
:hknone
RETURN

:newgame
SET i 0
:secretloop
RAND value 6
ADD value 1
SET secret[$i] $value
SET current[$i] 0
ADD i 1
IF $i < 4 GOTO secretloop
SET turn 0
SET pos 0
SET won 0
SET lost 0
SETSTR msg "type four digits from 1 to 6"
RETURN

:scoreguess
SET exact 0
SET near 0
SET i 0
:clearcounts
SET scount[$i] 0
SET gcount[$i] 0
ADD i 1
IF $i < 7 GOTO clearcounts
SET i 0
:scoreloop
IF $i >= 4 GOTO countnear
IF $current[$i] = $secret[$i] GOTO exactone
SET value $secret[$i]
SET old $scount[$value]
ADD old 1
SET scount[$value] $old
SET value $current[$i]
SET old $gcount[$value]
ADD old 1
SET gcount[$value] $old
GOTO scorenext
:exactone
ADD exact 1
:scorenext
ADD i 1
GOTO scoreloop
:countnear
SET value 1
:nearloop
IF $value > 6 GOTO scoredone
SET a $scount[$value]
SET b $gcount[$value]
IF $a < $b GOTO usea
ADD near $b
GOTO nearnext
:usea
ADD near $a
:nearnext
ADD value 1
GOTO nearloop
:scoredone
RETURN

:storeguess
EXPR base $turn * 4
SET i 0
:storeguessloop
EXPR idx $base + $i
SET history[$idx] $current[$i]
ADD i 1
IF $i < 4 GOTO storeguessloop
SET exacts[$turn] $exact
SET nears[$turn] $near
RETURN

:draw
CLS
COLOR pink
PUT 3 1 "M A S T E R M I N D"
COLOR white
PUT 3 3 "Crack the four-digit code (digits 1-6, repeats allowed)"
COLOR cyan
PUT 8 5 "GUESS" 
PUT 30 5 "EXACT" 
PUT 43 5 "NEAR"
SET r 0
:drawrows
IF $r >= $turn GOTO drawcurrent
EXPR base $r * 4
SETSTR line ""
SET i 0
:historychars
EXPR idx $base + $i
EXPR ascii $history[$idx] + 48
CHR one $ascii
APPEND line $one
APPEND line "  "
ADD i 1
IF $i < 4 GOTO historychars
EXPR y 7 + $r
COLOR white
PUT 8 $y "$line"
COLOR green
PUT 32 $y "$exacts[$r]"
COLOR yellow
PUT 45 $y "$nears[$r]"
ADD r 1
GOTO drawrows
:drawcurrent
IF $won = 1 GOTO reveal
IF $lost = 1 GOTO reveal
SETSTR line ""
SET i 0
:currentchars
IF $i >= 4 GOTO currentdone
IF $i >= $pos GOTO currentblank
EXPR ascii $current[$i] + 48
CHR one $ascii
APPEND line $one
APPEND line "  "
GOTO currentnext
:currentblank
APPEND line "_  "
:currentnext
ADD i 1
GOTO currentchars
:currentdone
EXPR y 7 + $turn
COLOR cyan
PUT 8 $y "$line"
GOTO drawfooter
:reveal
SETSTR line "CODE: "
SET i 0
:revealchars
EXPR ascii $secret[$i] + 48
CHR one $ascii
APPEND line $one
APPEND line " "
ADD i 1
IF $i < 4 GOTO revealchars
COLOR pink
PUT 8 20 "$line"
:drawfooter
COLOR yellow
PUT 68 12 "$msg"
COLOR white
PUT 68 18 "ENTER       submit"
PUT 68 20 "BACKSPACE   edit"
PUT 68 22 "N           new game"
PUT 68 24 "ESC         quit"
FLIP
RETURN

:leave
ENDCANVAS
COLOR pink
PRINT "mastermind closed"
EXIT
