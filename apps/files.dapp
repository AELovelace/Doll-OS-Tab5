# @dapp-format 1
# @id files
# @name Files
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.7.0 <2.0.0
# @echo off
# @summary A wide Tab5 file desk for browsing, previewing and managing storage
# /system/apps/files.dapp
# FLIST snapshots a directory into /files.list as D|name|size rows. Files never
# receives a shell escape and deletion remains file-only/non-recursive.

SETSTR path "/"
SET page 0
SETSTR status "Ready"
CANVAS 100 40

:browse
CLS
FLIST $path "/files.list"
IF $fok = 0 GOTO listfail
COLOR pink
PUT 3 1 "FILES // $path"
COLOR cyan
PUT 3 3 "#   NAME"
PUT 76 3 "SIZE"
COLOR white
FOPEN "/files.list" read
IF $fok = 0 GOTO listfail
# Twenty-eight entries fit between the title and the persistent action footer.
EXPR skip $page * 28
SET index 0
:skiploop
IF $index >= $skip GOTO showloop
FREAD line
IF $feof = 1 GOTO empty
ADD index 1
GOTO skiploop
:showloop
SET shown 0
:showone
IF $shown >= 28 GOTO shownpage
FREAD line
IF $feof = 1 GOTO shownpage
ADD index 1
GOSUB parserow
EXPR listrow 5 + $shown
IFEQ $type "D" GOTO showdir
COLOR white
PUT 3 $listrow "$index  $name"
COLOR blue
PUT 76 $listrow "$size bytes"
GOTO shownnext
:showdir
COLOR cyan
PUT 3 $listrow "$index  [$name]"
:shownnext
ADD shown 1
GOTO showone
:shownpage
FCLOSE
EXPR pagedisp $page + 1
COLOR pink
PUT 3 34 "$status"
COLOR yellow
PUT 3 36 "PAGE $pagedisp     NUMBER open     U parent     N/P page     K mkdir"
COLOR white
PUT 3 38 "R refresh     Q quit     File actions: view / copy / move / delete"
FLIP
INPUT text "files> "
IFEQ $text "u" GOTO up
IFEQ $text "n" GOTO nextpage
IFEQ $text "p" GOTO prevpage
IFEQ $text "k" GOTO mkdir
IFEQ $text "r" GOTO browse
IFEQ $text "q" GOTO leave
GOSUB str2num
IF $got = 0 GOTO browse
SET wanted $num
IF $wanted < 1 GOTO browse
GOSUB select
IF $selected = 0 GOTO browse
IFEQ $type "D" GOTO enterdir
GOTO filemenu
:empty
FCLOSE
COLOR blue
PUT 3 6 "(empty directory)"
SET page 0
GOTO shownpage
:listfail
FCLOSE
COLOR red
PUT 3 6 "Cannot list $path"
COLOR yellow
PUT 3 36 "Press enter to return to the flash root"
FLIP
INPUT text "enter> "
SETSTR path "/"
SET page 0
SETSTR status "Returned to root after a listing error"
GOTO browse

:nextpage
IF $shown < 28 GOTO browse
ADD page 1
GOTO browse
:prevpage
SUB page 1
IF $page >= 0 GOTO browse
SET page 0
GOTO browse

:up
GOSUB parent
SET page 0
SETSTR status "Moved to parent directory"
GOTO browse
:enterdir
GOSUB join
SETSTR path $target
SET page 0
SETSTR status "Opened $name"
GOTO browse

:mkdir
INPUT name "directory name> "
LEN n $name
IF $n = 0 GOTO browse
GOSUB join
FMKDIR $target
IF $fok = 1 GOTO mkdirok
SETSTR status "Could not create $target"
GOTO browse
:mkdirok
SETSTR status "Created $target"
GOTO browse

:filemenu
CLS
COLOR pink
PUT 4 2 "$name"
COLOR white
PUT 4 5 "$size bytes"
PUT 4 7 "LOCATION  $path"
COLOR cyan
PUT 8 13 "O  VIEW TEXT"
PUT 8 17 "C  COPY"
PUT 52 13 "M  MOVE"
PUT 52 17 "D  DELETE"
COLOR yellow
PUT 8 25 "B or any unlisted command returns to the directory."
COLOR white
PUT 8 29 "Copy and move ask for a complete destination path in the command bar."
FLIP
INPUT text "file> "
IFEQ $text "o" GOTO view
IFEQ $text "c" GOTO copy
IFEQ $text "m" GOTO move
IFEQ $text "d" GOTO delete
GOTO browse

:sourcepath
GOSUB join
SETSTR source $target
RETURN

:copy
GOSUB sourcepath
INPUT destination "copy to full path> "
LEN n $destination
IF $n = 0 GOTO browse
FCOPY $source $destination
IF $fok = 1 GOTO copyok
SETSTR status "Copy failed"
GOTO browse
:copyok
SETSTR status "Copied $name to $destination"
GOTO browse

:move
GOSUB sourcepath
INPUT destination "move to full path> "
LEN n $destination
IF $n = 0 GOTO browse
FMOVE $source $destination
IF $fok = 1 GOTO moveok
SETSTR status "Move failed"
GOTO browse
:moveok
SETSTR status "Moved $name to $destination"
GOTO browse

:delete
GOSUB sourcepath
INPUT confirm "type DELETE> "
IFNE $confirm "DELETE" GOTO browse
FDELETE $source
IF $fok = 0 GOTO deletefail
SETSTR status "Deleted $name"
GOTO browse
:deletefail
SETSTR status "Delete failed"
GOTO browse

:view
GOSUB sourcepath
CLS
FOPEN $source read
IF $fok = 0 GOTO viewfail
SET lines 0
SET viewpage 1
:viewpage
CLS
COLOR pink
PUT 3 1 "TEXT PREVIEW // $name"
COLOR cyan
PUT 80 1 "PAGE $viewpage"
COLOR white
SET viewrow 5
:viewloop
FREAD line
IF $feof = 1 GOTO viewdone
PUT 3 $viewrow "$line"
ADD lines 1
ADD viewrow 1
IF $lines < 29 GOTO viewloop
SET lines 0
COLOR yellow
PUT 3 37 "ENTER next page     Q stop preview"
FLIP
INPUT text "preview> "
IFEQ $text "q" GOTO viewdone
IFEQ $text "Q" GOTO viewdone
ADD viewpage 1
GOTO viewpage
:viewdone
FCLOSE
COLOR yellow
PUT 3 37 "END OF FILE // press enter to return"
FLIP
INPUT text "preview> "
GOTO filemenu
:viewfail
FCLOSE
COLOR red
PUT 3 8 "Cannot open $source as text"
COLOR yellow
PUT 3 12 "Press enter to return"
FLIP
INPUT text "preview> "
GOTO filemenu

:select
SET selected 0
FOPEN "/files.list" read
IF $fok = 0 GOTO seldone
SET index 1
:selloop
FREAD line
IF $feof = 1 GOTO seldone
IF $index = $wanted GOTO selfound
ADD index 1
GOTO selloop
:selfound
GOSUB parserow
SET selected 1
:seldone
FCLOSE
RETURN

# line D|name|size -> type, name, size
:parserow
SUBSTR type $line 0 1
LEN linelen $line
SET i 2
:prscan
IF $i >= $linelen GOTO prbad
CHARAT ch $line $i
IF $ch = 124 GOTO prfound
ADD i 1
GOTO prscan
:prfound
EXPR count $i - 2
SUBSTR name $line 2 $count
ADD i 1
EXPR count $linelen - $i
SUBSTR size $line $i $count
RETURN
:prbad
SETSTR type "?"
SETSTR name $line
SETSTR size "0"
RETURN

# target = path/name
:join
IFEQ $path "/" GOTO joinroot
SETSTR target $path
APPEND target "/"
APPEND target $name
RETURN
:joinroot
SETSTR target "/"
APPEND target $name
RETURN

:parent
IFEQ $path "/" GOTO pardone
LEN n $path
SET i 0
SET last 0
:parscan
IF $i >= $n GOTO parcut
CHARAT ch $path $i
IF $ch <> 47 GOTO parnext
SET last $i
:parnext
ADD i 1
GOTO parscan
:parcut
IF $last > 0 GOTO parsub
SETSTR path "/"
RETURN
:parsub
SUBSTR path $path 0 $last
:pardone
RETURN

:str2num
SET num 0
SET got 0
SET i 0
LEN n $text
IF $n = 0 GOTO sn_done
SET got 1
:sn_loop
IF $i >= $n GOTO sn_done
CHARAT digit $text $i
IF $digit < 48 GOTO sn_bad
IF $digit > 57 GOTO sn_bad
SUB digit 48
MUL num 10
ADD num $digit
ADD i 1
GOTO sn_loop
:sn_bad
SET got 0
:sn_done
RETURN

:leave
FDELETE "/files.list"
ENDCANVAS
PRINT "files: done"
EXIT
