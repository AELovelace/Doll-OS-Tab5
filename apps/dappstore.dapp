# @dapp-format 1
# @id dappstore
# @name Dappstore
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.6.0 <2.0.0
# @echo off
# @summary A wide Tab5 front end for browsing and maintaining Dapper packages
# /system/apps/dappstore.dapp
#
# DAPPER remains the only installation path. This interface only collects choices,
# then returns to the terminal surface while Dapper prints verified operation details.

:menu
CANVAS 100 40
CLS
COLOR pink
PUT 3 1 "DAPPSTORE // TAB5 PACKAGE DESK"
COLOR white
PUT 3 3 "Choose an action in the command bar. Repository operations remain HTTPS + SHA-256 verified."

COLOR cyan
PUT 4 7 "1  BROWSE"
COLOR white
PUT 4 9 "All compatible packages"
COLOR cyan
PUT 4 13 "2  SEARCH"
COLOR white
PUT 4 15 "Find packages by keyword"
COLOR cyan
PUT 4 19 "3  DETAILS"
COLOR white
PUT 4 21 "Versions and installation state"
COLOR cyan
PUT 4 25 "4  INSTALL"
COLOR white
PUT 4 27 "Install to flash or SD"

COLOR yellow
PUT 53 7 "5  UPDATE"
COLOR white
PUT 53 9 "One package or everything"
COLOR yellow
PUT 53 13 "6  REMOVE"
COLOR white
PUT 53 15 "Keep the app's save data"
COLOR yellow
PUT 53 19 "7  REFRESH"
COLOR white
PUT 53 21 "Download the latest catalog"
COLOR yellow
PUT 53 25 "8  DOCTOR"
COLOR white
PUT 53 27 "Verify registry and hashes"

COLOR pink
PUT 4 34 "Q  RETURN TO DOLL-OS"
COLOR white
PUT 4 37 "The operation report opens in the terminal and returns here when acknowledged."
FLIP

INPUT choice "store> "
IFEQ $choice "1" GOTO browse
IFEQ $choice "2" GOTO search
IFEQ $choice "3" GOTO info
IFEQ $choice "4" GOTO install
IFEQ $choice "5" GOTO update
IFEQ $choice "6" GOTO remove
IFEQ $choice "7" GOTO refresh
IFEQ $choice "8" GOTO doctor
IFEQ $choice "q" GOTO leave
IFEQ $choice "Q" GOTO leave
GOTO menu

:browse
ENDCANVAS
CLEAR
COLOR cyan
PRINT "COMPATIBLE PACKAGES"
COLOR white
DAPPER search
GOSUB pause
GOTO menu

:search
ENDCANVAS
CLEAR
INPUT query "search> "
LEN n $query
IF $n = 0 GOTO menu
COLOR cyan
PRINT "RESULTS FOR: $query"
COLOR white
DAPPER search $query
GOSUB pause
GOTO menu

:info
ENDCANVAS
CLEAR
INPUT id "package id> "
LEN n $id
IF $n = 0 GOTO menu
DAPPER info $id
GOSUB pause
GOTO menu

:install
ENDCANVAS
CLEAR
COLOR cyan
PRINT "INSTALL PACKAGE"
COLOR white
INPUT id "package id> "
LEN n $id
IF $n = 0 GOTO menu
DAPPER info $id
PRINT ""
INPUT place "internal flash or SD [i/s]> "
INPUT confirm "type INSTALL to continue> "
IFNE $confirm "INSTALL" GOTO cancelled
IFEQ $place "s" GOTO installsd
IFEQ $place "S" GOTO installsd
IFEQ $place "sd" GOTO installsd
IFEQ $place "SD" GOTO installsd
DAPPER install $id --internal
GOSUB pause
GOTO menu
:installsd
DAPPER install $id --sd
GOSUB pause
GOTO menu

:update
ENDCANVAS
CLEAR
COLOR cyan
PRINT "UPDATE PACKAGES"
COLOR white
PRINT "Leave the ID empty to update every managed package."
INPUT id "package id> "
INPUT confirm "type UPDATE to continue> "
IFNE $confirm "UPDATE" GOTO cancelled
LEN n $id
IF $n = 0 GOTO updateall
DAPPER update $id
GOSUB pause
GOTO menu
:updateall
DAPPER update --all
GOSUB pause
GOTO menu

:remove
ENDCANVAS
CLEAR
COLOR yellow
PRINT "REMOVE PACKAGE"
COLOR white
PRINT "The app is removed; its save data is kept."
INPUT id "package id> "
LEN n $id
IF $n = 0 GOTO menu
DAPPER info $id
INPUT confirm "type REMOVE to continue> "
IFNE $confirm "REMOVE" GOTO cancelled
DAPPER remove $id
GOSUB pause
GOTO menu

:refresh
ENDCANVAS
CLEAR
COLOR cyan
PRINT "REFRESH CATALOG"
COLOR white
DAPPER refresh
GOSUB pause
GOTO menu

:doctor
ENDCANVAS
CLEAR
COLOR cyan
PRINT "VERIFY INSTALLED PACKAGES"
COLOR white
DAPPER doctor
GOSUB pause
GOTO menu

:cancelled
COLOR yellow
PRINT "cancelled"
GOSUB pause
GOTO menu

:pause
COLOR cyan
PRINT ""
INPUT waitkey "press enter> "
RETURN

:leave
ENDCANVAS
COLOR pink
PRINT "Dappstore closed"
EXIT
