# @dapp-format 1
# @id page
# @name Page
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.4.2 <2.0.0
# @echo off
# @summary A full-screen text pager with line jump and search
# /apps/page.dapp
# Pages any text file a screenful at a time. Space/down next page, up
# previous page, g jumps to a line number, / searches forward (wrapping
# once), n repeats the last search, f opens a different file, escape
# quits.
#
# FREAD is one-directional -- there is no seek, and no way to ask a file
# how many lines it has without reading all of them. So "page up" and
# "jump to line" are both the same operation: close the file, reopen it,
# and FREAD-and-discard lines from the top until the target line is
# reached. That sounds wasteful, but it only costs what it reads: paging
# up ten screens near the start of a file rereads a few hundred lines,
# which is nothing next to the step budget, and it is a great deal
# simpler and more obviously correct than keeping a partial cache with an
# eviction policy. Only the one screenful actually on display is ever
# held in memory, packed into `pagetext` the same way notes.dapp and
# sheet.dapp keep text in a numeric array.
#
# Search walks forward from the end of the current page rather than the
# top, so repeated searches move on instead of re-finding the same line,
# and it wraps at most once (tracked by `wrapped`), so a search with no
# match anywhere in the file terminates instead of looping forever.

CANVAS 100 40
SET pagesize 34
SET linewidth 94
DIM pagetext 3196
DIM pagelen 34

COLOR pink
PUT 40 5 "P A G E"
COLOR white
PUT 20 10 "SPACE/DOWN next page     UP previous page"
PUT 20 12 "G goes to a line         / searches, N repeats"
PUT 20 14 "F opens another file     ESC quits"
FLIP
WAIT 1600

SETSTR path "/docs/dapp.txt"
SETSTR lastneedle ""
SET quit 0
GOSUB openfile
IF $openok = 0 GOTO leave
GOSUB readpage
GOSUB draw

:loop
KEY k
IF $k = 0 GOTO lp_wait
IF $k = $kesc GOTO leave
IF $k = 113 GOTO leave
IF $k = $kspace GOTO hk_next
IF $k = $kdown GOTO hk_next
IF $k = 115 GOTO hk_next
IF $k = $kup GOTO hk_prev
IF $k = 119 GOTO hk_prev
IF $k = 103 GOTO hk_goto
IF $k = 71 GOTO hk_goto
IF $k = 47 GOTO hk_search
IF $k = 110 GOTO hk_repeat
IF $k = 102 GOTO hk_openother
IF $k = 70 GOTO hk_openother
GOTO lp_wait

:hk_next
IF $ateof = 1 GOTO lp_wait
SET topline $curline
GOSUB readpage
GOSUB draw
GOTO lp_wait

:hk_prev
EXPR target $topline - $pagesize
IF $target < 0 GOTO hk_prevclamp
GOTO hk_prevgo
:hk_prevclamp
SET target 0
:hk_prevgo
SET targetline $target
GOSUB gotoline
GOSUB readpage
GOSUB draw
GOTO lp_wait

:hk_goto
ENDCANVAS
COLOR white
INPUT gotext "line number> "
GOSUB str2num
CANVAS 100 40
IF $got = 0 GOTO lp_wait
EXPR target $num - 1
IF $target < 0 GOTO lp_wait
SET targetline $target
GOSUB gotoline
GOSUB readpage
GOSUB draw
GOTO lp_wait

:hk_search
ENDCANVAS
COLOR white
INPUT needle "/"
CANVAS 100 40
LEN needlelen $needle
IF $needlelen = 0 GOTO lp_wait
SETSTR lastneedle $needle
GOSUB dosearch
GOTO lp_wait

:hk_repeat
LEN needlelen $lastneedle
IF $needlelen = 0 GOTO lp_wait
SETSTR needle $lastneedle
GOSUB dosearch
GOTO lp_wait

:hk_openother
ENDCANVAS
COLOR white
INPUT newpath "path> "
CANVAS 100 40
LEN pl $newpath
IF $pl = 0 GOTO lp_wait
SETSTR path $newpath
GOSUB openfile
IF $openok = 0 GOTO lp_wait
GOSUB readpage
GOSUB draw

:lp_wait
WAIT 16
GOTO loop

# ---------------------------------------------------------------- searching

# starts right after the last displayed line, so repeated searches move
# forward instead of rediscovering the same match; wraps to the top
# exactly once
:dosearch
SET wrapped 0
SET scanline $curline
SET wrapstart $curline
:ds_loop
FREAD ln
IF $feof = 1 GOTO ds_eof
GOSUB linecontains
IF $found = 1 GOTO ds_found
ADD scanline 1
IF $wrapped = 0 GOTO ds_next
IF $scanline >= $wrapstart GOTO ds_notfound
:ds_next
EXPR wtest $scanline % 20
IF $wtest <> 0 GOTO ds_loop
WAIT 1
GOTO ds_loop

:ds_eof
IF $wrapped = 1 GOTO ds_notfound
SET wrapped 1
SET targetline 0
GOSUB gotoline
SET scanline 0
GOTO ds_loop

:ds_found
SET targetline $scanline
GOSUB gotoline
GOSUB readpage
GOSUB draw
RETURN

:ds_notfound
GOSUB draw
COLOR red
PUT 0 37 "not found: $needle"
FLIP
RETURN

# in: ln (string), needle (string) -- out: found
:linecontains
SET found 0
LEN clen $ln
LEN nlen $needle
IF $nlen = 0 GOTO lc_done
IF $nlen > $clen GOTO lc_done
EXPR lastart $clen - $nlen
SET lci 0
:lc_try
IF $lci > $lastart GOTO lc_done
SUBSTR chunk $ln $lci $nlen
IFEQ $chunk $needle GOTO lc_found
ADD lci 1
GOTO lc_try
:lc_found
SET found 1
:lc_done
RETURN

# ---------------------------------------------------------------- the file

:openfile
FEXISTS have $path
IF $have = 0 GOTO of_missing
FOPEN $path read
IF $fok = 0 GOTO of_missing
FCLOSE
SET targetline 0
GOSUB gotoline
SET openok 1
RETURN
:of_missing
CLS
COLOR red
PRINT "no such file: $path"
COLOR white
PRINT "f opens another file, esc quits"
SET openok 0
:om_wait
KEY k
IF $k = $kesc GOTO om_leave
IF $k = 102 GOTO om_retry
IF $k = 70 GOTO om_retry
WAIT 16
GOTO om_wait
:om_retry
INPUT newpath "path> "
LEN pl $newpath
IF $pl = 0 GOTO om_wait
SETSTR path $newpath
GOSUB openfile
GOTO om_done
:om_leave
SET quit 1
:om_done
RETURN

# in: targetline -- reopens $path from the top and discards lines until
# reaching it, since FREAD cannot seek backward. out: topline (the line
# actually reached, which is short of targetline if the file is shorter)
:gotoline
FCLOSE
FOPEN $path read
IF $fok = 0 GOTO gl_failed
SET gi 0
:gl_skip
IF $gi >= $targetline GOTO gl_done
FREAD dummy
IF $feof = 1 GOTO gl_done
ADD gi 1
EXPR wtest $gi % 40
IF $wtest <> 0 GOTO gl_skip
WAIT 1
GOTO gl_skip
:gl_done
SET topline $gi
RETURN
:gl_failed
SET topline 0
RETURN

# reads pagesize lines from wherever the file position currently is
:readpage
SET pagecount 0
SET ateof 0
:rp_loop
IF $pagecount >= $pagesize GOTO rp_done
FREAD ln
IF $feof = 1 GOTO rp_eof
SET idx $pagecount
GOSUB storeline
ADD pagecount 1
GOTO rp_loop
:rp_eof
SET ateof 1
:rp_done
EXPR curline $topline + $pagecount
RETURN

# in: idx, ln (string) -- packs one line into the page buffer, truncated
:storeline
LEN llen $ln
IF $llen <= $linewidth GOTO st_fit
SET llen $linewidth
:st_fit
SET pagelen[$idx] $llen
EXPR base $idx * $linewidth
SET si 0
:st_ch
IF $si >= $llen GOTO st_done
CHARAT sc $ln $si
EXPR v $base + $si
SET pagetext[$v] $sc
ADD si 1
GOTO st_ch
:st_done
RETURN

# in: idx -- out: ln (string), rebuilt from the page buffer
:getline
SETSTR ln ""
SET llen $pagelen[$idx]
EXPR base $idx * $linewidth
SET gi 0
:gt_ch
IF $gi >= $llen GOTO gt_done
EXPR v $base + $gi
CHR one $pagetext[$v]
APPEND ln $one
ADD gi 1
GOTO gt_ch
:gt_done
RETURN

# ---------------------------------------------------------------- drawing

:draw
CLS
COLOR pink
PUT 0 0 "PAGE"
COLOR white
PUT 6 0 $path

SET row 0
:dr_loop
IF $row >= $pagecount GOTO dr_done
SET idx $row
GOSUB getline
EXPR lineno $topline + $row + 1
EXPR disprow $row + 1
COLOR blue
PUT 0 $disprow $lineno
COLOR white
PUT 6 $disprow $ln
ADD row 1
GOTO dr_loop
:dr_done

EXPR lastline $topline + $pagecount
COLOR cyan
PUT 0 37 "lines"
COLOR white
EXPR firstshown $topline + 1
PUT 6 37 $firstshown
PUT 10 37 ".."
PUT 13 37 $lastline
IF $ateof = 0 GOTO dr_notend
COLOR yellow
PUT 20 37 "(end of file)"
:dr_notend

COLOR yellow
PUT 0 39 "SPACE next   UP previous   G goto   / find   N again   F open   ESC quit"
FLIP
RETURN

# ---------------------------------------------------------------- helpers

# in: gotext (string)   out: num, got=1 if it was a positive integer
:str2num
SET num 0
SET got 0
SET s2i 0
LEN s2len $gotext
IF $s2len = 0 GOTO s2n_done
SET got 1
:s2n_loop
IF $s2i >= $s2len GOTO s2n_done
CHARAT s2d $gotext $s2i
IF $s2d < 48 GOTO s2n_bad
IF $s2d > 57 GOTO s2n_bad
SUB s2d 48
MUL num 10
ADD num $s2d
ADD s2i 1
GOTO s2n_loop
:s2n_bad
SET got 0
:s2n_done
RETURN

:leave
IF $quit = 1 GOTO lv_plain
ENDCANVAS
:lv_plain
COLOR pink
PRINT "page: left at $path"
EXIT
