# @dapp-format 1
# @id calendar
# @name Calendar
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.4.2 <2.0.0
# @echo off
# @summary A wide Tab5 month calendar with persistent day reminders
# /apps/calendar.dapp
# DS month planner for years 2000-2099. Arrows move the selected day,
# a/d change month, n adds or replaces a reminder, x removes one,
# h returns to the startup date, escape quits. Reminders are stored in
# /apps/calendar.dat. The runtime has no clock API, so startup is explicit.

# The 84x36 Tab5 layout gives every weekday an eleven-column lane while leaving
# six calendar rows and a dedicated reminder panel visible together.
CANVAS 84 36
SET year 2026
SET month 7
SET day 31
SET homey 2026
SET homem 7
SET homed 31
SET quit 0
SET maxevents 32
SET textwidth 48
DIM ey 32
DIM em 32
DIM ed 32
DIM elen 32
DIM etext 1536
SETSTR msg "arrows move   a/d month   n reminder"
GOSUB load
GOSUB clampday
GOSUB draw

:loop
KEY k
IF $k = 0 GOTO idle
GOSUB handlekey
IF $quit = 1 GOTO leave
GOSUB draw
:idle
WAIT 18
GOTO loop

:handlekey
SETSTR msg ""
IF $k = $kesc GOTO hkquit
IF $k = $kleft GOTO prevday
IF $k = $kright GOTO nextday
IF $k = $kup GOTO prevweek
IF $k = $kdown GOTO nextweek
IF $k = 97 GOTO prevmonth
IF $k = 65 GOTO prevmonth
IF $k = 100 GOTO nextmonth
IF $k = 68 GOTO nextmonth
IF $k = 110 GOTO editreminder
IF $k = 78 GOTO editreminder
IF $k = 120 GOTO deletereminder
IF $k = 88 GOTO deletereminder
IF $k = 104 GOTO home
IF $k = 72 GOTO home
RETURN
:hkquit
SET quit 1
RETURN

:prevday
SUB day 1
IF $day >= 1 GOTO navdone
GOSUB monthback
GOSUB monthdays
SET day $days
GOTO navdone
:nextday
ADD day 1
GOSUB monthdays
IF $day <= $days GOTO navdone
SET day 1
GOSUB monthforward
GOTO navdone
:prevweek
SUB day 7
IF $day >= 1 GOTO navdone
GOSUB monthback
GOSUB monthdays
ADD day $days
GOTO navdone
:nextweek
ADD day 7
GOSUB monthdays
IF $day <= $days GOTO navdone
SUB day $days
GOSUB monthforward
GOTO navdone
:prevmonth
GOSUB monthback
GOSUB clampday
GOTO navdone
:nextmonth
GOSUB monthforward
GOSUB clampday
GOTO navdone
:home
SET year $homey
SET month $homem
SET day $homed
SETSTR msg "startup date"
:navdone
RETURN

:monthback
SUB month 1
IF $month >= 1 GOTO monthbackdone
SET month 12
SUB year 1
IF $year >= 2000 GOTO monthbackdone
SET year 2099
:monthbackdone
RETURN
:monthforward
ADD month 1
IF $month <= 12 GOTO monthforwarddone
SET month 1
ADD year 1
IF $year <= 2099 GOTO monthforwarddone
SET year 2000
:monthforwarddone
RETURN

:editreminder
GOSUB findevent
IF $found >= 0 GOTO editexisting
IF $count >= $maxevents GOTO eventfull
SET idx $count
SET ey[$idx] $year
SET em[$idx] $month
SET ed[$idx] $day
ADD count 1
GOTO editprompt
:editexisting
SET idx $found
:editprompt
ENDCANVAS
CLEAR
COLOR cyan
PRINT "REMINDER FOR $year-$month-$day"
COLOR white
INPUT line "text (blank cancels)> "
LEN n $line
IF $n = 0 GOTO editcancel
GOSUB storetext
GOSUB save
SETSTR msg "reminder saved"
CANVAS 84 36
RETURN
:editcancel
# If this was a newly reserved slot, release it again.
IF $found >= 0 GOTO editcancelview
SUB count 1
:editcancelview
SETSTR msg "cancelled"
CANVAS 84 36
RETURN
:eventfull
SETSTR msg "reminder list full (32)"
RETURN

:deletereminder
GOSUB findevent
IF $found < 0 GOTO nothingdelete
SET idx $found
:shiftloop
EXPR src $idx + 1
IF $src >= $count GOTO shiftdone
SET ey[$idx] $ey[$src]
SET em[$idx] $em[$src]
SET ed[$idx] $ed[$src]
SET elen[$idx] $elen[$src]
EXPR dstbase $idx * $textwidth
EXPR srcbase $src * $textwidth
SET j 0
:shiftchars
IF $j >= $textwidth GOTO shiftnext
EXPR dst $dstbase + $j
EXPR source $srcbase + $j
SET etext[$dst] $etext[$source]
ADD j 1
GOTO shiftchars
:shiftnext
SET idx $src
GOTO shiftloop
:shiftdone
SUB count 1
GOSUB save
SETSTR msg "reminder removed"
RETURN
:nothingdelete
SETSTR msg "no reminder on this day"
RETURN

:draw
CLS
GOSUB monthname
COLOR pink
PUT 2 1 "DOLL-OS TAB5 CALENDAR"
COLOR yellow
PUT 61 1 "$mname $year"
COLOR cyan
PUT 4 4 "SUN        MON        TUE        WED        THU        FRI        SAT"
GOSUB firstweekday
GOSUB monthdays
SET d 1
:drawdays
IF $d > $days GOTO drawselectedtext
EXPR cell $first + $d - 1
SET col $cell
MOD col 7
SET row $cell
DIV row 7
EXPR x 5 + $col * 11
EXPR y 7 + $row * 4
SET yearfind $year
SET monthfind $month
SET dayfind $d
GOSUB finddate
IF $d = $day GOTO dayselected
IF $found >= 0 GOTO dayevent
COLOR white
GOTO dayput
:dayevent
COLOR green
GOTO dayput
:dayselected
COLOR yellow
:dayput
PUT $x $y "$d"
IF $found < 0 GOTO daynext
EXPR starx $x + 3
PUT $starx $y "*"
:daynext
ADD d 1
GOTO drawdays

:drawselectedtext
COLOR cyan
PUT 2 30 "SELECTED  $year-$month-$day"
GOSUB findevent
IF $found < 0 GOTO shownone
SET idx $found
GOSUB fetchtext
COLOR green
PUT 2 32 "$line"
GOTO showhelp
:shownone
COLOR blue
PUT 2 32 "(no reminder for this day)"
:showhelp
COLOR white
PUT 1 35 "ARROWS day   A/D month   N note   X delete   H home   ESC quit"
IFNE $msg "" GOTO showmsg
FLIP
RETURN
:showmsg
COLOR pink
PUT 46 32 "$msg"
FLIP
RETURN

:monthname
IFEQ $month 1 GOTO jan
IFEQ $month 2 GOTO feb
IFEQ $month 3 GOTO mar
IFEQ $month 4 GOTO apr
IFEQ $month 5 GOTO may
IFEQ $month 6 GOTO jun
IFEQ $month 7 GOTO jul
IFEQ $month 8 GOTO aug
IFEQ $month 9 GOTO sep
IFEQ $month 10 GOTO oct
IFEQ $month 11 GOTO nov
SETSTR mname "December"
RETURN
:jan
SETSTR mname "January"
RETURN
:feb
SETSTR mname "February"
RETURN
:mar
SETSTR mname "March"
RETURN
:apr
SETSTR mname "April"
RETURN
:may
SETSTR mname "May"
RETURN
:jun
SETSTR mname "June"
RETURN
:jul
SETSTR mname "July"
RETURN
:aug
SETSTR mname "August"
RETURN
:sep
SETSTR mname "September"
RETURN
:oct
SETSTR mname "October"
RETURN
:nov
SETSTR mname "November"
RETURN

:monthdays
SET days 31
IF $month = 4 GOTO thirty
IF $month = 6 GOTO thirty
IF $month = 9 GOTO thirty
IF $month = 11 GOTO thirty
IF $month = 2 GOTO febdays
RETURN
:thirty
SET days 30
RETURN
:febdays
SET days 28
SET leap $year
MOD leap 400
IF $leap = 0 GOTO isleap
SET leap $year
MOD leap 100
IF $leap = 0 GOTO notleap
SET leap $year
MOD leap 4
IF $leap = 0 GOTO isleap
:notleap
RETURN
:isleap
SET days 29
RETURN

:clampday
GOSUB monthdays
IF $day <= $days GOTO clampdone
SET day $days
:clampdone
RETURN

# Jan 1 2000 was Saturday (6 when Sunday is 0).
:firstweekday
SET total 6
SET y 2000
:yearloop
IF $y >= $year GOTO monthloopstart
SET yd 365
SET leap $y
MOD leap 400
IF $leap = 0 GOTO yearleap
SET leap $y
MOD leap 100
IF $leap = 0 GOTO yearadd
SET leap $y
MOD leap 4
IF $leap <> 0 GOTO yearadd
:yearleap
SET yd 366
:yearadd
ADD total $yd
ADD y 1
GOTO yearloop
:monthloopstart
SET m 1
:monthloop
IF $m >= $month GOTO weekdaydone
SET oldmonth $month
SET month $m
GOSUB monthdays
SET month $oldmonth
ADD total $days
ADD m 1
GOTO monthloop
:weekdaydone
SET first $total
MOD first 7
RETURN

# Finds current selected date.
:findevent
SET yearfind $year
SET monthfind $month
SET dayfind $day
GOSUB finddate
RETURN

:finddate
SET found -1
SET i 0
:findloop
IF $i >= $count GOTO finddone
IF $ey[$i] <> $yearfind GOTO findnext
IF $em[$i] <> $monthfind GOTO findnext
IF $ed[$i] <> $dayfind GOTO findnext
SET found $i
RETURN
:findnext
ADD i 1
GOTO findloop
:finddone
RETURN

:storetext
LEN n $line
IF $n <= $textwidth GOTO storefit
SET n $textwidth
:storefit
SET elen[$idx] $n
EXPR base $idx * $textwidth
SET j 0
:storeloop
IF $j >= $n GOTO storedone
CHARAT code $line $j
EXPR cell $base + $j
SET etext[$cell] $code
ADD j 1
GOTO storeloop
:storedone
RETURN

:fetchtext
SETSTR line ""
SET n $elen[$idx]
EXPR base $idx * $textwidth
SET j 0
:fetchloop
IF $j >= $n GOTO fetchdone
EXPR cell $base + $j
CHR one $etext[$cell]
APPEND line $one
ADD j 1
GOTO fetchloop
:fetchdone
RETURN

:load
SET count 0
FEXISTS have "/apps/calendar.dat"
IF $have = 0 GOTO loaddone
FOPEN "/apps/calendar.dat" read
IF $fok = 0 GOTO loaddone
:loadloop
IF $count >= $maxevents GOTO loadclose
FREAD text
IF $feof = 1 GOTO loadclose
GOSUB str2num
SET idx $count
SET ey[$idx] $num
FREAD text
IF $feof = 1 GOTO loadclose
GOSUB str2num
SET em[$idx] $num
FREAD text
IF $feof = 1 GOTO loadclose
GOSUB str2num
SET ed[$idx] $num
FREAD line
IF $feof = 1 GOTO loadclose
GOSUB storetext
ADD count 1
GOTO loadloop
:loadclose
FCLOSE
:loaddone
RETURN

:save
FOPEN "/apps/calendar.dat" write
IF $fok = 0 GOTO savedone
SET idx 0
:saveloop
IF $idx >= $count GOTO saveclose
FWRITE "$ey[$idx]"
FWRITE "$em[$idx]"
FWRITE "$ed[$idx]"
GOSUB fetchtext
FWRITE $line
ADD idx 1
GOTO saveloop
:saveclose
FCLOSE
:savedone
RETURN

:str2num
SET num 0
SET i 0
LEN n $text
:numloop
IF $i >= $n GOTO numdone
CHARAT digit $text $i
IF $digit < 48 GOTO numdone
IF $digit > 57 GOTO numdone
SUB digit 48
MUL num 10
ADD num $digit
ADD i 1
GOTO numloop
:numdone
RETURN

:leave
ENDCANVAS
COLOR pink
PRINT "$count calendar reminder(s) saved"
EXIT
