# @dapp-format 1
# @id grotto2
# @name The Cursed Grotto II
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.4.2 <2.0.0
# @summary Descend the Abyssal Depths with an expanded Tab5 map and status view
# @echo off
# /sd/apps/grotto2.dapp
# The Cursed Grotto II: The Abyssal Depths
# A DOLL-OS .dapp adventure sequel, the canvas-and-sound follow-up to
# apps/adventure.dapp.

# ── Setup ──────────────────────────────────────────────────────

# Game state variables
SET gold 0
SET health 100
SET maxhp 100
SET potions 2
SET keys 0
SET zone 0
SET step 0
SET score 0
SET wyrmdefeated 0
SET treasuretaken 0

# Canvas map (10 cols x 6 rows = 60 cells)
DIM map 60
DIM vis 60

# Player position
SET px 5
SET py 0

# ── Title Screen ───────────────────────────────────────────────

:titlesound
WAVE 1 triangle 80 8
WAVE 2 sine 110 5
WAIT 300
WAVESTOP

# The old ten-column title clipped its own text; Tab5 gives the opening room to breathe.
CANVAS 80 30
CLS
COLOR cyan
PUT 24 7 "C U R S E D   G R O T T O"
COLOR pink
PUT 27 12 "II: THE ABYSSAL DEPTHS"
COLOR yellow
PUT 31 19 "[ ENTER ]  DESCEND"
FLIP

:waitstart
KEY k
IF $k = $kenter GOTO titledone
WAIT 50
GOTO waitstart

:titledone
WAVE 1 sine 440 30
WAIT 80
WAVE 1 sine 660 30
WAIT 80
WAVESTOP

ENDCANVAS
CLEAR

# ── Intro Story ────────────────────────────────────────────────

COLOR cyan
PRINT "The Cursed Grotto II"
PRINT "====================="
WAIT 400

COLOR white
PRINT ""
PRINT "Your escape from the Cursed"
PRINT "Grotto was legendary. But the"
PRINT "Crystal you found pulses with"
PRINT "a deep, urgent rhythm..."
WAIT 700

COLOR cyan
PRINT "It points downward. Deeper"
PRINT "than any grotto goes."
PRINT "The Abyssal Depths await."
WAIT 700

COLOR yellow
PRINT ""
PRINT "Press Enter when ready..."
INPUT dummy "> "

# ── Load High Score ────────────────────────────────────────────

SET hiscore 0
SETSTR hisname ""
FOPEN "/apps/grotto2.hs" read
IF $fok = 0 GOTO hsdone
FREAD hsline
IFEQ $feof 0 GOTO hsparsed
GOTO hsclose
:hsparsed
LEN hsl $hsline
IF $hsl < 2 GOTO loadname
CHARAT hscode $hsline 0
IF $hscode <> 35 GOTO loadname
SUBSTR hstxt $hsline 1 50
EXPR hiscore $hstxt
:loadname
:hsclose
FCLOSE
:hsdone

# ── Name Entry ─────────────────────────────────────────────────

COLOR pink
PRINT "What is your name, adventurer?"
INPUT player "Name> "

COLOR white
PRINT ""
PRINT "Welcome, $player!"
IF $hiscore > 0 GOTO showhs
COLOR green
PRINT "First time here! Best of luck."
WAIT 500
GOTO startgame

:showhs
COLOR yellow
PRINT "High score: $hiscore ($hisname)"
WAIT 500

:startgame
COLOR cyan
PRINT ""
PRINT "Descend into the depths..."
WAIT 400
LED 0 50 255

# ── Game Loop ──────────────────────────────────────────────────

:gameloop
GOSUB drawmap
CLEAR
GOSUB showstatus

COLOR white
PRINT ""
GOSUB zonename
GOSUB zoneevent
PRINT ""

# Movement menu
COLOR yellow
PRINT "Where to?"
PRINT "  W - North"
PRINT "  S - South"
PRINT "  A - West"
PRINT "  D - East"
PRINT "  I - Inventory"
PRINT "  H - Heal (potion)"

INPUT movecmd "Move> "

IFEQ $movecmd I GOTO inventory
IFEQ $movecmd H GOTO heal
IFEQ $movecmd w GOTO movenorth
IFEQ $movecmd W GOTO movenorth
IFEQ $movecmd s GOTO movesouth
IFEQ $movecmd S GOTO movesouth
IFEQ $movecmd a GOTO movewest
IFEQ $movecmd A GOTO movewest
IFEQ $movecmd d GOTO moveeast
IFEQ $movecmd D GOTO moveeast

COLOR magenta
PRINT "W, A, S, D, I, or H"
WAIT 300
GOTO gameloop

# ── Inventory ──────────────────────────────────────────────────

:inventory
CLEAR
COLOR cyan
PRINT "═══ Inventory ═══"
COLOR white
PRINT "  Gold:   $gold"
PRINT "  Health: $health/$maxhp"
PRINT "  Potions: $potions"
PRINT "  Keys:   $keys"
COLOR yellow
PRINT "  Zone:   $zone"
COLOR pink
PRINT "  Score:  $score"
WAIT 500
GOTO gameloop

# ── Heal ───────────────────────────────────────────────────────

:heal
IF $potions <= 0 GOTO nopotion
IF $health >= $maxhp GOTO fullhp
ADD potions -1
EXPR healamt 40
EXPR health $health + $healamt
IF $health <= $maxhp GOTO healcapdone
SET health $maxhp
:healcapdone
COLOR green
PRINT "* Used a potion! +"
PRINT "* Health: $health/$maxhp"
WAVE 1 sine 523 15
WAIT 100
WAVE 1 sine 659 15
WAIT 100
WAVESTOP
WAIT 300
GOTO gameloop

:nopotion
COLOR red
PRINT "No potions remaining!"
WAIT 300
GOTO gameloop

:fullhp
COLOR green
PRINT "Already at full health!"
WAIT 300
GOTO gameloop

# ── Movement ───────────────────────────────────────────────────

:movenorth
EXPR newy $py - 1
IF $newy < 0 GOTO blocked
SET py $newy
GOTO movedok

:movesouth
EXPR newy $py + 1
IF $newy >= 6 GOTO blocked
SET py $newy
GOTO movedok

:movewest
EXPR newx $px - 1
IF $newx < 0 GOTO blocked
SET px $newx
GOTO movedok

:moveeast
EXPR newx $px + 1
IF $newx >= 10 GOTO blocked
SET px $newx
GOTO movedok

:blocked
COLOR red
PRINT "A wall blocks the way!"
WAVE 1 noise 200 20
WAIT 100
WAVESTOP
WAIT 300
GOTO gameloop

:movedok
EXPR idx $py * 10 + $px
SET vis[$idx] 1
ADD step 1
ADD score 10

# Zone assignment based on position
GOSUB updatezone
GOSUB victory

# Random encounter chance
RAND encounter 1 10
IF $encounter >= 8 GOSUB randomencounter

GOTO gameloop

# ── Zone Names ─────────────────────────────────────────────────

:updatezone
IF $py = 0 GOTO zone_surface
IF $py = 1 GOTO zone_row1
IF $py = 2 GOTO zone_row2
IF $py = 3 GOTO zone_row3
IF $py = 4 GOTO zone_row4
IF $py = 5 GOTO zone_row5
SET zone 0
RETURN

:zone_surface
SET zone 0
RETURN

:zone_row1
IF $px < 5 GOTO zone_1
GOTO zone_2

:zone_row2
IF $px < 5 GOTO zone_3
GOTO zone_2

:zone_row3
IF $px < 5 GOTO zone_4
GOTO zone_5

:zone_row4
IF $px < 5 GOTO zone_6
GOTO zone_8

:zone_row5
IF $px < 3 GOTO zone_14
IF $px < 6 GOTO zone_10
GOTO zone_12

:zone_1
SET zone 1
RETURN

:zone_2
SET zone 2
RETURN

:zone_3
SET zone 3
RETURN

:zone_4
SET zone 4
RETURN

:zone_5
SET zone 5
RETURN

:zone_6
SET zone 6
RETURN

:zone_8
SET zone 8
RETURN

:zone_10
SET zone 10
RETURN

:zone_12
SET zone 12
RETURN

:zone_14
SET zone 14
RETURN

:zonename
IF $zone = 0 GOTO z0
IF $zone = 1 GOTO z1
IF $zone = 2 GOTO z2
IF $zone = 3 GOTO z3
IF $zone = 4 GOTO z4
IF $zone = 5 GOTO z5
IF $zone = 6 GOTO z6
IF $zone = 8 GOTO z8
IF $zone = 10 GOTO z10
IF $zone = 12 GOTO z12
IF $zone = 14 GOTO z14
RETURN

:z0
COLOR cyan
PRINT "╔══════════════════════╗"
COLOR white
PRINT "║  Surface Camp       ║"
COLOR cyan
PRINT "╚══════════════════════╝"
COLOR white
PRINT "Your base camp. Safe."
LED 0 200 0
RETURN

:z1
COLOR cyan
PRINT "╔══════════════════════╗"
COLOR white
PRINT "║  Whispering Halls   ║"
COLOR cyan
PRINT "╚══════════════════════╝"
COLOR white
PRINT "Echoes fill the air."
LED 100 0 100
RETURN

:z2
COLOR cyan
PRINT "╔══════════════════════╗"
COLOR white
PRINT "║  Crystal Lake       ║"
COLOR cyan
PRINT "╚══════════════════════╝"
COLOR white
PRINT "Bioluminescent waters glow."
LED 0 100 200
RETURN

:z3
COLOR cyan
PRINT "╔══════════════════════╗"
COLOR white
PRINT "║  Shadow Tunnel      ║"
COLOR cyan
PRINT "╚══════════════════════╝"
COLOR white
PRINT "Darkness clings to the walls."
LED 50 0 0
RETURN

:z4
COLOR cyan
PRINT "╔══════════════════════╗"
COLOR white
PRINT "║  Ancient Ruins      ║"
COLOR cyan
PRINT "╚══════════════════════╝"
COLOR white
PRINT "Carved stone from a lost age."
LED 200 200 0
RETURN

:z5
COLOR cyan
PRINT "╔══════════════════════╗"
COLOR white
PRINT "║  The Deep Caverns   ║"
COLOR cyan
PRINT "╚══════════════════════╝"
COLOR white
PRINT "The walls press in tight."
LED 0 50 0
RETURN

:z6
COLOR cyan
PRINT "╔══════════════════════╗"
COLOR red
PRINT "║  LAVA FLOWS AHEAD!  ║"
COLOR cyan
PRINT "╚══════════════════════╝"
COLOR red
PRINT "Intense heat radiates forward."
LED 255 50 0
RETURN

:z8
COLOR cyan
PRINT "╔══════════════════════╗"
COLOR red
PRINT "║  THE BOSS CHAMBER   ║"
COLOR cyan
PRINT "╚══════════════════════╝"
COLOR white
PRINT "A massive door stands before you."
LED 255 0 0
RETURN

:z10
COLOR cyan
PRINT "╔══════════════════════╗"
COLOR pink
PRINT "║  TREASURE VAULT!    ║"
COLOR cyan
PRINT "╚══════════════════════╝"
COLOR yellow
PRINT "Glittering riches everywhere!"
LED 255 215 0
RETURN

:z12
COLOR cyan
PRINT "╔══════════════════════╗"
COLOR green
PRINT "║  EXIT PATH          ║"
COLOR cyan
PRINT "╚══════════════════════╝"
COLOR white
PRINT "Fresh air calls from above!"
LED 0 255 0
RETURN

:z14
COLOR cyan
PRINT "╔══════════════════════╗"
COLOR white
PRINT "║  Crystal Garden     ║"
COLOR cyan
PRINT "╚══════════════════════╝"
COLOR white
PRINT "Beautiful crystal formations."
LED 0 255 255
RETURN

# ── Zone Events ────────────────────────────────────────────────

:zoneevent
IF $zone = 0 GOTO evt0
IF $zone = 2 GOTO evt2
IF $zone = 4 GOTO evt4
IF $zone = 8 GOTO evt8
IF $zone = 10 GOTO evt10
IF $zone = 12 GOTO evt12
RETURN

:evt0
COLOR white
PRINT "The campfire crackles warmly."
RAND campfind 1 5
IF $campfind >= 4 GOTO camppotion
RETURN

:camppotion
COLOR green
PRINT "You found a supply cache!"
PRINT "  +1 Potion"
ADD potions 1
WAVE 1 sine 880 20
WAIT 100
WAVESTOP
RETURN

:evt2
COLOR cyan
PRINT "The glowing water teems with"
PRINT "tiny fish. Peaceful..."
RAND lakefind 1 6
IF $lakefind >= 5 GOTO lakegold
RETURN

:lakegold
COLOR yellow
PRINT "Something glints under a rock!"
ADD gold 25
PRINT "  +25 Gold ($gold total)"
WAVE 1 sine 1200 15
WAIT 100
WAVESTOP
RETURN

:evt4
COLOR white
PRINT "Ancient runes line the walls."
RAND ruinsfind 1 6
IF $ruinsfind >= 4 GOTO ruinskey
IF $ruinsfind >= 2 GOTO ruinsgold
RETURN

:ruinskey
COLOR yellow
PRINT "A bronze key embedded in"
PRINT "the wall comes free!"
PRINT "  +1 Key"
ADD keys 1
WAVE 1 triangle 440 25
WAIT 150
WAVESTOP
RETURN

:ruinsgold
COLOR yellow
ADD gold 15
PRINT "  +15 Gold from a loose stone"
RETURN

:evt8
IF $wyrmdefeated = 1 GOTO evt8clear
COLOR red
PRINT "The BOSS awaits! The Shadow"
PRINT "Wyrm of the Abyss!"
PRINT ""
PRINT "  1. Fight the wyrm!"
PRINT "  2. Use a key to open"
PRINT "     the back passage"
INPUT bosscmd "> "
IFEQ $bosscmd 1 GOSUB fightwyrm
IFEQ $bosscmd 2 GOSUB usekeyboss
RETURN

:evt8clear
COLOR white
PRINT "The boss chamber lies silent."
PRINT "The path downward is open."
RETURN

:evt10
IF $treasuretaken = 1 GOTO evt10empty
COLOR yellow
PRINT "You gather treasure!"
ADD gold 50
ADD score 100
SET treasuretaken 1
COLOR yellow
PRINT "  +50 Gold! +100 Score!"
WAVE 1 sine 1000 25
WAIT 100
WAVE 1 sine 1500 25
WAIT 100
WAVESTOP
RETURN

:evt10empty
COLOR white
PRINT "The vault is picked clean."
RETURN

:evt12
COLOR green
PRINT "The exit grows closer!"
PRINT "Move East to escape!"
RETURN

# ── Boss Fight ─────────────────────────────────────────────────

:fightwyrm
CLEAR
COLOR red
PRINT "╔══════════════════════╗"
PRINT "║   SHADOW WYRM!       ║"
PRINT "╚══════════════════════╝"
WAIT 400

WAVE 1 noise 500 30
WAVE 2 square 150 25
WAIT 500

SET wyrmhp 80

:wyrmfight
COLOR white
PRINT "Wyrm HP: $wyrmhp"
PRINT "Your HP: $health"
PRINT ""
COLOR yellow
PRINT "  1. Attack!"
PRINT "  2. Potion & Defend"
INPUT atkcmd "> "

IFEQ $atkcmd 1 GOTO atkwyrma
IFEQ $atkcmd 2 GOTO atkwyrmb
GOTO wyrmfight

:atkwyrma
RAND pldmg 10 25
EXPR wyrmhp $wyrmhp - $pldmg
COLOR green
PRINT "You deal $pldmg damage!"
WAVE 1 noise 800 20
WAIT 80
WAVESTOP

IF $wyrmhp <= 0 GOTO wyrmdead

RAND enmdmg 8 20
EXPR health $health - $enmdmg
COLOR red
PRINT "Wyrm strikes for $enmdmg!"
WAVE 1 noise 300 25
WAIT 80
WAVESTOP

IF $health <= 0 GOTO gameover
GOTO wyrmfight

:atkwyrmb
IF $potions <= 0 GOTO nowyrmpotion
ADD potions -1
EXPR health $health + 30
IF $health <= $maxhp GOTO wyrmhealcapdone
SET health $maxhp
:wyrmhealcapdone
COLOR green
PRINT "Healed! HP: $health"
WAVE 1 sine 600 15
WAIT 80
WAVESTOP

RAND enmdmg 3 10
EXPR health $health - $enmdmg
COLOR red
PRINT "Wyrm grazes you for $enmdmg!"
WAVE 1 noise 300 20
WAIT 80
WAVESTOP

IF $health <= 0 GOTO gameover
GOTO wyrmfight

:nowyrmpotion
COLOR red
PRINT "No potions left!"
GOTO wyrmfight

:wyrmdead
WAVESTOP
WAVE 1 sine 523 20
WAIT 100
WAVE 1 sine 659 20
WAIT 100
WAVE 1 sine 784 20
WAIT 100
WAVESTOP

CLEAR
COLOR green
PRINT "╔══════════════════════╗"
PRINT "║   WYRM DEFEATED!     ║"
PRINT "╚══════════════════════╝"
WAIT 300

ADD gold 150
ADD score 200
COLOR yellow
PRINT "  +150 Gold! +200 Score!"
PRINT ""
COLOR white
PRINT "The path forward opens up!"
PRINT "Treasure awaits beyond..."
WAIT 700

# Move player to treasure zone
SET py 5
SET px 4
SET wyrmdefeated 1
GOSUB updatezone
RETURN

:usekeyboss
IF $keys <= 0 GOTO nokeyboss
ADD keys -1
COLOR green
PRINT "The key turns! A hidden"
PRINT "passage slides open!"
WAVE 1 triangle 330 20
WAIT 200
WAVESTOP
ADD score 50
PRINT "  +50 Score for cleverness!"
WAIT 500
SET py 5
SET px 4
SET wyrmdefeated 1
GOSUB updatezone
RETURN

:nokeyboss
COLOR red
PRINT "No keys available!"
WAIT 300
RETURN

# ── Random Encounters ──────────────────────────────────────────

:randomencounter
RAND enmtype 1 5
IFEQ $enmtype 1 GOTO encbat
IFEQ $enmtype 2 GOTO encspider
IFEQ $enmtype 3 GOTO encmushroom
IFEQ $enmtype 4 GOTO enctraps
IFEQ $enmtype 5 GOTO encmerchant
RETURN

:encbat
COLOR red
PRINT "A giant cave bat swoops!"
PRINT ""
COLOR yellow
PRINT "  1. Fight!"
PRINT "  2. Flee!"
INPUT enc "> "
IFEQ $enc 1 GOTO fightbat2
IFEQ $enc 2 GOTO flee
COLOR magenta
PRINT "Choose 1 or 2!"
WAIT 300
RETURN

:fightbat2
RAND bstdmg 5 15
EXPR health $health - $bstdmg
COLOR red
PRINT "Bat attacks for $bstdmg!"
PRINT "Health: $health"
WAVE 1 noise 600 20
WAIT 100
WAVESTOP
IF $health <= 0 GOTO gameover
COLOR green
PRINT "You swat it away!"
ADD score 15
WAVE 1 sine 880 15
WAIT 100
WAVESTOP
RETURN

:flee
RAND fleechance 1 3
IF $fleechance >= 2 GOTO fleesuccess
COLOR red
PRINT "You trip while fleeing!"
RAND fledmg 5 15
EXPR health $health - $fledmg
COLOR red
PRINT "Took $fledmg damage!"
IF $health <= 0 GOTO gameover
RETURN

:fleesuccess
COLOR green
PRINT "You escape safely!"
RETURN

:encspider
COLOR red
PRINT "A venomous cave spider"
PRINT "drops from the ceiling!"
PRINT ""
COLOR yellow
PRINT "  1. Fight!"
PRINT "  2. Use potion to blind it"
INPUT enc "> "
IFEQ $enc 1 GOTO fightspider
IFEQ $enc 2 GOTO blindspider
RETURN

:fightspider
RAND spdm 10 25
EXPR health $health - $spdm
COLOR red
PRINT "Spider bites for $spdm!"
PRINT "Health: $health"
WAVE 1 noise 1000 25
WAIT 100
WAVESTOP
IF $health <= 0 GOTO gameover
ADD gold 10
COLOR green
PRINT "Spider defeated! +10g"
ADD score 20
RETURN

:blindspider
IF $potions <= 0 GOTO nospidpot
ADD potions -1
COLOR white
PRINT "The potion splash confuses"
PRINT "the spider! It scurries off."
WAVE 1 sine 440 20
WAIT 100
WAVESTOP
RETURN

:nospidpot
COLOR red
PRINT "No potions to spare!"
GOTO fightspider

:encmushroom
COLOR green
PRINT "A glowing mushroom patch!"
PRINT "It seems to radiate energy."
PRINT ""
COLOR yellow
PRINT "  1. Eat a mushroom"
PRINT "  2. Leave it"
INPUT enc "> "
IFEQ $enc 1 GOTO eatmush
IFEQ $enc 2 GOTO leavemush
RETURN

:eatemush
RAND mushroll 1 4
IF $mushroll >= 3 GOTO goodmush
GOTO badmush

:goodmush
EXPR health $health + 20
IF $health <= $maxhp GOTO mushhealcapdone
SET health $maxhp
:mushhealcapdone
COLOR green
PRINT "It heals you! +20 HP!"
PRINT "Health: $health"
WAVE 1 sine 660 15
WAIT 100
WAVESTOP
ADD score 10
RETURN

:badmush
EXPR health $health - 15
COLOR red
PRINT "It was poisonous! -15 HP!"
PRINT "Health: $health"
WAVE 1 noise 400 25
WAIT 100
WAVESTOP
IF $health <= 0 GOTO gameover
RETURN

:leavemush
COLOR white
PRINT "You leave the mushroom alone."
RETURN

:enctraps
COLOR red
PRINT "A pressure plate CLICKS!"
PRINT ""
RAND trapdmg 10 30
EXPR health $health - $trapdmg
COLOR red
PRINT "Spikes! -$trapdmg HP!"
PRINT "Health: $health"
WAVE 1 noise 2000 30
WAIT 100
WAVESTOP
IF $health <= 0 GOTO gameover
RETURN

:encmerchant
COLOR cyan
PRINT "A mysterious merchant appears!"
PRINT "'Healing potion for 20 gold?'"
PRINT ""
COLOR yellow
PRINT "  1. Buy (20g)"
PRINT "  2. Leave"
INPUT enc "> "
IFEQ $enc 1 GOTO buymerch
IFEQ $enc 2 GOTO leavemerch
RETURN

:buymerch
IF $gold < 20 GOTO nomenry
ADD gold -20
ADD potions 1
COLOR green
PRINT "Potion purchased!"
COLOR yellow
PRINT "Gold: $gold | Potions: $potions"
WAVE 1 sine 880 20
WAIT 100
WAVESTOP
RETURN

:nomenry
COLOR red
PRINT "Not enough gold!"
WAIT 300
RETURN

:leavemerch
COLOR white
PRINT "You pass the merchant by."
RETURN

# ── Draw Map ───────────────────────────────────────────────────

:drawmap
# Clear vis cells to build map
# Cell 0,0 = surface camp
# Row 5 = treasure/deep

# Draw a wide tactical map with persistent stats beside it.
CANVAS 84 36
CLS
COLOR cyan
PUT 3 2 "ABYSSAL DEPTHS // MAP"
PUT 55 2 "ADVENTURER"

# Draw the cave map
# S = Surface, # = wall, . = path, * = player, ? = unexplored
COLOR white

# Row 0: surface camp
PUT 5 6 ".  .  .  .  C  .  .  .  .  ."
# Row 1: halls / lake
PUT 5 10 ".  .  H  .  .  .  L  .  .  ."
# Row 2: shadow / lake
PUT 5 14 ".  .  S  .  .  .  L  .  .  ."
# Row 3: ruins / caverns
PUT 5 18 ".  .  R  .  .  .  D  .  .  ."
# Row 4: lava / boss
PUT 5 22 ".  .  V  .  .  .  B  .  .  ."
# Row 5: garden / treasure / exit
PUT 5 26 ".  .  G  .  T  .  E  .  .  ."

# Show player position
COLOR pink
EXPR pcol 5 + $px * 3
EXPR prow 6 + $py * 4
PUT $pcol $prow "@"

# The right-hand dashboard makes the map useful instead of a tiny thumbnail.
COLOR white
PUT 55 7 "HP       $health/$maxhp"
PUT 55 10 "GOLD     $gold"
PUT 55 13 "POTIONS  $potions"
PUT 55 16 "KEYS     $keys"
PUT 55 19 "SCORE    $score"
COLOR yellow
PUT 55 23 "W/A/S/D  MOVE"
PUT 55 25 "I        INVENTORY"
PUT 55 27 "H        HEAL"
COLOR cyan
PUT 3 33 "$zone"
FLIP
WAIT 350
ENDCANVAS
RETURN

# ── Show Status ────────────────────────────────────────────────

:showstatus
COLOR white
PRINT ""
COLOR yellow
PRINT "═══ Status ═══"
COLOR white
PRINT "  HP: $health/$maxhp"
PRINT "  Gold: $gold"
PRINT "  Potions: $potions"
PRINT "  Keys: $keys"
COLOR pink
PRINT "  Score: $score"
RETURN

# ── Game Over ──────────────────────────────────────────────────

:gameover
WAVESTOP
CLEAR
COLOR red
PRINT "╔══════════════════════════╗"
PRINT "║       G A M E  O V E R   ║"
PRINT "╚══════════════════════════╝"
WAIT 500

COLOR white
PRINT ""
PRINT "$player has fallen in the"
PRINT "Abyssal Depths..."
WAIT 500

COLOR yellow
PRINT ""
PRINT "═══ Final Stats ═══"
PRINT "  Gold:    $gold"
PRINT "  Score:   $score"
PRINT "  Steps:   $step"
PRINT "  Zone:    $zone"

EXPR totalscore $score + $gold
COLOR pink
PRINT "  Total:   $totalscore"

# Save high score
IF $totalscore > $hiscore GOTO savescore
GOTO showfinal

:savescore
EXPR hiscore $totalscore
SETSTR hisname $player
FOPEN "/apps/grotto2.hs" write
SETSTR hstxt "#$totalscore"
SETSTR hsline $hstxt
FWRITE $hsline
FCLOSE
COLOR green
PRINT ""
PRINT "* NEW HIGH SCORE! *"

:showfinal
WAIT 700
COLOR pink
PRINT ""
PRINT "Thanks for playing!"
PRINT "Run 'apps run grotto2'"
PRINT "to adventure again!"
WAIT 750
EXIT

# ── Victory (reach row 5 col 5+) ───────────────────────────────

:victory
IF $py = 5 GOTO checkvictory
RETURN

:checkvictory
IF $px >= 6 GOTO win
RETURN

:win
WAVESTOP
WAVE 1 sine 523 20
WAIT 100
WAVE 1 sine 659 20
WAIT 100
WAVE 1 sine 784 20
WAIT 100
WAVE 1 sine 1047 30
WAIT 200
WAVESTOP

CLEAR
COLOR green
PRINT "╔══════════════════════════╗"
COLOR pink
PRINT "║    V I C T O R Y !       ║"
COLOR green
PRINT "╚══════════════════════════╝"
WAIT 500

COLOR white
PRINT ""
PRINT "$player escapes the Abyssal"
PRINT "Depths with a fortune!"
WAIT 500

ADD score 500
EXPR totalscore $score + $gold

COLOR yellow
PRINT ""
PRINT "═══ Final Stats ═══"
PRINT "  Gold:    $gold"
PRINT "  Score:   $score"
PRINT "  Steps:   $step"
COLOR pink
PRINT "  TOTAL:   $totalscore"

# Save high score
IF $totalscore > $hiscore GOTO savescore2
GOTO showfinal2

:savescore2
EXPR hiscore $totalscore
SETSTR hisname $player
FOPEN "/apps/grotto2.hs" write
SETSTR hstxt "#$totalscore"
SETSTR hsline $hstxt
FWRITE $hsline
FCLOSE
COLOR green
PRINT ""
PRINT "* NEW HIGH SCORE! *"

:showfinal2
WAIT 700
COLOR cyan
PRINT ""
PRINT "The Crystal pulses one last"
PRINT "time, then goes still."
PRINT "Its purpose is fulfilled."
WAIT 500
COLOR pink
PRINT ""
PRINT "Thanks for playing!"
PRINT "Run 'apps run grotto2'"
PRINT "to adventure again!"
WAIT 750
EXIT
