# @dapp-format 1
# @id lamp
# @name Lamp
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.3.0 <2.0.0
# @summary Mix the rear RGB LED by hand, with presets and a mood cycle
# /apps/lamp.dapp
# A mixing desk for the rear RGB LED. Up/down pick a channel, left/right
# move it by 8, [ and ] by 1, keys 1-8 are presets, M runs a slow hue
# cycle, X blacks it out, S saves the colour to /apps/lamp.rgb and it comes
# back at the next start. Escape quits.
#
# Two things worth knowing. The LED override belongs to the running app:
# the shell takes the light back for its own indicators the moment this
# app exits, so `lamp` is a lamp for as long as you leave it running. And
# an LED write only reaches the hardware while the app is inside a WAIT,
# which is where the shell services the indicator mixer -- so the loop
# writes the colour and then waits, rather than writing twice in a row.
#
# The mood cycle walks hue around the six ramps of the colour wheel with
# EXPR, which is the whole of the conversion: inside each 60-degree
# segment one channel is climbing, one is falling, and one is parked.

CANVAS 80 30

SET red 255
SET green 120
SET blue 0
SET sel 0
SET mood 0
SET hue 0
SET nextat 0
SETSTR note ""
GOSUB loadcolour
GOSUB apply
GOSUB draw

:loop
KEY k
IF $k <> 0 GOSUB handlekey
IF $quit = 1 GOTO leave
IF $mood = 0 GOTO lp_wait
EXPR remain $nextat - $millis
IF $remain > 0 GOTO lp_wait
EXPR nextat $millis + 90
ADD hue 4
IF $hue < 360 GOTO lp_hue
SUB hue 360
:lp_hue
GOSUB huecolour
GOSUB apply
GOSUB draw
:lp_wait
WAIT 20
GOTO loop

# ---------------------------------------------------------------- input

:handlekey
SETSTR note ""
IF $k = $kesc GOTO hk_quit
IF $k = $kup GOTO hk_prev
IF $k = $kdown GOTO hk_next
IF $k = $kleft GOTO hk_down8
IF $k = $kright GOTO hk_up8
IF $k = 91 GOTO hk_down1
IF $k = 93 GOTO hk_up1
IF $k = 109 GOTO hk_mood
IF $k = 77 GOTO hk_mood
IF $k = 120 GOTO hk_off
IF $k = 88 GOTO hk_off
IF $k = 115 GOTO hk_save
IF $k = 83 GOTO hk_save
IF $k >= 49 GOTO hk_preset
RETURN

:hk_quit
SET quit 1
RETURN

:hk_prev
SUB sel 1
IF $sel >= 0 GOTO hk_draw
SET sel 2
GOTO hk_draw
:hk_next
ADD sel 1
IF $sel <= 2 GOTO hk_draw
SET sel 0
GOTO hk_draw

:hk_down8
SET step -8
GOTO hk_adjust
:hk_up8
SET step 8
GOTO hk_adjust
:hk_down1
SET step -1
GOTO hk_adjust
:hk_up1
SET step 1
:hk_adjust
SET mood 0
GOSUB channeladd
GOSUB apply
GOTO hk_draw

:hk_mood
IF $mood = 1 GOTO hk_mood_off
SET mood 1
SETSTR note "mood cycle on"
GOTO hk_draw
:hk_mood_off
SET mood 0
SETSTR note "mood cycle off"
GOTO hk_draw

:hk_off
SET mood 0
SET red 0
SET green 0
SET blue 0
GOSUB apply
SETSTR note "blacked out"
GOTO hk_draw

:hk_save
GOSUB savecolour
GOTO hk_draw

# 1-8 are presets; anything else above '1' is ignored
:hk_preset
IF $k > 56 GOTO hk_draw
SET mood 0
EXPR pre $k - 48
GOSUB preset
GOSUB apply
GOTO hk_draw

:hk_draw
GOSUB draw
RETURN

# in: step -- moves the selected channel and clamps it to 0..255
:channeladd
IF $sel = 1 GOTO ca_green
IF $sel = 2 GOTO ca_blue
ADD red $step
SET v $red
GOSUB clamp
SET red $v
RETURN
:ca_green
ADD green $step
SET v $green
GOSUB clamp
SET green $v
RETURN
:ca_blue
ADD blue $step
SET v $blue
GOSUB clamp
SET blue $v
RETURN

:clamp
IF $v < 0 GOTO cl_low
IF $v > 255 GOTO cl_high
RETURN
:cl_low
SET v 0
RETURN
:cl_high
SET v 255
RETURN

:preset
IF $pre = 2 GOTO pr_candle
IF $pre = 3 GOTO pr_red
IF $pre = 4 GOTO pr_amber
IF $pre = 5 GOTO pr_green
IF $pre = 6 GOTO pr_cyan
IF $pre = 7 GOTO pr_blue
IF $pre = 8 GOTO pr_violet
SET red 255
SET green 190
SET blue 130
SETSTR note "warm white"
RETURN
:pr_candle
SET red 120
SET green 45
SET blue 5
SETSTR note "candle"
RETURN
:pr_red
SET red 255
SET green 0
SET blue 0
SETSTR note "red"
RETURN
:pr_amber
SET red 255
SET green 140
SET blue 0
SETSTR note "amber"
RETURN
:pr_green
SET red 0
SET green 255
SET blue 40
SETSTR note "green"
RETURN
:pr_cyan
SET red 0
SET green 200
SET blue 200
SETSTR note "cyan"
RETURN
:pr_blue
SET red 0
SET green 40
SET blue 255
SETSTR note "blue"
RETURN
:pr_violet
SET red 160
SET green 0
SET blue 255
SETSTR note "violet"
RETURN

# ---------------------------------------------------------------- colour

# in: hue (0..359) -- one channel climbing, one falling, one parked
:huecolour
EXPR seg floor($hue / 60)
EXPR rise floor(($hue - $seg * 60) * 255 / 60)
EXPR fall 255 - $rise
IF $seg = 1 GOTO hc_1
IF $seg = 2 GOTO hc_2
IF $seg = 3 GOTO hc_3
IF $seg = 4 GOTO hc_4
IF $seg = 5 GOTO hc_5
SET red 255
SET green $rise
SET blue 0
RETURN
:hc_1
SET red $fall
SET green 255
SET blue 0
RETURN
:hc_2
SET red 0
SET green 255
SET blue $rise
RETURN
:hc_3
SET red 0
SET green $fall
SET blue 255
RETURN
:hc_4
SET red $rise
SET green 0
SET blue 255
RETURN
:hc_5
SET red 255
SET green 0
SET blue $fall
RETURN

# the only place LED is called: on a build with no rear LED the opcode
# would stop the app, so $ledok decides whether it runs at all
:apply
IF $ledok = 0 GOTO ap_done
LED $red $green $blue
:ap_done
RETURN

# ---------------------------------------------------------------- drawing

:draw
CLS
COLOR pink
PUT 0 0 "LAMP"
IF $ledok = 1 GOTO dr_haveled
COLOR yellow
PUT 6 0 "no rear LED on this build"
GOTO dr_channels
:dr_haveled
COLOR cyan
PUT 6 0 "rear LED"
IF $mood = 0 GOTO dr_channels
COLOR magenta
PUT 16 0 "mood"

:dr_channels
SET ch 0
:dr_ch
GOSUB channelrow
ADD ch 1
IF $ch < 3 GOTO dr_ch

GOSUB preview

COLOR yellow
PUT 0 25 "up/down pick   left/right +-8   [ ] +-1"
PUT 0 27 "1-8 presets   m mood   x off   s save   esc quit"
COLOR green
PUT 0 29 $note
FLIP
RETURN

:channelrow
EXPR ry $ch + 2
SET v $red
SETSTR label "R"
IF $ch = 1 GOSUB rowgreen
IF $ch = 2 GOSUB rowblue
GOSUB barfor
COLOR white
IF $ch <> $sel GOTO cr_label
PUT 0 $ry ">"
:cr_label
GOSUB rowcolour
PUT 2 $ry $label
PUT 4 $ry $bar
PUT 28 $ry $v
RETURN

:rowgreen
SET v $green
SETSTR label "G"
RETURN
:rowblue
SET v $blue
SETSTR label "B"
RETURN

:rowcolour
COLOR red
IF $ch = 0 GOTO rc_done
COLOR green
IF $ch = 1 GOTO rc_done
COLOR blue
:rc_done
RETURN

# in: v (0..255) -- out: bar, a 20-cell meter
:barfor
EXPR fill floor($v * 20 / 255 + 0.5)
SETSTR bar "["
SET i 0
:bf_cell
IF $i >= $fill GOTO bf_dot
APPEND bar "#"
GOTO bf_next
:bf_dot
APPEND bar "."
:bf_next
ADD i 1
IF $i < 20 GOTO bf_cell
APPEND bar "]"
RETURN

:preview
GOSUB previewcolour
PUT 4 5 "+--------------+"
PUT 4 6 "|##############|"
PUT 4 7 "|##############|"
PUT 4 8 "+--------------+"
GOSUB hexstring
COLOR white
PUT 22 6 $hexs
COLOR cyan
PUT 22 7 "$red,$green,$blue"
COLOR pink
PUT 45 5 "LIVE COLOUR"
COLOR white
PUT 45 8 "Fine controls and presets"
PUT 45 10 "use the whole Tab5 panel"
RETURN

# the panel has eight colours and the LED has sixteen million, so the
# preview shows the nearest terminal colour rather than pretending
:previewcolour
SET hr 0
SET hg 0
SET hb 0
IF $red >= 96 GOTO pv_r
:pv_gtest
IF $green >= 96 GOTO pv_g
:pv_btest
IF $blue >= 96 GOTO pv_b
:pv_pick
EXPR lit $hr + $hg + $hb
IF $lit = 0 GOTO pv_dark
IF $lit = 3 GOTO pv_white
IF $hr = 0 GOTO pv_nored
IF $hg = 1 GOTO pv_yellow
IF $hb = 1 GOTO pv_pink
COLOR red
RETURN
:pv_nored
IF $hg = 0 GOTO pv_blue
IF $hb = 1 GOTO pv_cyan
COLOR green
RETURN
:pv_r
SET hr 1
GOTO pv_gtest
:pv_g
SET hg 1
GOTO pv_btest
:pv_b
SET hb 1
GOTO pv_pick
:pv_dark
COLOR blue
RETURN
:pv_white
COLOR white
RETURN
:pv_yellow
COLOR yellow
RETURN
:pv_pink
COLOR pink
RETURN
:pv_cyan
COLOR cyan
RETURN
:pv_blue
COLOR blue
RETURN

# ---------------------------------------------------------------- hex

:hexstring
SETSTR hexs "#"
SET hv $red
GOSUB hexbyte
SET hv $green
GOSUB hexbyte
SET hv $blue
GOSUB hexbyte
RETURN

:hexbyte
EXPR hd floor($hv / 16)
GOSUB hexdigit
EXPR hd $hv % 16
GOSUB hexdigit
RETURN

:hexdigit
EXPR hc 48 + $hd
IF $hd < 10 GOTO hx_put
EXPR hc 55 + $hd
:hx_put
CHR hch $hc
APPEND hexs $hch
RETURN

# ---------------------------------------------------------------- the file

:loadcolour
FEXISTS have "/apps/lamp.rgb"
IF $have = 0 GOTO lc_done
FOPEN "/apps/lamp.rgb" read
IF $fok = 0 GOTO lc_done
FREAD text
GOSUB str2num
SET red $num
FREAD text
GOSUB str2num
SET green $num
FREAD text
GOSUB str2num
SET blue $num
FCLOSE
SETSTR note "restored /apps/lamp.rgb"
:lc_done
RETURN

:savecolour
FOPEN "/apps/lamp.rgb" write
IF $fok = 0 GOTO sc_failed
FWRITE $red
FWRITE $green
FWRITE $blue
FCLOSE
SETSTR note "saved to /apps/lamp.rgb"
RETURN
:sc_failed
SETSTR note "could not write /apps/lamp.rgb"
RETURN

# in: text (string)   out: num -- a channel read back from a file is text
:str2num
SET num 0
SET s2i 0
LEN s2len $text
:s2n_loop
IF $s2i >= $s2len GOTO s2n_done
CHARAT s2d $text $s2i
IF $s2d < 48 GOTO s2n_done
IF $s2d > 57 GOTO s2n_done
SUB s2d 48
MUL num 10
ADD num $s2d
ADD s2i 1
GOTO s2n_loop
:s2n_done
RETURN

# the hex is built before the light goes out, so the parting line reports
# the mix rather than the blackout that follows it
:leave
GOSUB hexstring
SET red 0
SET green 0
SET blue 0
GOSUB apply
WAIT 30
ENDCANVAS
COLOR pink
PRINT "lamp: last mix $hexs - the shell has the LED back"
EXIT
