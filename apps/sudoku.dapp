# @dapp-format 1
# @id sudoku
# @name Sudoku 9x9
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.1.0 <2.0.0
# @summary A full-size 9x9 Sudoku game designed for the DS canvas
# /apps/sudoku.dapp
# Arrows move, 1-9 enter a digit, 0 or backspace clears, c checks the
# board, n starts a fresh digit-shifted puzzle, escape quits.

CANVAS 80 36
DIM grid 81
DIM solution 81
DIM fixed 81
SETSTR soltext "534678912672195348198342567859761423426853791713924856961537284287419635345286179"
SETSTR puzzle "530070000600195000098000060800060003400803001700020006060000280000419005000080079"
SET row 0
SET col 0
SET quit 0
SETSTR msg "arrows move   1-9 write   c check"
GOSUB newgame
GOSUB draw

:loop
KEY k
IF $k = 0 GOTO idle
GOSUB handlekey
IF $quit = 1 GOTO leave
GOSUB draw
:idle
WAIT 18
GOTO loop

:handlekey
IF $k = $kesc GOTO hkquit
IF $k = $kleft GOTO hkleft
IF $k = $kright GOTO hkright
IF $k = $kup GOTO hkup
IF $k = $kdown GOTO hkdown
IF $k = $kback GOTO hkclear
IF $k = 48 GOTO hkclear
IF $k = 99 GOTO hkcheck
IF $k = 67 GOTO hkcheck
IF $k = 110 GOTO hknew
IF $k = 78 GOTO hknew
IF $k < 49 GOTO hknone
IF $k > 57 GOTO hknone
EXPR idx $row * 9 + $col
IF $fixed[$idx] = 1 GOTO hkfixed
EXPR value $k - 48
SET grid[$idx] $value
SETSTR msg "digit placed"
GOSUB checkwin
RETURN
:hkclear
EXPR idx $row * 9 + $col
IF $fixed[$idx] = 1 GOTO hkfixed
SET grid[$idx] 0
SETSTR msg "cell cleared"
RETURN
:hkfixed
SETSTR msg "that clue is fixed"
RETURN
:hkcheck
GOSUB checkboard
RETURN
:hknew
GOSUB newgame
SETSTR msg "new puzzle"
RETURN
:hkleft
SUB col 1
IF $col >= 0 GOTO hknone
SET col 8
RETURN
:hkright
ADD col 1
IF $col <= 8 GOTO hknone
SET col 0
RETURN
:hkup
SUB row 1
IF $row >= 0 GOTO hknone
SET row 8
RETURN
:hkdown
ADD row 1
IF $row <= 8 GOTO hknone
SET row 0
RETURN
:hkquit
SET quit 1
:hknone
RETURN

:newgame
RAND shift 9
SET i 0
:initloop
CHARAT value $soltext $i
SUB value 48
ADD value $shift
SUB value 1
MOD value 9
ADD value 1
SET solution[$i] $value
CHARAT given $puzzle $i
SUB given 48
IF $given = 0 GOTO initblank
ADD given $shift
SUB given 1
MOD given 9
ADD given 1
SET grid[$i] $given
SET fixed[$i] 1
GOTO initnext
:initblank
SET grid[$i] 0
SET fixed[$i] 0
:initnext
ADD i 1
IF $i < 81 GOTO initloop
SET row 0
SET col 0
RETURN

:draw
CLS
COLOR pink
PUT 2 1 "SUDOKU 9x9"
COLOR cyan
PUT 52 5 "$msg"
COLOR gray
PUT 6 3 "+-----------+-----------+-----------+"
PUT 6 10 "+-----------+-----------+-----------+"
PUT 6 17 "+-----------+-----------+-----------+"
PUT 6 23 "+-----------+-----------+-----------+"
SET r 0
:drawrow
IF $r >= 9 GOTO drawdone
EXPR y 4 + $r * 2
COLOR gray
PUT 6 $y "|"
PUT 18 $y "|"
PUT 30 $y "|"
PUT 42 $y "|"
SET c 0
:drawcell
IF $c >= 9 GOTO drawnextr
EXPR idx $r * 9 + $c
EXPR x 9 + $c * 4
SET value $grid[$idx]
IF $r = $row GOTO maybeselected
GOTO normalcell
:maybeselected
IF $c = $col GOTO selectedcell
:normalcell
IF $fixed[$idx] = 1 GOTO fixedcell
COLOR white
GOTO putcell
:fixedcell
COLOR cyan
GOTO putcell
:selectedcell
COLOR yellow
:putcell
IF $value = 0 GOTO putblank
PUT $x $y "$value"
GOTO cellnext
:putblank
PUT $x $y "."
:cellnext
ADD c 1
GOTO drawcell
:drawnextr
ADD r 1
GOTO drawrow
:drawdone
COLOR white
PUT 52 12 "digits      enter"
PUT 52 14 "0 / BACK    clear"
PUT 52 16 "C           check"
PUT 52 18 "N           new"
PUT 52 20 "ESC         quit"
FLIP
RETURN

:checkboard
SET errors 0
SET blanks 0
SET i 0
:checkloop
IF $i >= 81 GOTO checkdone
IF $grid[$i] = 0 GOTO checkblank
IF $grid[$i] <> $solution[$i] GOTO checkerror
GOTO checknext
:checkblank
ADD blanks 1
GOTO checknext
:checkerror
ADD errors 1
:checknext
ADD i 1
GOTO checkloop
:checkdone
IF $errors > 0 GOTO checkbad
IF $blanks > 0 GOTO checkprogress
SETSTR msg "solved!"
RETURN
:checkbad
SETSTR msg "$errors wrong, $blanks blank"
RETURN
:checkprogress
SETSTR msg "correct so far; $blanks blank"
RETURN

:checkwin
SET i 0
:winloop
IF $i >= 81 GOTO winner
IF $grid[$i] <> $solution[$i] GOTO windone
ADD i 1
GOTO winloop
:winner
SETSTR msg "SOLVED - press n for another"
:windone
RETURN

:leave
ENDCANVAS
COLOR pink
PRINT "sudoku closed"
EXIT
