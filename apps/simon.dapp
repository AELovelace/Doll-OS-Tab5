# @dapp-format 1
# @id simon
# @name Simon
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.3.0 <2.0.0
# @summary Repeat the colour sequence the rear LED plays back at you
# /apps/simon.dapp
# Simon for the DOLL-OS canvas and the rear RGB LED. Watch the sequence,
# then repeat it with the arrow keys: up is red, right is green, down is
# blue, left is yellow. Escape quits, R starts over.
#
# Every colour change goes through one `led` routine that returns without
# doing anything when $ledok is 0. The LED opcode stops an app dead on a
# build with no rear LED, so a single guarded routine is the difference
# between "runs everywhere, quieter on some boards" and "refuses to start".
# The panel shows the same colour at the same time, so the game is playable
# either way.
#
# LED writes only reach the hardware while the app is inside a WAIT, since
# that is when the shell services its indicator mixer. Every flash here is
# therefore LED-then-WAIT, never two LED writes in a row.

CANVAS 80 36
DIM seq 64

GOSUB loadhs
COLOR pink
PUT 15 5 "S I M O N"
COLOR white
PUT 6 7 "watch the light, then repeat"
PUT 9 8 "arrows pick the colour"
IF $ledok = 1 GOTO intro_flip
COLOR yellow
PUT 4 10 "no rear LED on this build - panel only"
:intro_flip
FLIP
WAIT 1500

:newgame
SET len 0
SET score 0
SET quit 0
SET restart 0
SET lost 0
SET newhi 0
SET showms 420
SET active -1
GOSUB draw

:ng_drain
KEY k
IF $k <> 0 GOTO ng_drain

# ---------------------------------------------------------------- rounds

# one round: extend the sequence, play it back, then read the same number
# of presses. Anything wrong drops out through `lost` rather than jumping
# out of a routine.
:round
IF $len >= 64 GOTO youwin
RAND next 4
SET seq[$len] $next
ADD len 1
GOSUB showseq
GOSUB readseq
IF $quit = 1 GOTO leave
IF $restart = 1 GOTO newgame
IF $lost = 1 GOTO gameover
EXPR score $len
GOSUB speedup
SET active -1
GOSUB draw
WAIT 500
GOTO round

# playback gets quicker as the sequence grows, which is most of the
# difficulty past round ten
:speedup
SUB showms 12
IF $showms > 170 GOTO sp_done
SET showms 170
:sp_done
RETURN

:showseq
SET si 0
:ss_step
SET active $seq[$si]
GOSUB litcolour
GOSUB draw
WAIT $showms
SET active -1
GOSUB ledoff
GOSUB draw
EXPR gap floor($showms / 3) + 60
WAIT $gap
ADD si 1
IF $si < $len GOTO ss_step
RETURN

# reads $len presses, echoing each one on the LED and the panel. Anything
# pressed while the sequence was playing is dropped first: mashing keys
# during playback should not spend your turn.
:readseq
SET si 0
:rs_drain
KEY k
IF $k <> 0 GOTO rs_drain
:rs_wait
KEY k
IF $k = 0 GOTO rs_idle
IF $k = $kesc GOTO rs_quit
IF $k = 114 GOTO rs_restart
IF $k = 82 GOTO rs_restart
SET press -1
IF $k = $kup GOTO rs_red
IF $k = $kright GOTO rs_green
IF $k = $kdown GOTO rs_blue
IF $k = $kleft GOTO rs_yellow
GOTO rs_idle
:rs_red
SET press 0
GOTO rs_test
:rs_green
SET press 1
GOTO rs_test
:rs_blue
SET press 2
GOTO rs_test
:rs_yellow
SET press 3

:rs_test
SET active $press
GOSUB litcolour
GOSUB draw
WAIT 160
SET active -1
GOSUB ledoff
GOSUB draw
IF $press <> $seq[$si] GOTO rs_wrong
ADD si 1
IF $si >= $len GOTO rs_done
:rs_idle
WAIT 16
GOTO rs_wait

:rs_wrong
SET lost 1
RETURN
:rs_quit
SET quit 1
RETURN
:rs_restart
SET restart 1
RETURN
:rs_done
RETURN

# ---------------------------------------------------------------- the LED

# the only place LED is called. $ledok is 0 on a build without a rear LED,
# where the opcode would stop the app instead of being ignored.
:led
IF $ledok = 0 GOTO led_done
LED $lr $lg $lb
:led_done
RETURN

:ledoff
SET lr 0
SET lg 0
SET lb 0
GOSUB led
RETURN

# in: active (0..3)  -- lights the LED in that pad's colour
:litcolour
IF $active = 1 GOTO lc_green
IF $active = 2 GOTO lc_blue
IF $active = 3 GOTO lc_yellow
SET lr 255
SET lg 0
SET lb 0
GOTO lc_send
:lc_green
SET lr 0
SET lg 255
SET lb 0
GOTO lc_send
:lc_blue
SET lr 0
SET lg 40
SET lb 255
GOTO lc_send
:lc_yellow
SET lr 255
SET lg 170
SET lb 0
:lc_send
GOSUB led
RETURN

# ---------------------------------------------------------------- drawing

:draw
CLS
SET pad 0
:dr_pad
GOSUB padbox
ADD pad 1
IF $pad < 4 GOTO dr_pad

COLOR pink
PUT 0 0 "SIMON"
COLOR cyan
PUT 8 0 "round"
COLOR white
PUT 14 0 $len
COLOR cyan
PUT 48 6 "best"
COLOR white
PUT 58 6 $hiscore
COLOR yellow
PUT 48 18 "arrows      repeat it"
PUT 48 21 "R           new game"
PUT 48 24 "ESC         quit"
FLIP
RETURN

# one of the four pads. A lit pad is filled in its own colour; a dark one
# is an outline, so the sequence reads the same on the panel as on the LED.
:padbox
EXPR px ($pad % 2) * 20
EXPR py floor($pad / 2) * 5 + 2
SET lit 0
IF $pad = $active GOSUB setlit
IF $lit = 1 GOTO pb_colour
COLOR blue
GOTO pb_frame
:pb_colour
GOSUB padcolour
:pb_frame
PUT $px $py "+-----------------+"
EXPR ry $py + 1
PUT $px $ry "|                 |"
EXPR ry $py + 2
PUT $px $ry "|                 |"
EXPR ry $py + 3
PUT $px $ry "+-----------------+"
IF $lit = 0 GOTO pb_label
EXPR fx $px + 1
EXPR ry $py + 2
PUT $fx $ry "#################"
:pb_label
GOSUB padcolour
EXPR ry $py + 1
EXPR tx $px + 3
PUT $tx $ry $padname
RETURN

:setlit
SET lit 1
RETURN

# names the pad and sets the panel colour to match the LED colour
:padcolour
IF $pad = 1 GOTO pc_green
IF $pad = 2 GOTO pc_blue
IF $pad = 3 GOTO pc_yellow
COLOR red
SETSTR padname "UP     RED"
RETURN
:pc_green
COLOR green
SETSTR padname "RIGHT  GREEN"
RETURN
:pc_blue
COLOR cyan
SETSTR padname "DOWN   BLUE"
RETURN
:pc_yellow
COLOR yellow
SETSTR padname "LEFT   YELLOW"
RETURN

# ---------------------------------------------------------------- best round

:loadhs
SET hiscore 0
FEXISTS hs "/apps/simon.hs"
IF $hs = 0 GOTO lh_done
FOPEN "/apps/simon.hs" read
IF $fok = 0 GOTO lh_done
FREAD text
FCLOSE
GOSUB str2num
SET hiscore $num
:lh_done
RETURN

:savehs
SET newhi 0
IF $score <= $hiscore GOTO sh_done
SET hiscore $score
SET newhi 1
FOPEN "/apps/simon.hs" write
IF $fok = 0 GOTO sh_done
FWRITE $score
FCLOSE
:sh_done
RETURN

# in: text (string)   out: num -- a round count read back from a file is text
:str2num
SET num 0
SET s2i 0
LEN s2len $text
:s2n_loop
IF $s2i >= $s2len GOTO s2n_done
CHARAT s2d $text $s2i
IF $s2d < 48 GOTO s2n_done
IF $s2d > 57 GOTO s2n_done
SUB s2d 48
MUL num 10
ADD num $s2d
ADD s2i 1
GOTO s2n_loop
:s2n_done
RETURN

# ---------------------------------------------------------------- endings

:gameover
GOSUB savehs
SET lr 255
SET lg 0
SET lb 0
GOSUB led
SET active -1
GOSUB draw
COLOR red
PUT 8 5 "+---------------------+"
PUT 8 6 "|                     |"
PUT 8 7 "|                     |"
PUT 8 8 "|                     |"
PUT 8 9 "+---------------------+"
PUT 13 6 "WRONG COLOUR"
COLOR white
PUT 12 7 "round $score"
IF $newhi = 0 GOTO go_keys
COLOR yellow
PUT 11 7 "BEST YET: $score"
:go_keys
COLOR cyan
PUT 10 8 "r=again  esc=quit"
FLIP
WAIT 900
GOSUB ledoff
GOTO endwait

:youwin
GOSUB savehs
COLOR green
PUT 8 6 "+---------------------+"
PUT 8 7 "| ALL 64 REMEMBERED   |"
PUT 8 8 "+---------------------+"
FLIP

:endwait
WAIT 400
:ew_drain
KEY k
IF $k <> 0 GOTO ew_drain
:ew_wait
KEY k
IF $k = 114 GOTO newgame
IF $k = 82 GOTO newgame
IF $k = $kenter GOTO newgame
IF $k = $kspace GOTO newgame
IF $k = $kesc GOTO leave
WAIT 20
GOTO ew_wait

:leave
GOSUB savehs
GOSUB ledoff
WAIT 30
ENDCANVAS
COLOR pink
PRINT "simon: round $score (best $hiscore)"
EXIT
