# @dapp-format 1
# @id reader
# @name Reader
# @version 1.1.0
# @boards m5stack-tab5
# @runtime >=1.5.0 <2.0.0
# @echo off
# @summary An offline web library with paging, search and saved reading positions
# /apps/reader.dapp
#
# Reader keeps twelve downloaded articles in ordinary files:
#   /apps/reader-N.meta    title, source URL, last top line, active generation
#   /apps/reader-N-G.txt   HTMLTEXT's wrapped article text
#   /apps/reader-N-G.lnk   the article's numbered absolute links
#
# The deliberately transparent layout means Page can read an article and Hex can
# inspect any of the files. HTMLTEXT streams straight from the network to storage,
# so article size is bounded by the filesystem rather than the 4096-byte string cap.
# Refreshes use the inactive G=0/1 generation and only switch metadata after a
# successful download, so losing Wi-Fi never destroys the readable offline copy.
#
# Library: A adds a URL, R refreshes a slot, D deletes one, 1-12 opens, Q quits.
# Reading: space/down advances, up goes back, / searches, L saves a linked page as
# another library item, B/escape returns to the library and saves the position.

SET pagesize 34
SET linewidth 94
SET slots 12
DIM pagetext 3196
DIM pagelen 34

SETSTR lastneedle ""

CANVAS 100 40
GOTO menu

# ---------------------------------------------------------------- library

:menu
CLS
COLOR pink
PUT 0 0 "R E A D E R"
COLOR white
PUT 0 1 "offline web library"
COLOR cyan
PUT 0 3 "slot  title"

SET slot 1
SET row 4
:mn_list
IF $slot > $slots GOTO mn_done
FEXISTS have "/apps/reader-$slot.meta"
IF $have = 0 GOTO mn_empty
FOPEN "/apps/reader-$slot.meta" read
IF $fok = 0 GOTO mn_empty
FREAD title
FCLOSE
COLOR blue
PUT 0 $row $slot
COLOR white
PUT 6 $row $title
GOTO mn_next
:mn_empty
FCLOSE
COLOR blue
PUT 0 $row $slot
COLOR white
PUT 6 $row "-- empty --"
:mn_next
ADD slot 1
ADD row 1
GOTO mn_list

:mn_done
COLOR yellow
PUT 0 35 "A add   R refresh   D delete   Q quit"
COLOR cyan
PUT 0 38 "type a slot number to read"
FLIP

ENDCANVAS
INPUT cmd "reader> "
CANVAS 100 40
IFEQ $cmd "q" GOTO leave
IFEQ $cmd "Q" GOTO leave
IFEQ $cmd "a" GOTO add
IFEQ $cmd "A" GOTO add
IFEQ $cmd "r" GOTO refresh
IFEQ $cmd "R" GOTO refresh
IFEQ $cmd "d" GOTO delete
IFEQ $cmd "D" GOTO delete
SETSTR gotext $cmd
GOSUB str2num
IF $got = 0 GOTO menu
IF $num < 1 GOTO menu
IF $num > $slots GOTO menu
SET slot $num
FEXISTS have "/apps/reader-$slot.meta"
IF $have = 0 GOTO menu
GOTO openarticle

:add
GOSUB findfree
IF $free = 0 GOTO libraryfull
ENDCANVAS
INPUT url "url> "
LEN n $url
IF $n = 0 GOTO addcancel
INPUT title "title> "
LEN n $title
IF $n > 0 GOTO addtitleok
SETSTR title "untitled"
:addtitleok
GOSUB normalize
SET gen 0
SET oldgen 1
GOSUB fetchslot
:addcancel
CANVAS 100 40
GOTO menu

:libraryfull
ENDCANVAS
COLOR red
PRINT "reader: all twelve slots are full"
COLOR white
INPUT dummy "enter> "
CANVAS 100 40
GOTO menu

:refresh
ENDCANVAS
INPUT gotext "refresh slot> "
GOSUB str2num
IF $got = 0 GOTO rf_done
IF $num < 1 GOTO rf_done
IF $num > $slots GOTO rf_done
SET slot $num
GOSUB loadmeta
IF $openok = 0 GOTO rf_done
PRINT "refreshing $title"
SET oldgen $gen
EXPR gen 1 - $gen
GOSUB fetchslot
:rf_done
CANVAS 100 40
GOTO menu

:delete
ENDCANVAS
INPUT gotext "delete slot> "
GOSUB str2num
IF $got = 0 GOTO dl_done
IF $num < 1 GOTO dl_done
IF $num > $slots GOTO dl_done
SET slot $num
FEXISTS have "/apps/reader-$slot.meta"
IF $have = 0 GOTO dl_done
INPUT confirm "type YES to delete> "
IFNE $confirm "YES" GOTO dl_done
FDELETE "/apps/reader-$slot.meta"
FDELETE "/apps/reader-$slot-0.txt"
FDELETE "/apps/reader-$slot-0.lnk"
FDELETE "/apps/reader-$slot-1.txt"
FDELETE "/apps/reader-$slot-1.lnk"
:dl_done
CANVAS 100 40
GOTO menu

# in: slot, title, url, gen, oldgen -- downloads and commits at position zero
:fetchslot
HTTPCLEAR
HTTPHEADER User-Agent "DOLL-OS-reader/1.0"
HTTPHEADER Accept "text/html, text/plain"
COLOR cyan
PRINT "fetching $url"
COLOR white
HTMLTEXT $url "/apps/reader-$slot-$gen.txt" "/apps/reader-$slot-$gen.lnk" $linewidth 200
IF $htmlok = 0 GOTO fs_failed
IF $httpok = 0 GOTO fs_failed
FOPEN "/apps/reader-$slot.meta" write
IF $fok = 0 GOTO fs_failed
FWRITE "$title"
FWRITE "$url"
FWRITE "0"
FWRITE "$gen"
FCLOSE
FDELETE "/apps/reader-$slot-$oldgen.txt"
FDELETE "/apps/reader-$slot-$oldgen.lnk"
COLOR green
PRINT "saved slot $slot: $htmllines lines, $htmllinks links"
COLOR white
WAIT 500
RETURN
:fs_failed
FCLOSE
FDELETE "/apps/reader-$slot-$gen.txt"
FDELETE "/apps/reader-$slot-$gen.lnk"
COLOR red
PRINT "reader: fetch failed (HTTP $httpcode)"
COLOR white
INPUT dummy "enter> "
RETURN

# out: slot, free
:findfree
SET slot 1
SET free 0
:ff_loop
IF $slot > $slots GOTO ff_done
FEXISTS have "/apps/reader-$slot.meta"
IF $have = 0 GOTO ff_found
ADD slot 1
GOTO ff_loop
:ff_found
SET free 1
:ff_done
RETURN

# ---------------------------------------------------------------- article reader

:openarticle
SET article $slot
GOSUB loadmeta
IF $openok = 0 GOTO menu
GOSUB gotoline
GOSUB readpage
GOSUB draw

:readloop
KEY k
IF $k = 0 GOTO rd_wait
IF $k = $kesc GOTO closearticle
IF $k = 98 GOTO closearticle
IF $k = 66 GOTO closearticle
IF $k = $kspace GOTO rd_next
IF $k = $kdown GOTO rd_next
IF $k = 115 GOTO rd_next
IF $k = $kup GOTO rd_prev
IF $k = 119 GOTO rd_prev
IF $k = 47 GOTO rd_search
IF $k = 110 GOTO rd_repeat
IF $k = 108 GOTO rd_link
IF $k = 76 GOTO rd_link
GOTO rd_wait

:rd_next
IF $ateof = 1 GOTO rd_wait
SET topline $curline
GOSUB readpage
GOSUB draw
GOTO rd_wait

:rd_prev
EXPR target $topline - $pagesize
IF $target >= 0 GOTO rdp_go
SET target 0
:rdp_go
SET targetline $target
GOSUB gotoline
GOSUB readpage
GOSUB draw
GOTO rd_wait

:rd_search
ENDCANVAS
INPUT needle "/"
CANVAS 100 40
LEN n $needle
IF $n = 0 GOTO rd_wait
SETSTR lastneedle $needle
GOSUB dosearch
GOTO rd_wait

:rd_repeat
LEN n $lastneedle
IF $n = 0 GOTO rd_wait
SETSTR needle $lastneedle
GOSUB dosearch
GOTO rd_wait

:rd_link
SET restore $topline
FCLOSE
ENDCANVAS
INPUT gotext "save link number> "
GOSUB str2num
IF $got = 0 GOTO rl_restore
IF $num < 1 GOTO rl_restore
SET linknum $num
FOPEN "/apps/reader-$article-$gen.lnk" read
IF $fok = 0 GOTO rl_restore
EXPR skip $linknum - 1
:rl_skip
IF $skip <= 0 GOTO rl_read
FREAD ln
IF $feof = 1 GOTO rl_restore
SUB skip 1
GOTO rl_skip
:rl_read
FREAD ln
IF $feof = 1 GOTO rl_restore
FCLOSE
GOSUB linkurl
LEN n $newurl
IF $n = 0 GOTO rl_restore
GOSUB findfree
IF $free = 0 GOTO rl_full
SETSTR url $newurl
INPUT title "save as title> "
LEN n $title
IF $n > 0 GOTO rl_fetch
SETSTR title "linked page"
:rl_fetch
SET gen 0
SET oldgen 1
GOSUB fetchslot
GOTO rl_restore
:rl_full
COLOR red
PRINT "reader: library is full"
COLOR white
INPUT dummy "enter> "

:rl_restore
FCLOSE
SET slot $article
GOSUB loadmeta
SET targetline $restore
CANVAS 100 40
GOSUB gotoline
GOSUB readpage
GOSUB draw
GOTO rd_wait

:rd_wait
WAIT 16
GOTO readloop

:closearticle
FCLOSE
GOSUB savepos
GOTO menu

# ---------------------------------------------------------------- searching

:dosearch
SET wrapped 0
SET scanline $curline
SET wrapstart $curline
:ds_loop
FREAD ln
IF $feof = 1 GOTO ds_eof
GOSUB linecontains
IF $found = 1 GOTO ds_found
ADD scanline 1
IF $wrapped = 0 GOTO ds_next
IF $scanline >= $wrapstart GOTO ds_notfound
:ds_next
EXPR wtest $scanline % 20
IF $wtest <> 0 GOTO ds_loop
WAIT 1
GOTO ds_loop
:ds_eof
IF $wrapped = 1 GOTO ds_notfound
SET wrapped 1
SET targetline 0
GOSUB gotoline
SET scanline 0
GOTO ds_loop
:ds_found
SET targetline $scanline
GOSUB gotoline
GOSUB readpage
GOSUB draw
RETURN
:ds_notfound
GOSUB draw
COLOR red
PUT 0 37 "not found: $needle"
FLIP
RETURN

:linecontains
SET found 0
LEN clen $ln
LEN nlen $needle
IF $nlen = 0 GOTO lc_done
IF $nlen > $clen GOTO lc_done
EXPR lastart $clen - $nlen
SET lci 0
:lc_try
IF $lci > $lastart GOTO lc_done
SUBSTR chunk $ln $lci $nlen
IFEQ $chunk $needle GOTO lc_found
ADD lci 1
GOTO lc_try
:lc_found
SET found 1
:lc_done
RETURN

# ---------------------------------------------------------------- files and paging

# in: slot -- out: title, url, targetline, gen, openok
:loadmeta
SET openok 0
FOPEN "/apps/reader-$slot.meta" read
IF $fok = 0 GOTO lm_done
FREAD title
FREAD url
FREAD gotext
GOSUB str2num
IF $got = 0 GOTO lm_zero
SET targetline $num
GOTO lm_gen
:lm_zero
SET targetline 0
:lm_gen
FREAD gotext
FCLOSE
GOSUB str2num
IF $got = 0 GOTO lm_genzero
SET gen $num
GOTO lm_ok
:lm_genzero
SET gen 0
:lm_ok
SET openok 1
:lm_done
RETURN

:savepos
FOPEN "/apps/reader-$article.meta" write
IF $fok = 0 GOTO sp_done
FWRITE "$title"
FWRITE "$url"
FWRITE "$topline"
FWRITE "$gen"
FCLOSE
:sp_done
RETURN

# opens the selected article from the top and discards targetline lines
:gotoline
FCLOSE
FOPEN "/apps/reader-$article-$gen.txt" read
IF $fok = 0 GOTO gl_failed
SET gi 0
:gl_skip
IF $gi >= $targetline GOTO gl_done
FREAD dummy
IF $feof = 1 GOTO gl_done
ADD gi 1
EXPR wtest $gi % 40
IF $wtest <> 0 GOTO gl_skip
WAIT 1
GOTO gl_skip
:gl_done
SET topline $gi
RETURN
:gl_failed
SET topline 0
RETURN

:readpage
SET pagecount 0
SET ateof 0
:rp_loop
IF $pagecount >= $pagesize GOTO rp_done
FREAD ln
IF $feof = 1 GOTO rp_eof
SET idx $pagecount
GOSUB storeline
ADD pagecount 1
GOTO rp_loop
:rp_eof
SET ateof 1
:rp_done
EXPR curline $topline + $pagecount
RETURN

:storeline
LEN llen $ln
IF $llen <= $linewidth GOTO st_fit
SET llen $linewidth
:st_fit
SET pagelen[$idx] $llen
EXPR base $idx * $linewidth
SET si 0
:st_ch
IF $si >= $llen GOTO st_done
CHARAT sc $ln $si
EXPR v $base + $si
SET pagetext[$v] $sc
ADD si 1
GOTO st_ch
:st_done
RETURN

:getline
SETSTR ln ""
SET llen $pagelen[$idx]
EXPR base $idx * $linewidth
SET gi 0
:gt_ch
IF $gi >= $llen GOTO gt_done
EXPR v $base + $gi
CHR one $pagetext[$v]
APPEND ln $one
ADD gi 1
GOTO gt_ch
:gt_done
RETURN

# ---------------------------------------------------------------- drawing and helpers

:draw
CLS
COLOR pink
PUT 0 0 "READER"
COLOR white
PUT 8 0 $title
SET row 0
:dr_loop
IF $row >= $pagecount GOTO dr_done
SET idx $row
GOSUB getline
EXPR disprow $row + 2
COLOR white
PUT 0 $disprow $ln
ADD row 1
GOTO dr_loop
:dr_done
EXPR lastline $topline + $pagecount
EXPR firstshown $topline + 1
COLOR cyan
PUT 0 37 "lines $firstshown..$lastline"
IF $ateof = 0 GOTO dr_more
COLOR yellow
PUT 22 37 "end"
:dr_more
COLOR yellow
PUT 0 39 "space next  up prev  / find  n again  L save link  B back"
FLIP
RETURN

# turns "N https://..." from the link file into newurl
:linkurl
SETSTR newurl ""
LEN n $ln
SET si 0
:lu_scan
IF $si >= $n GOTO lu_done
CHARAT sc $ln $si
IF $sc = 32 GOTO lu_found
ADD si 1
GOTO lu_scan
:lu_found
ADD si 1
EXPR n $n - $si
SUBSTR newurl $ln $si $n
:lu_done
RETURN

# bare hosts get http://; absolute URLs pass through unchanged
:normalize
LEN n $url
SET si 0
:nm_scan
IF $si >= $n GOTO nm_add
SUBSTR probe $url $si 3
IFEQ $probe "://" GOTO nm_done
ADD si 1
GOTO nm_scan
:nm_add
SETSTR probe "http://"
APPEND probe $url
SETSTR url $probe
:nm_done
RETURN

# in: gotext -- out: num, got
:str2num
SET num 0
SET got 0
SET s2i 0
LEN s2len $gotext
IF $s2len = 0 GOTO s2_done
SET got 1
:s2_loop
IF $s2i >= $s2len GOTO s2_done
CHARAT s2d $gotext $s2i
IF $s2d < 48 GOTO s2_bad
IF $s2d > 57 GOTO s2_bad
SUB s2d 48
MUL num 10
ADD num $s2d
ADD s2i 1
GOTO s2_loop
:s2_bad
SET got 0
:s2_done
RETURN

:leave
ENDCANVAS
HTTPCLEAR
COLOR pink
PRINT "reader: library closed"
EXIT
